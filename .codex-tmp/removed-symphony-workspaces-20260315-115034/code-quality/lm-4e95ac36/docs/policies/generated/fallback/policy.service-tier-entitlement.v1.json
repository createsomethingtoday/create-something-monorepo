{
  "id": "policy.service-tier-entitlement.v1",
  "name": "Service-tier entitlement",
  "description": "Commercial and entitlement gating for Policy OS-only hosted surfaces and governed write paths.",
  "rules": [
    {
      "id": "service_tier_block_paid_write_for_mcp_only",
      "priority": 10,
      "when": {
        "resourceKinds": [
          "hub_route"
        ],
        "actionNames": [
          "execute"
        ],
        "serviceTiers": [
          "mcp_only"
        ],
        "accessTypes": [
          "write",
          "destructive",
          "control_plane"
        ],
        "approvedExceptionPresent": false
      },
      "then": {
        "decision": "block",
        "reason": "MCP-only access does not include paid governed write or control-plane execution."
      }
    },
    {
      "id": "service_tier_block_policy_os_only_discovery_for_mcp_only",
      "priority": 20,
      "when": {
        "resourceKinds": [
          "hub_route"
        ],
        "actionNames": [
          "discover",
          "execute"
        ],
        "serviceTiers": [
          "mcp_only"
        ],
        "resourceTags": [
          "policy_os_only"
        ],
        "approvedExceptionPresent": false
      },
      "then": {
        "decision": "block",
        "reason": "MCP-only access does not include Policy OS-only product surfaces."
      }
    },
    {
      "id": "service_tier_block_paid_access_without_service_entitlement",
      "priority": 30,
      "when": {
        "resourceKinds": [
          "hub_route"
        ],
        "serviceTiers": [
          "policy_os_trial",
          "policy_os_core"
        ],
        "serviceEntitled": false
      },
      "then": {
        "decision": "block",
        "reason": "Paid Policy OS access requires explicit service entitlement."
      }
    },
    {
      "id": "service_tier_block_paid_access_without_policy_acceptance",
      "priority": 40,
      "when": {
        "resourceKinds": [
          "hub_route"
        ],
        "serviceTiers": [
          "policy_os_trial",
          "policy_os_core"
        ],
        "policyAccepted": false
      },
      "then": {
        "decision": "block",
        "reason": "Paid Policy OS access requires required policy acceptance."
      }
    },
    {
      "id": "service_tier_block_paid_access_without_contract",
      "priority": 50,
      "when": {
        "resourceKinds": [
          "hub_route"
        ],
        "serviceTiers": [
          "policy_os_trial",
          "policy_os_core"
        ],
        "contractActive": false
      },
      "then": {
        "decision": "block",
        "reason": "Paid Policy OS access requires an active contract."
      }
    },
    {
      "id": "service_tier_block_paid_access_without_billing",
      "priority": 60,
      "when": {
        "resourceKinds": [
          "hub_route"
        ],
        "serviceTiers": [
          "policy_os_trial",
          "policy_os_core"
        ],
        "billingActive": false
      },
      "then": {
        "decision": "block",
        "reason": "Paid Policy OS access requires active billing."
      }
    },
    {
      "id": "service_tier_allow_default",
      "priority": 900,
      "when": {
        "resourceKinds": [
          "hub_route"
        ]
      },
      "then": {
        "decision": "allow",
        "reason": "Service-tier entitlement requirements are satisfied for this route."
      }
    }
  ]
}
