import {
  OAuthProvider,
  FileTokenStore,
} from '@create-something/mcp-core';
import type { AuthProvider } from '@create-something/mcp-core';

/**
 * Example: OAuth provider for a service.
 *
 * Uncomment and customize when you need OAuth 2.0 auth.
 */
export function createOAuthProvider(): AuthProvider {
  return new OAuthProvider({
    clientId: process.env.CLIENT_ID!,
    clientSecret: process.env.CLIENT_SECRET!,
    tokenEndpoint: 'https://api.example.com/oauth/token',
    authorizationEndpoint: 'https://api.example.com/oauth/authorize',
    redirectUri: 'http://localhost:3000/callback',
    scopes: ['read', 'write'],
    tokenStore: new FileTokenStore('.tokens.json'),

    // How to determine which account a request is for
    resolveAccountId: async (_request) => {
      // For single-account: return a static ID
      // For multi-account: extract from request headers, path, session, etc.
      return 'default';
    },
  });
}
