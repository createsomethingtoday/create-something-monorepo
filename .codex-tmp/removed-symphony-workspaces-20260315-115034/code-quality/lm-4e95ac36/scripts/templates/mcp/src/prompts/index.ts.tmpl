/**
 * {{NAME}} — Prompt Registration
 * Three-Tier Framework: Judgment tier (MCP Prompts)
 *
 * Prompts are user-controlled — the human selects which template
 * to apply. They encode policy: how the model should interpret data
 * and what recommendations are appropriate.
 *
 * Every handler receives AccountContext so prompts can reference the
 * account's policy constraints.
 */

import { z } from 'zod';
import type { ScopedMcpServer } from '@create-something/mcp-core';

export function registerPrompts(server: ScopedMcpServer): void {
  // --- Example: data analysis prompt ---
  server.prompt(
    'analyze_data',
    'Analyze data with account-specific context',
    {
      data_json: z.string().describe('JSON data to analyze'),
      focus: z.string().optional().describe('What aspect to focus on'),
    },
    async (params, ctx) => {
      const policyNote = ctx.policy.readOnly
        ? '\n\nNote: This account is read-only. Do not suggest modifications.'
        : '';

      return {
        messages: [
          {
            role: 'user' as const,
            content: {
              type: 'text' as const,
              text: `You are analyzing data for account ${ctx.accountId}.

Account scopes: ${ctx.policy.scopes.join(', ') || 'none'}${policyNote}

Data to analyze:
${params.data_json}

${params.focus ? `Focus on: ${params.focus}` : 'Provide a general analysis.'}

Keep analysis concrete and actionable.`,
            },
          },
        ],
      };
    },
  );
}
