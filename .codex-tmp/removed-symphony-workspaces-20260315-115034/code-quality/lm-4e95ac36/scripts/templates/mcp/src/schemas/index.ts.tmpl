/**
 * {{NAME}} — Schemas
 * Three-Tier Framework: Artifacts (typed boundary contracts)
 *
 * Zod schemas for inputs and outputs that flow between tiers.
 * These are the Artifacts that carry structured data through the system.
 */

import { z } from 'zod';

// --- Example schemas ---

export const ItemSchema = z.object({
  id: z.string(),
  name: z.string(),
  description: z.string().optional(),
  createdAt: z.string().datetime(),
});

export type Item = z.infer<typeof ItemSchema>;
