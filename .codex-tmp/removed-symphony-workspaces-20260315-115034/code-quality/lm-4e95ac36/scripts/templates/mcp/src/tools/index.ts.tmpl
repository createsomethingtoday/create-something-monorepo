/**
 * {{NAME}} — Tool Registration
 * Three-Tier Framework: Automation tier (MCP Tools)
 *
 * Tools are model-controlled — the LLM decides when to invoke them.
 * Every handler receives AccountContext, scoping the operation to the caller.
 *
 * Mark read-only tools with { readOnly: true } so they remain available
 * even when the account's policy is set to readOnly.
 */

import { z } from 'zod';
import { jsonContent, errorContent } from '@create-something/mcp-core';
import type { ScopedMcpServer } from '@create-something/mcp-core';

export function registerTools(server: ScopedMcpServer): void {
  // --- Example: list items (read-only) ---
  server.tool(
    'list_items',
    'List items for the current account',
    {
      limit: z.number().optional().describe('Maximum items to return'),
    },
    async (params, ctx) => {
      // ctx.accountId scopes the query — the primitive is relative
      return jsonContent({
        accountId: ctx.accountId,
        items: [],
        message: `Listed items for account ${ctx.accountId}`,
      });
    },
    { readOnly: true },
  );

  // --- Example: create item (write operation) ---
  server.tool(
    'create_item',
    'Create a new item in the current account',
    {
      name: z.string().describe('Item name'),
      description: z.string().optional().describe('Item description'),
    },
    async (params, ctx) => {
      // Policy check: readOnly accounts can't reach this handler
      // (ScopedMcpServer filters it out at registration time)
      return jsonContent({
        accountId: ctx.accountId,
        created: { name: params.name, description: params.description },
        message: `Created item for account ${ctx.accountId}`,
      });
    },
  );
}
