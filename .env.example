# Copy to `.env` (root `.env` is gitignored) and fill in real secrets.

# Langfuse (Tracing + Evals)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PROJECT_NAME=Create Something
LANGFUSE_HOST=https://us.cloud.langfuse.com

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROMPT=What is 1+1?

# Auth0 (.agency identity)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-machine-to-machine-client-id
AUTH0_CLIENT_SECRET=your-machine-to-machine-client-secret
AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
AUTH0_SCOPE=openid profile email offline_access
AUTH0_CLAIMS_NAMESPACE=https://createsomething.agency
