{
  "mcpServers": {
    "stripe": {
      "type": "http",
      "url": "https://mcp.stripe.com"
    },
    "lsmcp": {
      "command": "npx",
      "args": [
        "-y",
        "@mizchi/lsmcp",
        "mcp"
      ]
    },
    "webflow": {
      "command": "node",
      "args": [
        "./packages/webflow-mcp/dist/index.js"
      ]
    },
    "airtable": {
      "command": "npx",
      "args": [
        "-y",
        "airtable-mcp-server"
      ],
      "env": {
        "AIRTABLE_API_KEY": "${AIRTABLE_API_KEY}"
      }
    },
    "half-dozen-youtube-sync": {
      "type": "http",
      "url": "https://youtube.mcp.workway.co/mcp"
    },
    "notion-halfdozen-create-something": {
      "type": "http",
      "url": "https://createsomething-notion.mcp.workway.co/mcp"
    },
    "meetings-staging": {
      "type": "http",
      "url": "https://meetings-mcp-staging.createsomething.workers.dev/mcp?token=YOUR_MCP_API_KEY"
    },
    "meetings": {
      "type": "http",
      "url": "https://meetings-mcp.createsomething.workers.dev/mcp?token=YOUR_MCP_API_KEY"
    }
  }
}
