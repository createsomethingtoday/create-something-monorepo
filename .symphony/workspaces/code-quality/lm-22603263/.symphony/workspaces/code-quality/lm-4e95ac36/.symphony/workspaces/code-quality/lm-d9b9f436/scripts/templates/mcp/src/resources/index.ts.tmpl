/**
 * {{NAME}} — Resource Registration
 * Three-Tier Framework: Database tier (MCP Resources)
 *
 * Resources are application-controlled — the client decides when to
 * fetch and inject them into the model's context.
 *
 * Every handler receives AccountContext, returning only data that
 * belongs to the authenticated account.
 */

import type { ScopedMcpServer } from '@create-something/mcp-core';

export function registerResources(server: ScopedMcpServer): void {
  // --- Example: account info ---
  server.resource(
    'account',
    '{{PACKAGE_NAME}}://account',
    { description: 'Current account information', mimeType: 'application/json' },
    async (uri, ctx) => {
      return {
        contents: [
          {
            uri: uri.href,
            mimeType: 'application/json',
            text: JSON.stringify({
              accountId: ctx.accountId,
              userId: ctx.userId,
              teamId: ctx.teamId,
              scopes: ctx.policy.scopes,
              readOnly: ctx.policy.readOnly,
            }, null, 2),
          },
        ],
      };
    },
  );
}
