{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas Studio",
  "version": "0.1.0",
  "identifier": "agency.createsomething.atlas-studio",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atlas Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
