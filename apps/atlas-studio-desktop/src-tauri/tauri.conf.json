{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas Studio",
  "version": "0.1.0",
  "identifier": "agency.createsomething.atlas-studio",
  "build": {
    "beforeDevCommand": "pnpm prepare:runtime",
    "beforeBuildCommand": "pnpm prepare:runtime",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atlas Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src http://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": { "resources/": "" },
    "icon": ["icons/icon.png"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
