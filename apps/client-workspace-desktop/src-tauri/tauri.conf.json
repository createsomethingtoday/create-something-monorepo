{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CREATE SOMETHING Client Workspace",
  "version": "0.2.0",
  "identifier": "agency.createsomething.client-workspace",
  "build": {
    "beforeDevCommand": "pnpm prepare:runtime",
    "beforeBuildCommand": "pnpm prepare:runtime",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CREATE SOMETHING Client Workspace",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src http://127.0.0.1:*; navigate-to http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": { "resources/": "" },
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
