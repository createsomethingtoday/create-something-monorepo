{
  "name": "@create-something/create-something-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "mixed",
    "surface": "app",
    "entrypoints": [
      "src/application/booking-service.ts",
      "src/application/room-service.ts"
    ],
    "smoke": "pnpm check && pnpm test"
  },
  "scripts": {
    "build:room-client": "esbuild src/ui/room-client.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=public/assets/room-client.js",
    "build": "pnpm build:room-client && wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "dev": "pnpm build:room-client && wrangler dev",
    "sync:webflow-busy": "swift scripts/sync-webflow-busy-projection.swift",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/realtimekit": "2.0.0",
    "@cloudflare/realtimekit-ui": "2.0.0",
    "@cloudflare/realtimekit-virtual-background": "0.0.2",
    "@create-something/canon": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260711.1",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0"
  }
}
