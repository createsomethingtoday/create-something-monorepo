{
  "manifest_version": 3,
  "name": "Canon Meeting Notes",
  "version": "0.2.0",
  "description": "Save up to one hour of consented audio from a selected Google Meet or Zoom web meeting on this device.",
  "permissions": ["activeTab", "tabCapture", "storage"],
  "action": {
    "default_title": "Open Canon meeting audio controls"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "background": {
    "service_worker": "launch.js"
  }
}
