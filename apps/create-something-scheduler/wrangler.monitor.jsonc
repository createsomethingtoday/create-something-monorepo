{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "create-something-scheduler-monitor",
  "account_id": "9645bd52e640b8a4f40a3a55ff1dd75a",
  "main": "src/monitor-worker.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "vars": {
    "ALERT_EMAIL": "micah@createsomething.io",
    "RESEND_FROM": "CREATE SOMETHING <noreply@createsomething.io>",
    "SCHEDULER_STATUS_URL": "https://create-something-scheduler.createsomething.workers.dev/api/v1/operator/status"
  },
  "durable_objects": { "bindings": [{ "name": "MONITOR", "class_name": "SyncMonitor" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncMonitor"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
