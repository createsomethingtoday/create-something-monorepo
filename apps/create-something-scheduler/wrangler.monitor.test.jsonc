{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "create-something-scheduler-monitor-test",
  "main": "src/monitor-worker.ts",
  "compatibility_date": "2026-07-11",
  "workers_dev": true,
  "vars": {
    "ALERT_EMAIL": "micah@createsomething.io",
    "RESEND_FROM": "CREATE SOMETHING <noreply@createsomething.io>",
    "SCHEDULER_STATUS_URL": "https://create-something-scheduler.createsomething.workers.dev/api/v1/operator/status",
    "OPERATOR_API_TOKEN": "controlled-operator-token",
    "RESEND_API_KEY": "controlled-resend-key"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR",
        "class_name": "SyncMonitor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SyncMonitor"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
