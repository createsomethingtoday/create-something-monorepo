{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$extensions": { "canonOverlay": { "id": "overlay.draw-native-paired-canvas", "name": "Draw Native Paired Canvas Overlay", "sourcePackage": "@create-something/draw-native" } },
  "canonOverlay": {
    "accent": { "$type": "color", "$value": "{color.performance.signal}", "$description": "Pairing, focus, and explicit conversion accent." },
    "surface": { "$type": "color", "$value": "{color.performance.panel}", "$description": "Native canvas panel surface." },
    "proof": { "$type": "color", "$value": "{color.performance.ready}", "$description": "Connected and synchronized state; always paired with text." },
    "radius": { "$type": "dimension", "$value": "{radius.performance.md}", "$description": "Native control radius without a product-specific scale." }
  }
}
