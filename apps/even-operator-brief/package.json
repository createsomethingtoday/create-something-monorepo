{
  "name": "@create-something/even-operator-brief",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "simulator": "evenhub-simulator http://localhost:5173",
    "test": "tsx --test test/*.test.ts",
    "pack:even": "vite build && evenhub pack app.json dist -o even-operator-brief.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "@types/node": "^24.10.9",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  }
}
