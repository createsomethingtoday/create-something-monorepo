{
  "name": "@create-something/gigi-desktop",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test web/*.test.mjs scripts/*.test.mjs",
    "test:foundation": "node scripts/astryx-rewrite-browser.mjs",
    "preview:foundation": "vite",
    "test:domain": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dev": "tauri dev",
    "build": "tauri build --bundles app,dmg",
    "check": "tauri build --debug --no-bundle",
    "package:agent": "node scripts/package-agent.mjs",
    "prepare:companions": "node scripts/prepare-companions.mjs",
    "build:local": "GIGI_BUILD_PROFILE=debug tauri build --debug --config src-tauri/tauri.local.conf.json --bundles app,dmg",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "test:companions": "cargo run --manifest-path src-tauri/Cargo.toml --example verify_companions -- src-tauri/resources",
    "verify:release": "node scripts/verify-release.mjs",
    "dev:web": "vite",
    "build:web": "vite build",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme:build": "pnpm astryx theme build ui/gigi-theme.ts --out ui/gigi-theme.css && pnpm astryx theme build ui/gigi-dev-theme.ts --out ui/gigi-dev-theme.css",
    "test:rewrite": "node scripts/astryx-rewrite-browser.mjs",
    "test:creators": "node scripts/astryx-creators-browser.mjs",
    "test:review-regressions": "node scripts/astryx-review-regressions.mjs",
    "prepare:motion": "node scripts/prepare-motion.mjs",
    "check:motion": "node scripts/prepare-motion.mjs --check",
    "test:reconciled-work": "node scripts/dev-astryx-work-browser.mjs",
    "test:reconciled-quest": "node scripts/dev-astryx-quest-browser.mjs",
    "test:refinement": "node scripts/astryx-refinement-browser.mjs"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.11",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@tauri-apps/cli": "2.11.2",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-neutral": "0.7.11",
    "@fontsource-variable/figtree": "5.3.0",
    "@stylexjs/stylex": "0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "gsap": "3.15.1"
  }
}
