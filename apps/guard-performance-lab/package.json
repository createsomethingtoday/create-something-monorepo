{
  "name": "@create-something/guard-performance-lab",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "mixed",
    "surface": "app",
    "entrypoints": [
      "src/routes/+page.svelte",
      "src/lib/server/lab-service.ts",
      "src/mcp/server.ts"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm check && pnpm test && pnpm build"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:smoke": "tsx src/mcp/smoke.ts",
    "mcp:parity": "tsx src/mcp/parity.ts",
    "auth:browser-fixture": "node scripts/browser-auth-fixture.mjs",
    "film:analyze": "uv run --script scripts/analyze-film.py",
    "film:test:analyzer": "uv run --script scripts/test_analyze_film.py",
    "film:track:mask:sam2": "python scripts/track-player-mask-sam2.py",
    "film:fuse:mask-tracks": "tsx scripts/fuse-film-mask-tracks.ts",
    "film:verify": "tsx scripts/verify-film.ts",
    "film:verify:import": "tsx scripts/verify-film-import.ts",
    "film:classify:team": "uv run --script scripts/classify-team-benchmark.py",
    "film:verify:team": "tsx scripts/verify-film-team.ts",
    "film:derive:identity": "tsx scripts/derive-film-identity.ts",
    "film:verify:identity": "tsx scripts/verify-film-identity.ts",
    "film:finalize:identity": "tsx scripts/finalize-film-identity.ts",
    "film:apply:play-state": "tsx scripts/apply-film-play-state.ts",
    "film:stabilize:team": "uv run --script scripts/stabilize-film-team.py",
    "film:import": "tsx scripts/import-film.ts",
    "film:import:http": "tsx scripts/import-film-http.ts",
    "d1:migrate:local": "node ../../scripts/run-wrangler.mjs d1 migrations apply guard-performance-lab --local",
    "d1:migrate:remote": "node ../../scripts/run-wrangler.mjs d1 migrations apply guard-performance-lab --remote",
    "deploy": "pnpm build && node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=guard-performance-lab --branch=main"
  },
  "dependencies": {
    "@create-something/canon": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.41.0",
    "svelte-check": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.103.0"
  }
}
