{
  "name": "@create-something/guard-performance-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "mixed",
    "surface": "app",
    "entrypoints": ["src/routes/+page.svelte", "src/lib/server/lab-service.ts", "src/mcp/server.ts"],
    "boot": "pnpm dev",
    "smoke": "pnpm check && pnpm test && pnpm build"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:smoke": "tsx src/mcp/smoke.ts",
    "mcp:parity": "tsx src/mcp/parity.ts"
  },
  "dependencies": {
    "@create-something/canon": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.41.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
