{
  "schemaVersion": "approval_surfaces.v0.1",
  "workflowId": "webflow.marketplace.template-lifecycle",
  "workflowVersion": "0.1.0",
  "definitionHash": "sha256:a94edfce769f2d7f4b5ba27f898062d9d79b374c61107082610c549de8fbc9f0",
  "actions": [
    {
      "actionId": "approve_template",
      "title": "Approve template",
      "mode": "approval_required",
      "owner": "marketplace-reviewer",
      "requiredEvidence": [
        "review_status",
        "review_summary",
        "reviewer_id",
        "validation_result",
        "version_id"
      ],
      "recovery": {
        "mode": "manual_fallback",
        "owner": "marketplace-reviewer",
        "path": "Keep the version in review and resolve the approval manually in Airtable."
      }
    },
    {
      "actionId": "publish_template",
      "title": "Publish template",
      "mode": "manual_only",
      "owner": "marketplace-operator",
      "requiredEvidence": [
        "approval_receipt",
        "operator_id",
        "release_metadata",
        "version_id"
      ],
      "recovery": {
        "mode": "rollback",
        "owner": "marketplace-operator",
        "path": "Stop publication, preserve the approved version, and follow the marketplace release rollback runbook."
      }
    },
    {
      "actionId": "request_changes",
      "title": "Request changes",
      "mode": "approval_required",
      "owner": "marketplace-reviewer",
      "requiredEvidence": [
        "review_feedback",
        "review_summary",
        "reviewer_id",
        "version_id"
      ],
      "recovery": {
        "mode": "manual_fallback",
        "owner": "marketplace-reviewer",
        "path": "Leave official state unchanged and record feedback manually in Airtable."
      }
    },
    {
      "actionId": "send_creator_decision",
      "title": "Send creator-facing decision autonomously",
      "mode": "blocked",
      "owner": "marketplace-reviewer",
      "requiredEvidence": [
        "decision_receipt",
        "human_send_confirmation",
        "reviewer_id"
      ],
      "recovery": {
        "mode": "escalate",
        "owner": "marketplace-reviewer",
        "path": "Return a draft only and require the reviewer to send through the approved communication path."
      }
    }
  ]
}
