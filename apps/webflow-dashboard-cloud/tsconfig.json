{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "types": ["@cloudflare/workers-types", "node"],
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@create-something/webflow-dashboard-core": ["../../packages/webflow-dashboard-core/src/index.ts"],
      "@create-something/webflow-marketplace-core": ["../../packages/webflow-marketplace-core/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
