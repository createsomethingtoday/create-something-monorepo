  "source_dsl": {
    "imported_from": "Spotify Agent.yml",
    "repo_path": "config/dify-agents/spotify-agent.dify.yml"
  },
  "dify_app": {
    "name": "Spotify Agent",
    "type": "agent",
    "mode": "agent-chat",
    "description": "Spotify artist, track, album, playlist, podcast, lyrics, concert, and recommendation lookup through the RapidAPI Hub Spotify MCP tools.",
    "recommended_model": "gpt-5.4",
    "api_response_mode": "streaming",
    "service_api": {
      "base_url": "https://api.dify.ai/v1",
      "api_key_secret": {
        "environment": "prod",
        "path": "/dify/spotify-agent",
        "secret_key": "DIFY_SPOTIFY_AGENT_API_KEY"
      }
    }
  },
