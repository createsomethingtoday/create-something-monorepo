  "api_base_url": "https://api.dify.ai/v1",
  "entries": {
    "aaron-hub": {
      "display_name": "AARON HUB",
      "kind": "hub",
      "infisical": {
        "environment": "prod",
        "path": "/dify/aaron-hub",
        "secret_key": "DIFY_AARON_HUB_API_KEY"
      }
    },
    "abundance-hub": {
      "display_name": "ABUNDANCE HUB",
