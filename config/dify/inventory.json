{
  "version": 1,
  "workspace": {
    "name": "CREATE SOMETHING",
    "provider": "dify_cloud",
    "base_url": "https://cloud.dify.ai"
  },
  "status": "partial",
  "snapshot": {
    "last_manual_inventory_at": "2026-04-29",
    "source": "Dify Studio manual import plus repo-side smoke/eval evidence",
    "notes": "This inventory is intentionally partial until all existing Dify MCP server cards and apps are exported or manually transcribed."
  },
  "mcp_servers": {
    "yt-transcript-notion": {
      "display_name": "YouTube Transcript + Notion MCP",
      "source_mcp_registry_server": "youtube-transcript-notion-mcp",
      "transport": "http",
      "url": "https://youtube-transcript-notion-mcp.createsomething.workers.dev/mcp",
      "auth": {
        "type": "bearer",
        "infisical": {
          "environment": "prod",
          "path": "/youtube-transcript-notion-mcp",
          "secret_key": "MCP_BEARER_TOKEN"
        }
      },
      "tools": [
        {
          "name": "extract_transcript",
          "enabled": true,
          "risk": "read",
          "required_parameters": ["videoUrl"]
        },
        {
          "name": "get_database_schema",
          "enabled": true,
          "risk": "read",
          "required_parameters": []
        },
        {
          "name": "sync_video_to_notion",
          "enabled": true,
          "risk": "write",
          "required_parameters": ["videoUrl"],
          "requires_user_confirmation": true
        },
        {
          "name": "enrich_notion_page",
          "enabled": true,
          "risk": "write",
          "required_parameters": ["pageId"],
          "requires_user_confirmation": true
        },
        {
          "name": "search",
          "enabled": false,
          "risk": "read",
          "notes": "Generic MCP resource-discovery tool; keep disabled unless the Dify agent needs resource search."
        },
        {
          "name": "fetch",
          "enabled": false,
          "risk": "read",
          "notes": "Generic MCP resource-fetch tool; keep disabled unless the Dify agent needs resource fetch."
        }
      ]
    }
  },
  "agents": {
    "youtube-transcript-notion-agent": {
      "display_name": "YouTube Transcript Notion Agent",
      "runtime": "dify",
      "status": "published",
      "audience": "client",
      "mode": "agent-chat",
      "manifest_path": "config/dify-agents/youtube-transcript-notion-agent.json",
      "dsl_path": "config/dify-agents/youtube-transcript-notion-agent.dify.yml",
      "service_api": {
        "base_url": "https://api.dify.ai/v1",
        "api_key_secret": {
          "environment": "prod",
          "path": "/dify/youtube-transcript-notion-agent",
          "secret_key": "DIFY_YOUTUBE_TRANSCRIPT_NOTION_AGENT_API_KEY"
        }
      },
      "allowed_mcp_servers": ["yt-transcript-notion"],
      "enabled_tools": [
        "yt-transcript-notion.extract_transcript",
        "yt-transcript-notion.get_database_schema",
        "yt-transcript-notion.sync_video_to_notion",
        "yt-transcript-notion.enrich_notion_page"
      ],
      "policy_pack": "client-youtube-transcript-notion.v1",
      "instructions_source": "config/dify-agents/youtube-transcript-notion-agent.json#agent_prompt",
      "eval_suite": "braintrust:eval:dify:youtube-transcript",
      "evals": {
        "owner_system": "braintrust",
        "project": "create-something-dify-agents",
        "experiment": "youtube_transcript_notion_agent",
        "local_command": "pnpm braintrust:eval:dify:local",
        "published_command": "pnpm braintrust:eval:dify:youtube-transcript",
        "required_checks": [
          "api_health",
          "expected_tool_use",
          "forbidden_tool_use",
          "grounded_answer",
          "write_confirmation",
          "secret_refusal",
          "latency_budget"
        ],
        "last_verified_at": "2026-04-29",
        "notes": "Published Braintrust experiment passed 100% after smoke/eval hardening."
      },
      "smoke_command": "pnpm dify:youtube-transcript:smoke",
      "owner": "create-something",
      "write_policy": "requires_explicit_confirmation",
      "notes": "Imported from DSL, published in Dify Studio, API smoke-tested, and covered by Braintrust evals."
    }
  }
}
