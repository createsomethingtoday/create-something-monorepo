        {
          "name": "hub_route_intent",
          "enabled": true,
          "risk": "read",
          "notes": "DSL parameters: allowDiscoveryFallback, intent, limit, query, serverName"
        },
        {
          "name": "hub_run_intent",
          "enabled": true,
          "risk": "external_side_effect",
          "requires_user_confirmation": true,
