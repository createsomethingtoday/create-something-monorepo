{
  "version": 1,
  "workspace": {
    "name": "CREATE SOMETHING",
    "provider": "dify_cloud",
    "base_url": "https://cloud.dify.ai"
  },
  "status": "partial",
  "snapshot": {
    "last_manual_inventory_at": "2026-04-29",
    "source": "Dify Studio manual import plus repo-side smoke/eval evidence",
    "notes": "This inventory is intentionally partial until all existing Dify MCP server cards and apps are exported or manually transcribed."
  },
  "mcp_servers": {
    "yt-transcript-notion": {
      "display_name": "YouTube Transcript + Notion MCP",
      "source_mcp_registry_server": "youtube-transcript-notion-mcp",
      "transport": "http",
      "url": "https://youtube-transcript-notion-mcp.createsomething.workers.dev/mcp",
      "auth": {
        "type": "bearer",
        "infisical": {
          "environment": "prod",
          "path": "/youtube-transcript-notion-mcp",
          "secret_key": "MCP_BEARER_TOKEN"
        }
      },
      "tools": [
        {
          "name": "extract_transcript",
          "enabled": true,
          "risk": "read",
          "required_parameters": ["videoUrl"]
        },
        {
          "name": "get_database_schema",
          "enabled": true,
          "risk": "read",
          "required_parameters": []
        },
        {
          "name": "sync_video_to_notion",
          "enabled": true,
          "risk": "write",
          "required_parameters": ["videoUrl"],
          "requires_user_confirmation": true
        },
        {
          "name": "enrich_notion_page",
          "enabled": true,
          "risk": "write",
          "required_parameters": ["pageId"],
          "requires_user_confirmation": true
        },
        {
          "name": "search",
          "enabled": false,
          "risk": "read",
          "notes": "Generic MCP resource-discovery tool; keep disabled unless the Dify agent needs resource search."
        },
        {
          "name": "fetch",
          "enabled": false,
          "risk": "read",
          "notes": "Generic MCP resource-fetch tool; keep disabled unless the Dify agent needs resource fetch."
        }
      ]
    },
