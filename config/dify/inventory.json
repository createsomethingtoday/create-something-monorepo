        },
        {
          "name": "hub_list_services",
          "enabled": true,
          "risk": "read"
        },
        {
          "name": "hub_policy_status",
          "enabled": true,
          "risk": "read"
        },
        {
          "name": "hub_refresh_connections",
          "enabled": true,
          "risk": "external_side_effect",
          "requires_user_confirmation": true
