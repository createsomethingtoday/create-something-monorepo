      "auth": {
        "type": "bearer",
        "infisical": {
          "environment": "prod",
          "path": "/mcp-hub/hubs",
          "secret_key": "CS_HUB_BLONDISH_API_TOKEN"
        }
      },
      "tools": [
        {
          "name": "hub_describe_proxy_tool",
          "enabled": true,
