{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-something.dev/schemas/dify-inventory.schema.json",
  "title": "Dify Workspace Inventory",
  "description": "Repo-side inventory for Dify MCP server cards and Dify agents.",
  "type": "object",
  "required": ["version", "workspace", "status", "mcp_servers", "agents"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "workspace": {
      "type": "object",
      "required": ["name", "provider", "base_url"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "enum": ["dify_cloud", "self_hosted"]
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["partial", "complete"]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_manual_inventory_at": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "mcp_servers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/mcpServer"
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "secretRef": {
      "type": "object",
      "required": ["environment", "path", "secret_key"],
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "secret_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "bearer", "oauth", "custom"]
        },
        "infisical": {
          "$ref": "#/$defs/secretRef"
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "enabled", "risk"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "risk": {
          "type": "string",
          "enum": ["read", "write", "external_side_effect", "secret_sensitive", "unknown"]
        },
        "required_parameters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_user_confirmation": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "required": ["display_name", "transport", "url", "auth", "tools"],
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "source_mcp_registry_server": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "enum": ["http"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tool"
          }
        }
      }
    },
    "serviceApi": {
      "type": "object",
      "required": ["base_url", "api_key_secret"],
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "api_key_secret": {
          "$ref": "#/$defs/secretRef"
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "display_name",
        "runtime",
        "status",
        "audience",
        "mode",
        "allowed_mcp_servers",
        "enabled_tools",
        "policy_pack",
        "eval_suite",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "enum": ["dify"]
        },
        "status": {
          "type": "string",
          "enum": ["planned", "draft", "imported", "published", "retired"]
        },
        "audience": {
          "type": "string",
          "enum": ["internal", "client", "public"]
        },
        "dify_app_id": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string"
        },
        "dsl_path": {
          "type": "string"
        },
        "service_api": {
          "$ref": "#/$defs/serviceApi"
        },
        "allowed_mcp_servers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enabled_tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^.]+[.][^.]+$"
          }
        },
        "policy_pack": {
          "type": "string",
          "minLength": 1
        },
        "instructions_source": {
          "type": "string"
        },
        "eval_suite": {
          "type": "string",
          "minLength": 1
        },
        "smoke_command": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "write_policy": {
          "type": "string",
          "enum": ["none", "requires_explicit_confirmation", "disabled"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
