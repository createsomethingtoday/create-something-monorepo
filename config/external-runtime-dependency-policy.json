      "terms": ["dify", "notion"]
    },
    {
      "id": "root-rollback-commands",
      "category": "approved_rollback",
      "owner": "CRE-1233",
      "reason": "Root Dify commands remain operable only for parity and rollback until destructive retirement is approved.",
      "path": "^package\\.json$",
      "terms": ["dify"]
    },
    {
      "id": "notion-client-compatibility",
      "category": "client_compatibility",
      "owner": "client-delivery",
      "reason": "Client-owned Notion data and connector packages are integrations behind CREATE SOMETHING contracts, not primary CREATE SOMETHING runtime dependencies.",
      "path": "(?:^|/)(?:[^/]*notion[^/]*|halfdozen-[^/]*|gmail-notion-mcp|quickbooks-notion-mcp)(?:/|$)",
      "terms": ["notion"]
    },
    {
      "id": "client-delivery-evidence",
      "category": "client_compatibility",
      "owner": "client-delivery",
      "reason": "Delivery records and client-specific surfaces describe customer systems or compatibility boundaries.",
      "path": "^(?:config/delivery/|docs/deliveries/|packages/agency/clients/|packages/agency/src/lib/delivery/)",
      "terms": ["dify", "notion"]
    },
    {
      "id": "legacy-coordination-evidence",
      "category": "historical_evidence",
      "owner": "linear-migration",
      "reason": "Legacy Loom records are retained only as migrated historical coordination evidence; Linear is authoritative.",
      "path": "^\\.loom/",
      "terms": ["dify", "notion"]
    },
    {
      "id": "runtime-compatibility-config",
      "category": "client_compatibility",
      "owner": "mcp-fleet",
      "reason": "Fleet and policy configuration retains named client or host compatibility; it is not the primary owned agent runtime.",
      "path": "^(?:config/|\\.mcp\\.json$|\\.pi/)",
      "terms": ["dify", "notion"]
    },
    {
      "id": "operator-compatibility-code",
      "category": "client_compatibility",
      "owner": "mcp-fleet",
      "reason": "Scripts and non-primary packages implement client, host, migration, or operator compatibility behind owned interfaces.",
      "path": "^(?:scripts/|automation/|apps/|packages/)",
      "terms": ["dify", "notion"]
    },
    {
      "id": "historical-and-research",
      "category": "historical_evidence",
      "owner": "docs",
      "reason": "Research, historical delivery evidence, guides, archived artifacts, and generated knowledge may preserve vendor context without defining the current stack.",
      "path": "^(?:docs/|specs/|templates/|evals/|\\.archive/|\\.claude/|CLAUDE\\.md$|AGENTS\\.md$|STANDARDS\\.md$|\\.github/)",
      "terms": ["dify", "notion"]
    }
