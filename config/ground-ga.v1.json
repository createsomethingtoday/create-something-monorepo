{
  "schemaVersion": 1,
  "mode": "advisory",
  "package": {
    "path": "packages/ground/npm",
    "name": "@createsomething/ground-mcp",
    "version": "0.3.6",
    "releaseWorkflow": ".github/workflows/ground-release.yml",
    "minimumToolCount": 21
  },
  "calibration": {
    "ledger": "docs/internal/ground-adjudication-ledger.v1.json",
    "releaseReceipt": "ground-calibration-receipt.json",
    "minimumCompleteReceipts": 14,
    "minimumAdjudicatedFindings": 10,
    "minimumPrecision": 0.9,
    "maximumFalsePositiveRate": 0.1,
    "minimumAdjudicatedByCheck": {
      "duplicates": 4,
      "orphans": 3,
      "dead_exports": 3
    },
    "maximumExecutionFailures": 0
  },
  "languages": [
    {
      "id": "typescript",
      "extensions": ["ts", "tsx"]
    },
    {
      "id": "javascript",
      "extensions": ["js", "jsx", "mjs"]
    },
    {
      "id": "svelte",
      "extensions": ["svelte"],
      "framework": "SvelteKit"
    }
  ],
  "platforms": [
    {
      "id": "darwin-arm64",
      "target": "aarch64-apple-darwin",
      "asset": "ground-darwin-arm64.tar.gz"
    },
    {
      "id": "darwin-x64",
      "target": "x86_64-apple-darwin",
      "asset": "ground-darwin-x64.tar.gz"
    },
    {
      "id": "linux-x64",
      "target": "x86_64-unknown-linux-gnu",
      "asset": "ground-linux-x64.tar.gz"
    },
    {
      "id": "linux-arm64",
      "target": "aarch64-unknown-linux-gnu",
      "asset": "ground-linux-arm64.tar.gz"
    },
    {
      "id": "win32-x64",
      "target": "x86_64-pc-windows-msvc",
      "asset": "ground-win32-x64.zip"
    }
  ],
  "clients": [{ "id": "claude" }, { "id": "codex" }, { "id": "cursor" }, { "id": "windsurf" }],
  "tests": ["rust", "npm_pilot", "public_surface", "agency", "io", "performance_pages"],
  "surfaces": {
    "routes": [
      "https://createsomething.agency/products/ground",
      "https://createsomething.io/docs/ground"
    ],
    "widths": [1440, 390],
    "browserEvidenceMaxAgeHours": 24,
    "checks": [
      "reload",
      "keyboard",
      "copy",
      "reduced_motion",
      "no_javascript_meaning",
      "no_console_errors",
      "no_request_errors"
    ]
  }
}
