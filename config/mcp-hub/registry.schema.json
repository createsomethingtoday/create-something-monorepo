{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://create-something.dev/schemas/mcp-hub-registry.schema.json",
  "title": "MCP Hub Registry",
  "description": "Schema for config/mcp-hub/registry.json",
  "type": "object",
  "required": [
    "version",
    "servers",
    "bundles"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "servers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/server"
      }
    },
    "bundles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabledBundles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enabledServers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disabledServers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "codexConfigPath": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "include",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "create-something",
            "workway"
          ]
        },
        "description": {
          "type": "string"
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "http",
              "sse"
            ]
          }
        },
        "requiresAuth": {
          "type": "boolean"
        },
        "authType": {
          "type": "string",
          "enum": [
            "bearer",
            "oauth"
          ]
        },
        "setupNotes": {
          "type": "string"
        }
      }
    },
    "publicTrustCard": {
      "type": "object",
      "required": [
        "summary",
        "limitations",
        "policy_pack",
        "eval_suite",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_pack": {
          "type": "string",
          "minLength": 1
        },
        "eval_suite": {
          "type": "string",
          "minLength": 1
        },
        "last_verified_date": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "escalation": {
          "type": "string"
        }
      }
    },
    "publicObservability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "langfuse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            }
          }
        }
      }
    },
    "externalListings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "glama": {
          "type": "string"
        },
        "hugging_face": {
          "type": "string"
        },
        "docker": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "official_registry": {
          "type": "string"
        }
      }
    },
    "publicAccess": {
      "type": "object",
      "required": [
        "status",
        "access_model",
        "trust_card"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "public",
            "sandbox",
            "byo_auth",
            "waitlist",
            "private"
          ]
        },
        "access_model": {
          "type": "string",
          "enum": [
            "read_only",
            "simulated_write",
            "approval_required",
            "live_write"
          ]
        },
        "trust_card": {
          "$ref": "#/$defs/publicTrustCard"
        },
        "observability": {
          "$ref": "#/$defs/publicObservability"
        },
        "external_listings": {
          "$ref": "#/$defs/externalListings"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "dormant",
            "local"
          ]
        },
        "package_path": {
          "type": "string"
        },
        "catalog_exposure_mode": {
          "type": "string",
          "enum": [
            "direct",
            "brokered",
            "exception_direct",
            "dormant"
          ]
        },
        "estimated_tool_count": {
          "type": "integer",
          "minimum": 0
        },
        "setupNotes": {
          "type": "string"
        },
        "exposure_exception_reason": {
          "type": "string"
        },
        "exposure_review_owner": {
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/catalog"
        },
        "public_access": {
          "$ref": "#/$defs/publicAccess"
        }
      }
    },
    "httpServer": {
      "type": "object",
      "required": [
        "transport",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "transport": {
          "const": "http"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "http_headers": {
          "$ref": "#/$defs/stringMap"
        },
        "env_http_headers": {
          "$ref": "#/$defs/stringMap"
        },
        "bearer_token_env_var": {
          "type": "string",
          "minLength": 1
        },
        "connect_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "list_tools_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "tool_call_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "headers": {
          "$ref": "#/$defs/stringMap"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "dormant",
            "local"
          ]
        },
        "package_path": {
          "type": "string"
        },
        "catalog_exposure_mode": {
          "type": "string",
          "enum": [
            "direct",
            "brokered",
            "exception_direct",
            "dormant"
          ]
        },
        "estimated_tool_count": {
          "type": "integer",
          "minimum": 0
        },
        "setupNotes": {
          "type": "string"
        },
        "exposure_exception_reason": {
          "type": "string"
        },
        "exposure_review_owner": {
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/catalog"
        },
        "public_access": {
          "$ref": "#/$defs/publicAccess"
        }
      }
    },
    "stdioServer": {
      "type": "object",
      "required": [
        "transport",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "transport": {
          "const": "stdio"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/$defs/stringMap"
        },
        "cwd": {
          "type": "string"
        },
        "tool_call_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "dormant",
            "local"
          ]
        },
        "package_path": {
          "type": "string"
        },
        "catalog_exposure_mode": {
          "type": "string",
          "enum": [
            "direct",
            "brokered",
            "exception_direct",
            "dormant"
          ]
        },
        "estimated_tool_count": {
          "type": "integer",
          "minimum": 0
        },
        "setupNotes": {
          "type": "string"
        },
        "exposure_exception_reason": {
          "type": "string"
        },
        "exposure_review_owner": {
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/catalog"
        }
      }
    },
    "server": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpServer"
        },
        {
          "$ref": "#/$defs/stdioServer"
        }
      ]
    }
  }
}
