  "receiptMirrors": {
    "local": ".cache/operator-agent-omnigent/",
    "linearIssue": "CRE-1061",
    "requiredBeforePromotion": [
      "manifest check receipt",
      "read-only Omnigent session transcript or equivalent local dry-run receipt",
      "local harness receipt parity note",
      "operator approval packet fixture validation"
    ]
  },
  "promotionGates": [
    {
      "id": "gate-0-manifest",
      "required": "manifest passes deterministic validator",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs check --json"
    },
    {
      "id": "gate-1-read-only-session",
      "required": "one Omnigent-wrapped read-only scout session or dry-run fixture produces a receipt mirrored to Linear",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs trial-check --json"
    },
    {
      "id": "gate-2-receipt-parity",
      "required": "Omnigent session receipt fields match local harness receipt fields for signal, context, policy, action, validation, rollback, and next decision",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs check --json"
    },
    {
      "id": "gate-3-a4-packet",
      "required": "A4 approval packet validates before any high-risk action is exposed",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs approval-check --packet <packet.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-4-a4-preflight",
      "required": "A4 preflight receipt emits the exact dry-run execution, validation, smoke, and rollback plan without executing writes",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs preflight-check --packet <packet.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-5-a4-execution-receipt-disabled",
      "required": "A4 execution receipt schema validates the packet and preflight receipt while keeping execution disabled",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs execution-receipt-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-6-a4-execution-authorization",
      "required": "A4 execution authorization artifact validates the packet, preflight receipt, and disabled execution receipt while keeping execution disabled",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs execution-authorization-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-7-a4-execution-command-admission",
      "required": "A4 execution command artifact validates the full authorization chain while keeping the runner disabled and execution blocked",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs execution-command-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-8-a4-disabled-executor-proof",
      "required": "A4 disabled executor proof validates the full command receipt chain and proves the runner stops before process spawn",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs executor-proof-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-9-a4-executor-enable-proposal",
      "required": "A4 executor enablement proposal validates the future policy patch and proof requirements without applying the policy change",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs executor-enable-proposal-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --executor-proof-receipt <executor-proof.json> --enablement-proposal <proposal.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-10-a4-policy-patch-dry-run",
      "required": "A4 policy patch dry run validates the proposal receipt and exact patch preview without changing the manifest or enabling the runner",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs policy-patch-dry-run-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --executor-proof-receipt <executor-proof.json> --enablement-proposal <proposal.json> --enablement-proposal-receipt <proposal-receipt.json> --policy-patch <policy-patch-dry-run.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-11-a4-policy-application-diff",
      "required": "A4 policy application diff validates a candidate manifest against the dry-run receipt without changing the checked-in manifest in the verifier PR",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs policy-application-diff-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --executor-proof-receipt <executor-proof.json> --enablement-proposal <proposal.json> --enablement-proposal-receipt <proposal-receipt.json> --policy-patch <policy-patch-dry-run.json> --policy-patch-receipt <policy-patch-receipt.json> --candidate-manifest <candidate-manifest.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
