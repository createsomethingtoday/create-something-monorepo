{
  "schemaVersion": 1,
  "id": "create-something-omnigent-a4-adapter",
  "status": "candidate-read-only",
  "createdAt": "2026-07-06",
  "issue": "CRE-1061",
  "purpose": "Evaluate Omnigent as the shared API and meta-harness layer for CREATE SOMETHING agents without granting it authority over A4 execution.",
  "sources": [
    {
      "label": "Databricks Omnigent announcement",
      "url": "https://www.databricks.com/blog/introducing-omnigent-meta-harness-combine-control-and-share-your-agents",
      "claimsUsed": [
        "meta-harness above Codex, Claude Code, Pi, and custom agents",
        "server-level contextual policies",
        "collaboration and shared live sessions",
        "cloud execution and sandboxing"
      ]
    },
    {
      "label": "omnigent-ai/omnigent README",
      "url": "https://github.com/omnigent-ai/omnigent",
      "claimsUsed": [
        "common orchestration layer over Codex, Claude Code, Cursor, OpenCode, Hermes, Pi, and custom agents",
        "policy and sandbox controls",
        "OpenAI-compatible gateway support including Ollama",
        "alpha project status"
      ]
    }
  ],
  "authority": {
    "currentLevel": "A0",
    "maximumLevelWithoutApprovalPacket": "A1",
    "a4Execution": "blocked",
    "authoritySource": "CREATE SOMETHING repo policy plus Linear approval packet",
    "omnigentRole": "transport-policy-host",
    "linearEvidenceRequired": true,
    "approvalPacketRequiredFor": [
      "A4",
      "production-write",
      "credential-write",
      "billing-change",
      "client-production",
      "destructive-write",
      "irreversible-data-operation"
    ]
  },
  "allowedCommands": [
    {
      "id": "readiness",
      "autonomyLevel": "A0",
      "command": "node scripts/operator-agent-a3-ownership-proof.mjs check --json",
      "writes": false,
      "requiresApprovalPacket": false,
      "receiptTarget": "Linear comment or local .cache/operator-agent-a3 receipt"
    },
    {
      "id": "a3-regression-tests",
      "autonomyLevel": "A0",
      "command": "node --test scripts/test/operator-agent-a3-ownership-proof.test.mjs",
      "writes": false,
      "requiresApprovalPacket": false,
      "receiptTarget": "test output"
    },
    {
      "id": "omnigent-adapter-check",
      "autonomyLevel": "A0",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs check --json",
      "writes": false,
      "requiresApprovalPacket": false,
      "receiptTarget": "Linear comment or local .cache/operator-agent-omnigent receipt"
    },
    {
      "id": "bounded-local-heal",
      "autonomyLevel": "A1",
      "command": "node scripts/operator-agent-a3-ownership-proof.mjs heal --file <local-proof-copy> --json",
      "writes": true,
      "writeScope": "local proof copy only",
      "requiresApprovalPacket": false,
      "receiptTarget": "local .cache/operator-agent-a3 receipt"
    }
  ],
  "forbiddenCommands": [
    "wrangler pages deploy",
    "wrangler deploy",
    "wrangler secret",
    "infisical secrets set",
    "git push",
    "gh pr merge",
    "pnpm linear:done",
    "billing",
    "delete",
    "destroy",
    "client production"
  ],
  "a4ApprovalPacket": {
    "requiredFields": [
      "authorityLevel",
      "issue",
      "approver",
      "approvalSurface",
      "approvedAt",
      "expiresAt",
      "target",
      "action",
      "riskClass",
      "namedRisks",
      "forbiddenSideEffects",
      "validation",
      "rollback",
      "postActionSmoke",
      "stopConditions",
      "evidenceTarget"
    ],
    "authorityLevel": "A4",
    "allowedApprovalSurfaces": [
      "Linear",
      "signed-release-record"
    ],
    "mustNameExactRisks": [
      "credential-write",
      "billing-change",
      "client-production",
      "destructive-write",
      "irreversible-data-operation"
    ],
    "mustStopOn": [
      "missing approval packet",
      "stale approval packet",
      "expired approval packet",
      "issue mismatch",
      "target mismatch",
      "action mismatch",
      "missing rollback",
      "missing post-action smoke",
      "unrecorded credential risk",
      "unrecorded billing risk",
      "unrecorded client-production risk",
      "unrecorded destructive risk",
      "unrecorded irreversible-data risk"
    ]
  },
  "a4ExecutionCommand": {
    "requiredFields": [
      "authorityLevel",
      "issue",
      "target",
      "action",
      "commandId",
      "commandSurface",
      "requestedBy",
      "requestedAt",
      "expiresAt",
      "executionMode",
      "packet",
      "preflightReceipt",
      "executionReceipt",
      "authorization",
      "evidenceTarget"
    ],
    "allowedCommandSurfaces": [
      "Linear",
      "signed-release-record"
    ],
    "allowedExecutionModes": [
      "operator-supervised"
    ],
    "runnerEnabled": false,
    "blockedUntil": "authority.a4Execution is changed by repo policy and an executor implementation revalidates the command receipt immediately before any write"
  },
  "a4ExecutorProof": {
    "runnerEnabled": false,
    "processSpawnPolicy": "blocked",
    "requiresCommandReceipt": true,
    "blockedUntil": "operator-approved repo policy change enables a narrowly scoped executor implementation with rollback and smoke proof"
  },
  "a4ExecutorEnablementProposal": {
    "allowedApprovalSurfaces": [
      "Linear",
      "signed-release-record"
    ],
    "maxWritesPerRun": 1,
    "requiredProofs": [
      "rollback",
      "post-action-smoke",
      "public-access-fail-closed"
    ],
    "policyChangeApplied": false,
    "blockedUntil": "a separate operator-reviewed PR applies the proposed policy patch and reruns access, rollback, and smoke proof"
  },
  "a4PolicyPatchDryRun": {
    "requiresEnablementProposalReceipt": true,
    "dryRunOnly": true,
    "maxWritesPerRun": 1,
    "requiredProofs": [
      "rollback",
      "post-action-smoke",
      "public-access-fail-closed"
    ],
    "allowedPatchFields": [
      "authority.a4Execution",
      "a4ExecutionCommand.runnerEnabled",
      "a4ExecutorProof.runnerEnabled"
    ],
    "policyFileChanged": false,
    "policyChangeApplied": false,
    "blockedUntil": "a separate operator-reviewed PR applies the validated patch and reruns public access, rollback, and smoke proof"
  },
  "a4PolicyApplicationDiff": {
    "requiresPolicyPatchDryRunReceipt": true,
    "exactPatchOnly": true,
    "policyChangeApplied": false,
    "runnerEnabled": false,
    "executionEnabled": false,
    "writesPerformed": 0,
    "blockedUntil": "a separate operator-reviewed policy application PR uses this verifier against its candidate manifest before enabling any runner path"
  },
  "a4EnabledManifestReadiness": {
    "requiresPolicyApplicationDiffReceipt": true,
    "candidateOnly": true,
    "currentPolicyMustRemainBlocked": true,
    "processSpawnPolicy": "blocked",
    "writesPerformed": 0,
    "blockedUntil": "a separate operator-reviewed implementation PR adds a runner that revalidates the full chain immediately before any write"
  },
  "a4RunnerImplementationContract": {
    "requiresEnabledManifestReadinessReceipt": true,
    "requiresImmediateFullChainRevalidation": true,
    "requiresEnabledCheckedInPolicy": true,
    "allowedWhenCurrentPolicyBlocked": false,
    "allowedImplementationSurfaces": [
      "repo-pr",
      "signed-release-record"
    ],
    "processSpawnPolicy": "blocked-until-checked-in-policy-enabled",
    "maxWritesPerRun": 1,
    "requiredProofs": [
      "rollback",
      "post-action-smoke",
      "public-access-fail-closed"
    ],
    "requiresCommandReceipt": true,
    "writesPerformed": 0,
    "blockedUntil": "a separate operator-reviewed implementation PR can add runner code only after checked-in policy is enabled and the runner revalidates the full chain immediately before any write"
  },
  "a4RunnerImplementationPlan": {
    "requiresRunnerImplementationContractReceipt": true,
    "planOnly": true,
    "executableEntrypointAdded": false,
    "allowedImplementationSurfaces": [
      "repo-pr",
      "signed-release-record"
    ],
    "allowedPlannedEntrypoints": [
      "scripts/operator-agent-omnigent-runner.mjs"
    ],
    "requiredGuards": [
      "checked-in-policy-enabled",
      "full-chain-revalidation",
      "command-receipt-bound",
      "max-writes-per-run",
      "rollback-ready",
      "post-action-smoke",
      "public-access-fail-closed",
      "stop-on-mismatch",
      "stop-on-expired",
      "stop-on-drift"
    ],
    "maxWritesPerRun": 1,
    "requiredProofs": [
      "rollback",
      "post-action-smoke",
      "public-access-fail-closed"
    ],
    "writesPerformed": 0,
    "blockedUntil": "a separate operator-reviewed implementation PR adds the planned runner entrypoint only after checked-in policy is enabled and the full plan is revalidated"
  },
  "receiptMirrors": {
    "local": ".cache/operator-agent-omnigent/",
    "linearIssue": "CRE-1061",
    "requiredBeforePromotion": [
      "manifest check receipt",
      "read-only Omnigent session transcript or equivalent local dry-run receipt",
      "local harness receipt parity note",
      "operator approval packet fixture validation"
    ]
  },
  "promotionGates": [
    {
      "id": "gate-0-manifest",
      "required": "manifest passes deterministic validator",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs check --json"
    },
    {
      "id": "gate-1-read-only-session",
      "required": "one Omnigent-wrapped read-only scout session or dry-run fixture produces a receipt mirrored to Linear",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs trial-check --json"
    },
    {
      "id": "gate-2-receipt-parity",
      "required": "Omnigent session receipt fields match local harness receipt fields for signal, context, policy, action, validation, rollback, and next decision",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs check --json"
    },
    {
      "id": "gate-3-a4-packet",
      "required": "A4 approval packet validates before any high-risk action is exposed",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs approval-check --packet <packet.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-4-a4-preflight",
      "required": "A4 preflight receipt emits the exact dry-run execution, validation, smoke, and rollback plan without executing writes",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs preflight-check --packet <packet.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-5-a4-execution-receipt-disabled",
      "required": "A4 execution receipt schema validates the packet and preflight receipt while keeping execution disabled",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs execution-receipt-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-6-a4-execution-authorization",
      "required": "A4 execution authorization artifact validates the packet, preflight receipt, and disabled execution receipt while keeping execution disabled",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs execution-authorization-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-7-a4-execution-command-admission",
      "required": "A4 execution command artifact validates the full authorization chain while keeping the runner disabled and execution blocked",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs execution-command-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-8-a4-disabled-executor-proof",
      "required": "A4 disabled executor proof validates the full command receipt chain and proves the runner stops before process spawn",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs executor-proof-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-9-a4-executor-enable-proposal",
      "required": "A4 executor enablement proposal validates the future policy patch and proof requirements without applying the policy change",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs executor-enable-proposal-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --executor-proof-receipt <executor-proof.json> --enablement-proposal <proposal.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-10-a4-policy-patch-dry-run",
      "required": "A4 policy patch dry run validates the proposal receipt and exact patch preview without changing the manifest or enabling the runner",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs policy-patch-dry-run-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --executor-proof-receipt <executor-proof.json> --enablement-proposal <proposal.json> --enablement-proposal-receipt <proposal-receipt.json> --policy-patch <policy-patch-dry-run.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-11-a4-policy-application-diff",
      "required": "A4 policy application diff validates a candidate manifest against the dry-run receipt without changing the checked-in manifest in the verifier PR",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs policy-application-diff-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --executor-proof-receipt <executor-proof.json> --enablement-proposal <proposal.json> --enablement-proposal-receipt <proposal-receipt.json> --policy-patch <policy-patch-dry-run.json> --policy-patch-receipt <policy-patch-receipt.json> --candidate-manifest <candidate-manifest.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-12-a4-enabled-manifest-readiness",
      "required": "A4 enabled-manifest readiness validates the candidate enabled manifest and application diff receipt without spawning a runner or changing checked-in policy",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs enabled-manifest-readiness-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --executor-proof-receipt <executor-proof.json> --enablement-proposal <proposal.json> --enablement-proposal-receipt <proposal-receipt.json> --policy-patch <policy-patch-dry-run.json> --policy-patch-receipt <policy-patch-receipt.json> --candidate-manifest <candidate-manifest.json> --application-diff-receipt <application-diff-receipt.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-13-a4-runner-implementation-contract",
      "required": "A4 runner implementation contract validates the future runner obligations against the full readiness chain without spawning a runner or changing checked-in policy",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs runner-implementation-contract-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --executor-proof-receipt <executor-proof.json> --enablement-proposal <proposal.json> --enablement-proposal-receipt <proposal-receipt.json> --policy-patch <policy-patch-dry-run.json> --policy-patch-receipt <policy-patch-receipt.json> --candidate-manifest <candidate-manifest.json> --application-diff-receipt <application-diff-receipt.json> --readiness-receipt <readiness-receipt.json> --runner-contract <runner-contract.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    },
    {
      "id": "gate-14-a4-runner-implementation-plan",
      "required": "A4 runner implementation plan validates the future entrypoint, guards, revalidation sequence, proof plans, and receipt outputs without adding or running an executable runner",
      "command": "node scripts/operator-agent-omnigent-adapter.mjs runner-implementation-plan-check --packet <packet.json> --preflight-receipt <preflight-receipt.json> --execution-receipt <execution-receipt.json> --authorization <authorization.json> --command-artifact <command.json> --command-receipt <command-receipt.json> --executor-proof-receipt <executor-proof.json> --enablement-proposal <proposal.json> --enablement-proposal-receipt <proposal-receipt.json> --policy-patch <policy-patch-dry-run.json> --policy-patch-receipt <policy-patch-receipt.json> --candidate-manifest <candidate-manifest.json> --application-diff-receipt <application-diff-receipt.json> --readiness-receipt <readiness-receipt.json> --runner-contract <runner-contract.json> --runner-contract-receipt <runner-contract-receipt.json> --runner-plan <runner-plan.json> --expected-issue <CRE-123> --expected-target <target> --expected-action <action> --json"
    }
  ]
}
