  "policyDocument": "docs/PUBLIC_WEB_DATA_PROVIDER_ROUTING.md",
  "principles": [
    "codify_house_capabilities_before_provider_names",
    "public_data_only",
    "broker_broad_provider_catalogs",
    "use_bright_data_for_durable_public_web_data",
    "keep_apify_for_actor_speed_fallbacks_and_existing_low_volume_flows",
    "promote_routes_only_after_smoke_evidence"
  ],
  "secrets": {
    "brightDataApiToken": "BRIGHT_DATA_API_TOKEN",
    "apifyApiToken": "APIFY_API_TOKEN"
  },
  "providers": {
    "bright_data": {
      "role": "default durable public-web and public-social data backend",
      "brokeredMcpServer": "composio-toolkit-brightdata",
      "bestFor": [
        "production public social monitoring",
        "high-volume public web extraction",
        "javascript-heavy public websites",
        "warehouse or webhook delivery",
        "enterprise support and unblocking requirements"
      ]
    },
    "apify": {
      "role": "actor marketplace, prototype lane, fallback lane, and existing low-volume workflow provider",
      "brokeredMcpServer": "composio-toolkit-apify",
      "bestFor": [
        "fast validation with maintained actors",
        "low-volume public data workflows",
        "scheduled automations where actor output already fits",
        "fallback while Bright Data field maps are still being validated"
      ]
    }
  },
  "houseCapabilities": [
    "public_social_posts",
    "public_social_profiles",
    "public_web_page_extract",
    "public_web_browser_session",
    "serp_results"
  ],
