  "routingRules": [
    {
      "useCase": "production_public_instagram_post_monitoring",
      "defaultRoute": "bright_data.instagram.posts.discover_by_url",
      "fallbackRoute": "apify.instagram.posts.actor",
      "promotionRequired": true
    },
    {
      "useCase": "known_instagram_post_backfill_or_spot_check",
      "defaultRoute": "bright_data.instagram.posts.collect_by_url",
      "fallbackRoute": "apify.instagram.posts.actor",
      "promotionRequired": false
    },
    {
      "useCase": "public_instagram_profile_enrichment",
      "defaultRoute": "bright_data.instagram.profiles.discover_by_user_name",
      "fallbackRoute": null,
      "promotionRequired": true
    },
    {
      "useCase": "javascript_heavy_public_venue_page_extraction",
      "defaultRoute": "bright_data.public_web.browser_api",
      "fallbackRoute": null,
      "promotionRequired": true
    }
  ],
  "pilots": {
    "kickstand_instagram": {
      "status": "recommended_shadow_pilot",
      "controlRoute": "apify.instagram.posts.actor",
      "candidateRoute": "bright_data.instagram.posts.discover_by_url",
      "accessDecision": {
        "productionAdapter": "direct_bright_data_api",
        "operatorTesting": "composio_bright_data",
        "fallback": "apify_direct_api",
        "rationale": "Composio Bright Data validated dataset inventory and known-post collection, but the current crawl_api wrapper does not expose Instagram profile discover_by=url. Kickstand monitoring needs profile discovery, so production should use the direct Bright Data scraper API behind a house adapter."
      },
