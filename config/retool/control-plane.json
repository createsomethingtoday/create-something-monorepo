{
  "version": 1,
  "instance": {
    "slug": "createsomething",
    "baseUrl": "https://createsomething.retool.com",
    "apiBaseUrl": "https://createsomething.retool.com/api/v2",
    "mcpUrl": "https://createsomething.retool.com/mcp"
  },
  "codexMcp": {
    "name": "retool",
    "transport": "http",
    "url": "https://createsomething.retool.com/mcp",
    "auth": "oauth",
    "scopes": ["mcp:read", "mcp:admin"]
  },
  "infisical": {
    "env": "prod",
    "path": "/retool",
    "secretNames": {
      "apiToken": "RETOOL_API_TOKEN",
      "origin": "RETOOL_ORIGIN",
      "apiBaseUrl": "RETOOL_API_BASE_URL",
      "mcpUrl": "RETOOL_MCP_URL"
    }
  },
  "createSomethingMcpResource": {
    "title": "CREATE SOMETHING MCP Hub",
    "description": "Brokered MCP hub for CREATE SOMETHING monorepo tools, delivery state, and governed workflow execution.",
    "serverUrl": "https://cs-mcp-hub-remote.createsomething.workers.dev/mcp",
    "auth": "managed_bearer"
  },
  "lockInBoundary": {
    "retoolRole": "ui_control_plane",
    "sourceOfTruth": "monorepo",
    "portableArtifacts": [
      "contracts",
      "schemas",
      "mcp_servers",
      "agent_contracts",
      "runbooks",
      "delivery_graph_manifest",
      "observability_events",
      "loom_evidence"
    ],
    "nonPortableRetoolState": [
      "app_layouts",
      "component_configuration",
      "resource_credentials",
      "native_workflow_canvas",
      "native_agent_configuration",
      "user_and_group_configuration",
      "retool_hosted_storage"
    ],
    "avoidAsSystemOfRecord": [
      "client_delivery_artifacts",
      "workflow_contracts",
      "policy_rules",
      "production_business_data",
      "source_code",
      "secrets"
    ],
    "exitStrategy": "Any production surface must be rebuildable from monorepo contracts, MCP servers, external databases, and generated delivery graph manifests without requiring Retool as the authoritative data store."
  }
}
