{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://createsomething.local/schemas/retool-inventory.schema.json",
  "title": "CREATE SOMETHING Retool Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workspace",
    "status",
    "snapshot",
    "access",
    "mcp_resources",
    "resources",
    "apps",
    "workflows",
    "evals"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "provider", "origin", "api_base_url", "mcp_url"],
      "properties": {
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "provider": { "enum": ["retool_cloud", "self_hosted"] },
        "origin": { "type": "string", "format": "uri" },
        "api_base_url": { "type": "string", "format": "uri" },
        "mcp_url": { "type": "string", "format": "uri" }
      }
    },
    "status": {
      "enum": ["partial", "complete"]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_manual_inventory_at", "source", "notes"],
      "properties": {
        "last_manual_inventory_at": { "type": "string" },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daily_mcp_scopes",
        "admin_mcp_scopes",
        "admin_use_cases",
        "rest_api_secret",
        "rest_api_smoke_path",
        "rest_api_smoke_success_scopes",
        "rest_api_smoke_ui_scope",
        "rest_api_smoke_scope_status",
        "rest_api_smoke_notes",
        "spaces_token_policy",
        "evidence_system"
      ],
      "properties": {
        "daily_mcp_scopes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "admin_mcp_scopes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "admin_use_cases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rest_api_secret": {
          "$ref": "#/$defs/secretRef"
        },
        "rest_api_smoke_path": {
          "type": "string"
        },
        "rest_api_smoke_success_scopes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "rest_api_smoke_ui_scope": {
          "type": "string"
        },
        "rest_api_smoke_scope_status": {
          "enum": ["candidate_visible", "verified", "blocked_pending_scope"]
        },
        "rest_api_smoke_notes": {
          "type": "string"
        },
        "spaces_token_policy": {
          "type": "string"
        },
        "evidence_system": {
          "const": "linear"
        }
      }
    },
    "mcp_resources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/mcpResource"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/retoolResource"
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/retoolApp"
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/retoolWorkflow"
      }
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_system", "project", "local_command", "required_checks"],
      "properties": {
        "owner_system": { "const": "braintrust" },
        "project": { "type": "string" },
        "local_command": { "type": "string" },
        "published_command": { "type": "string" },
        "required_checks": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "last_verified_at": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "path", "secret_key"],
      "properties": {
        "environment": { "type": "string" },
        "path": { "type": "string" },
        "secret_key": { "type": "string" }
      }
    },
    "mcpAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["none", "bearer", "managed_bearer", "oauth", "custom"]
        },
        "infisical": {
          "$ref": "#/$defs/secretRef"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "mcpResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "server_url",
        "auth",
        "direction",
        "exposure",
        "status",
        "source"
      ],
      "properties": {
        "display_name": { "type": "string" },
        "server_url": { "type": "string", "format": "uri" },
        "auth": { "$ref": "#/$defs/mcpAuth" },
        "direction": {
          "enum": ["retool_to_hub", "codex_to_retool"]
        },
        "exposure": {
          "enum": ["operator", "client_summary", "internal"]
        },
        "status": {
          "enum": ["planned", "configured", "verified", "retired"]
        },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "retoolResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "kind", "status", "source"],
      "properties": {
        "display_name": { "type": "string" },
        "kind": {
          "enum": ["rest_api", "mcp_server", "generated_manifest", "database", "workflow"]
        },
        "status": {
          "enum": ["planned", "configured", "verified", "retired"]
        },
        "source": { "type": "string" },
        "base_url": { "type": "string", "format": "uri" },
        "auth": { "$ref": "#/$defs/mcpAuth" },
        "notes": { "type": "string" }
      }
    },
    "retoolApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "status",
        "visibility",
        "source",
        "modules",
        "data_sources",
        "writes_to_retool_storage",
        "production_ready",
        "evidence"
      ],
      "properties": {
        "display_name": { "type": "string" },
        "status": {
          "enum": ["planned", "manifest_ready", "production", "retired"]
        },
        "visibility": {
          "enum": ["private_internal", "operator", "client_summary", "client_audit", "public_redacted"]
        },
        "source": {
          "enum": ["manifest_generated", "retool_native", "manual"]
        },
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data_sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writes_to_retool_storage": { "type": "boolean" },
        "production_ready": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "retoolWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "status", "trigger", "write_policy", "evidence"],
      "properties": {
        "display_name": { "type": "string" },
        "status": {
          "enum": ["planned", "configured", "verified", "retired"]
        },
        "trigger": { "type": "string" },
        "write_policy": {
          "enum": ["none", "requires_approval", "disabled"]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
