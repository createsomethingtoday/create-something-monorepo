{
  "mcpServers": {
    "wf-template-review-natalia": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://wf-template-review-natalia.mcp.createsomething.agency/mcp",
        "--transport",
        "http-only",
        "--header",
        "Authorization:${WF_TEMPLATE_REVIEW_NATALIA_AUTH_HEADER}",
        "--silent"
      ],
      "env": {
        "WF_TEMPLATE_REVIEW_NATALIA_AUTH_HEADER": "Bearer PASTE_NATALIA_REVIEWER_TOKEN_HERE"
      }
    },
