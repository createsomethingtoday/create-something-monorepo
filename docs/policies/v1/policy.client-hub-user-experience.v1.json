{
  "policy_id": "policy.client-hub-user-experience.v1",
  "version": 1,
  "status": "draft",
  "portal_defaults": {
    "canonical_portal": ".agency",
    "dedicated_client_shell_allowed": true,
    "provider_brand_hidden_by_default": true,
    "workspace_or_tenant_centric_labels_required": true,
    "transparent_named_lane_required": true,
    "named_lane_pattern": "<person-slug>-<client-slug>",
    "host_bound_named_lane_credentials_required": true,
    "white_glove_initial_delivery_allowed": true,
    "white_glove_follow_on_self_service_surface": ".agency"
  },
  "required_user_surfaces": [
    "access_overview",
    "mcp_access",
    "connections",
    "security_model"
  ],
  "optional_product_surfaces": [
    "hosted_concierge_chat"
  ],
  "onboarding_sequence": [
    "access_eligibility",
    "identity_mapping",
    "credential_delivery",
    "toolkit_connection_status",
    "host_setup",
    "security_and_support"
  ],
  "broker_discovery_defaults": {
    "service_first_router_required": true,
    "service_summary_before_proxy_search_required": true,
    "server_scoped_proxy_search_when_service_known": true,
    "full_catalog_proxy_authorization_before_service_selection_prohibited": true,
    "named_discovery_packs_required_for_shared_hubs": true,
    "discovery_reset_returns_to_managed_pack": true,
    "manual_active_server_overrides_exception_only": true
  },
  "self_service_actions": [
    "policy_acceptance",
    "managed_bearer_issue",
    "managed_bearer_revoke",
    "managed_bearer_regenerate",
    "mcp_oauth_password_set",
    "mcp_oauth_password_rotate",
    "view_connection_status",
    "launch_connect_link",
    "copy_host_snippet"
  ],
  "operator_only_actions": [
    "entitlement_override",
    "tenant_routing_mutation",
    "toolkit_account_pin",
    "toolkit_account_disable",
    "partner_admin_mint",
    "legacy_credential_issue",
    "runtime_bootstrap_secret_rotation",
    "runtime_bootstrap_secret_sync",
    "control_plane_mutation"
  ],
  "blocked_state_requirements": {
    "explicit_reason_code_required": true,
    "generic_access_denied_prohibited": true
  },
  "white_glove_onboarding_requirements": {
    "operator_delivered_initial_bearer_allowed": true,
    "must_distinguish_initial_handoff_from_self_service": true,
    "must_route_ongoing_management_back_to_agency": true,
    "runtime_bootstrap_tokens_customer_visible_prohibited": true
  },
  "dui_controls": {
    "curated_ui_resources_only": true,
    "raw_model_generated_executable_ui_prohibited": true,
    "schema_driven_ui_allowed_when_rendered_by_approved_components": true,
    "server_tool_gating_required_for_mutations": true
  },
  "hosted_product_controls": {
    "separate_from_agency_control_plane": true,
    "separate_from_mcp_app_dui_resources": true,
    "progressive_profile_governance_required": true
  },
  "observability_baseline": {
    "telemetry_required_for_named_lanes": true,
    "langfuse_required_for_named_lanes": true
  }
}
