{
  "policy_id": "policy.mcp-credential-delivery.v1",
  "version": 1,
  "status": "draft",
  "credential_types": [
    "strict_session_bundle",
    "legacy_key_bundle"
  ],
  "requirements": {
    "legacy_issue_requires_exception_approval": true,
    "ttl_required": true,
    "revocation_required": true,
    "no_plaintext_secret_persistence": true,
    "approved_vault_providers": [
      "doppler",
      "infisical"
    ],
    "automation_requires_non_interactive_machine_auth": true
  },
  "migration_controls": {
    "dry_run_required_before_cutover": true,
    "verification_required_before_cutover": true,
    "verification_zero_missing_required": true,
    "verification_zero_mismatched_required": true
  },
  "delivery_audit_fields": [
    "delivery_channel",
    "delivered_by",
    "recipient",
    "artifact_ref",
    "expires_at"
  ],
  "vault_execution_audit_fields": [
    "vault_provider",
    "source_project",
    "source_config",
    "target_environment",
    "target_path",
    "dry_run",
    "result"
  ]
}
