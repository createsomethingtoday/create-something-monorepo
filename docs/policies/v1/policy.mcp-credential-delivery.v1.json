{
  "policy_id": "policy.mcp-credential-delivery.v1",
  "version": 1,
  "status": "draft",
  "credential_types": [
    "strict_session_bundle",
    "legacy_key_bundle",
    "managed_bearer_bundle",
    "oauth_facade_managed_bearer_bundle"
  ],
  "requirements": {
    "transparent_named_lane_url_required": true,
    "host_bound_named_lane_credentials_required": true,
    "telemetry_required_for_named_lanes": true,
    "langfuse_required_for_named_lanes": true,
    "account_attribution_required_for_named_lane_observability": true,
    "white_glove_initial_delivery_allowed": true,
    "white_glove_follow_on_self_service_required": true,
    "runtime_bootstrap_tokens_customer_delivery_prohibited": true,
    "approved_search_providers": [
      "composio-toolkit-exa",
      "composio-toolkit-perplexityai",
      "composio-toolkit-composio_search"
    ],
    "promised_search_provider_auth_config_required": true,
    "promised_search_provider_connect_link_required": true,
    "promised_no_auth_search_provider_broker_call_required": true,
    "legacy_issue_requires_exception_approval": true,
    "ttl_required": true,
    "revocation_required": true,
    "managed_bearer_silent_rotation_prohibited": true,
    "runtime_secret_retain_by_default": true,
    "routine_sync_must_not_rotate": true,
    "rotation_incident_ticket_required": false,
    "no_plaintext_secret_persistence": true,
    "oauth_facade_may_deliver_managed_bearer": true,
    "oauth_facade_must_not_replace_existing_bearer_clients": true,
    "oauth_facade_must_not_expose_runtime_guardrail_tokens": true,
    "oauth_login_password_is_separate_credential": true,
    "portal_self_service_oauth_password_management_required": true,
    "stored_oauth_password_reveal_prohibited": true,
    "host_compat_compat_mode_allowed": true,
    "host_compat_compat_mode_requires_identity_resolver": true,
    "host_compat_compat_mode_requires_header_override_disabled": true,
    "host_compat_compat_mode_requires_bound_host_and_prefix_enforcement": true,
    "host_compat_compat_mode_distinct_from_legacy_sunset": true,
    "approved_vault_providers": [
      "infisical"
    ],
    "automation_requires_non_interactive_machine_auth": true
  },
  "migration_controls": {
    "dry_run_required_before_cutover": true,
    "verification_required_before_cutover": true,
    "verification_zero_missing_required": true,
    "verification_zero_mismatched_required": true
  },
  "delivery_audit_fields": [
    "delivery_channel",
    "delivered_by",
    "recipient",
    "artifact_ref",
    "account_id",
    "tenant_id",
    "expires_at",
    "initial_delivery_mode",
    "follow_on_management_surface",
    "search_providers",
    "lane_slug",
    "lane_hub_url",
    "lane_host_key",
    "bound_host",
    "allowed_tool_prefixes"
  ],
  "vault_execution_audit_fields": [
    "vault_provider",
    "source_project",
    "source_config",
    "target_environment",
    "target_path",
    "dry_run",
    "result"
  ]
}
