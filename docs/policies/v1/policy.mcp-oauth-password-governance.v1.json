{
  "policy_id": "policy.mcp-oauth-password-governance.v1",
  "version": 1,
  "status": "draft",
  "identity_model": {
    "portal_identity_provider": "create_something_identity",
    "oauth_login_provider": "identity_worker",
    "oauth_capable_host_examples": ["notion", "chatgpt"],
    "oauth_login_password_separate_from_portal_identity": true,
    "oauth_login_password_separate_from_managed_bearer": true,
    "one_active_password_per_entitled_email": true
  },
  "ui_requirements": {
    "portal_surface_required": true,
    "must_display_bound_email": true,
    "must_display_linked_mcp_context": true,
    "must_support_set_password": true,
    "must_support_rotate_password": true,
    "temporary_generated_password_may_be_revealed_once": true,
    "stored_password_reveal_allowed": false
  },
  "security_requirements": {
    "plaintext_password_persistence_prohibited": true,
    "password_rotation_independent_from_bearer_rotation": true,
    "password_management_requires_authenticated_portal_session": true,
    "password_management_requires_entitlement_check": true,
    "runtime_guardrail_tokens_must_not_be_reused_as_passwords": true,
    "identity_session_tokens_must_not_be_reused_as_passwords": true,
    "managed_bearer_tokens_must_not_be_reused_as_passwords": true
  },
  "audit_requirements": [
    "actor",
    "auth_email",
    "account_id",
    "tenant_id",
    "event_type",
    "created_at"
  ]
}
