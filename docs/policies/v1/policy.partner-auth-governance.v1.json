{
  "policy_id": "policy.partner-auth-governance.v1",
  "version": 1,
  "status": "draft",
  "boundary": "partner_admin_mint",
  "rollout_defaults": {
    "mode": "legacy_enforce",
    "canary_percent": 0
  },
  "required_inputs": [
    "account_id",
    "consent_record_id",
    "consent_granted_at",
    "actor",
    "workflow_job_id"
  ],
  "required_telemetry_fields": [
    "account_id",
    "tenant_id",
    "lane_slug_or_bound_host",
    "decision",
    "evaluation_path",
    "policy_hash",
    "fallback_used",
    "actor"
  ],
  "named_lane_controls": {
    "data_driven_lane_records_required": true,
    "lane_scoped_issue_routes_required": true,
    "explicit_allowed_tool_prefixes_supported": true,
    "bound_host_required_for_named_lane_credentials": true,
    "telemetry_required": true,
    "langfuse_required": true,
    "account_attribution_required_for_observability": true,
    "white_glove_initial_delivery_allowed": true,
    "white_glove_follow_on_self_service_required": true,
    "runtime_bootstrap_tokens_customer_delivery_prohibited": true,
    "approved_search_providers": [
      "composio-toolkit-exa",
      "composio-toolkit-perplexityai",
      "composio-toolkit-composio_search"
    ],
    "promised_search_provider_auth_config_required": true,
    "promised_search_provider_connect_link_required": true,
    "promised_no_auth_search_provider_broker_call_required": true
  },
  "deny_conditions": [
    "missing_consent_record",
    "missing_actor",
    "unpinned_toolkit_account_for_automation",
    "personal_bearer_used_for_automation",
    "missing_required_subject_binding_for_selected_credential_type",
    "missing_exception_approval_for_selected_credential_type"
  ],
  "governed_actions": [
    "admin_mint_session",
    "view_toolkit_auth",
    "upsert_toolkit_account",
    "create_toolkit_connect_link",
    "pin_toolkit_account",
    "disable_toolkit_account",
    "run_partner_workflow_job"
  ],
  "review_required_actions": [
    "pin_toolkit_account",
    "disable_toolkit_account"
  ],
  "lane_scoped_routes": [
    "/api/partners/half-dozen/clients/:slug/lanes/:laneSlug/init",
    "/api/partners/half-dozen/clients/:slug/lanes/:laneSlug/access/mint",
    "/api/partners/half-dozen/clients/:slug/lanes/:laneSlug/bearer-token/issue"
  ],
  "white_glove_delivery_audit_fields": [
    "delivery_channel",
    "recipient",
    "initial_delivery_mode",
    "follow_on_management_surface",
    "account_id",
    "tenant_id",
    "allowed_tool_prefixes",
    "bound_host"
  ]
}
