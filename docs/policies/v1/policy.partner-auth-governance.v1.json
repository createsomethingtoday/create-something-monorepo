{
  "policy_id": "policy.partner-auth-governance.v1",
  "version": 1,
  "status": "draft",
  "boundary": "partner_admin_mint",
  "rollout_defaults": {
    "mode": "legacy_enforce",
    "canary_percent": 0
  },
  "required_inputs": [
    "account_id",
    "consent_record_id",
    "consent_granted_at",
    "actor"
  ],
  "required_telemetry_fields": [
    "decision",
    "evaluation_path",
    "policy_hash",
    "fallback_used",
    "actor"
  ],
  "deny_conditions": [
    "missing_consent_record",
    "missing_actor"
  ],
  "governed_actions": [
    "admin_mint_session",
    "view_toolkit_auth",
    "upsert_toolkit_account",
    "create_toolkit_connect_link",
    "pin_toolkit_account",
    "disable_toolkit_account"
  ],
  "review_required_actions": [
    "pin_toolkit_account",
    "disable_toolkit_account"
  ]
}
