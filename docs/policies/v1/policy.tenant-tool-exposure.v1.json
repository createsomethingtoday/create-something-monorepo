{
  "policy_id": "policy.tenant-tool-exposure.v1",
  "version": 1,
  "status": "draft",
  "routing_defaults": {
    "tenant": "default",
    "allow_pending_oauth_approvals": false
  },
  "tenant_policy_controls": {
    "by_server": true,
    "by_tag": true,
    "by_tool_prefix": true,
    "by_target_scope": true,
    "named_lane_allowlists_required": true
  },
  "discovery_pack_defaults": {
    "named_discovery_packs_standard_for_shared_hubs": true,
    "discovery_reset_returns_to_assigned_pack": true,
    "manual_active_server_overrides_exception_only": true
  },
  "workflow_sync_preferences": {
    "prefer_dedicated_workflow_routes": true
  },
  "alias_route_requirements": {
    "ordered_candidates": true,
    "candidate_status_supported": [
      "approved",
      "pending",
      "blocked"
    ],
    "provider_failover_enabled": true
  },
  "change_management": {
    "hub_restart_required_after_inventory_changes": true,
    "audit_fields": [
      "tenant_id",
      "changed_by",
      "changed_at",
      "change_reason"
    ]
  },
  "named_lane_baseline": {
    "default_deny": true,
    "blondish_allow_servers": [
      "notion-halfdozen-blondish",
      "composio-toolkit-gmail",
      "composio-toolkit-exa",
      "composio-toolkit-perplexityai",
      "composio-toolkit-composio_search"
    ],
    "c3_management_allow_servers": [
      "notion-halfdozen-c3-management",
      "composio-toolkit-gmail",
      "composio-toolkit-exa",
      "composio-toolkit-perplexityai",
      "composio-toolkit-composio_search"
    ],
    "no_auth_search_providers": [
      "composio-toolkit-composio_search"
    ],
    "telemetry_required": true,
    "langfuse_required": true,
    "account_attribution_required": true,
    "required_trace_fields": [
      "account_id",
      "tenant_id",
      "lane_slug_or_bound_host",
      "correlation_id",
      "route_classification",
      "policy_or_review_outcome"
    ],
    "langfuse_auto_instrumentation_requires_house_governance_metadata": true,
    "trace_tags_should_be_business_legible": true
  }
}
