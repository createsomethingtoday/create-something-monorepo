{
  "policy_id": "policy.tenant-tool-exposure.v1",
  "version": 1,
  "status": "draft",
  "routing_defaults": {
    "tenant": "default",
    "allow_pending_oauth_approvals": false
  },
  "tenant_policy_controls": {
    "by_server": true,
    "by_tag": true,
    "by_tool_prefix": true,
    "by_target_scope": true,
    "named_lane_allowlists_required": true
  },
  "workflow_sync_preferences": {
    "prefer_dedicated_workflow_routes": true
  },
  "alias_route_requirements": {
    "ordered_candidates": true,
    "candidate_status_supported": [
      "approved",
      "pending",
      "blocked"
    ],
    "provider_failover_enabled": true
  },
  "change_management": {
    "hub_restart_required_after_inventory_changes": true,
    "audit_fields": [
      "tenant_id",
      "changed_by",
      "changed_at",
      "change_reason"
    ]
  },
  "named_lane_baseline": {
    "default_deny": true,
    "blondish_allow_servers": [
      "notion-halfdozen-blondish",
      "composio-toolkit-gmail",
      "composio-toolkit-exa"
    ],
    "c3_management_allow_servers": [
      "notion-halfdozen-c3-management",
      "composio-toolkit-gmail",
      "composio-toolkit-exa"
    ],
    "telemetry_required": true,
    "braintrust_required": true,
    "account_attribution_required": true,
    "required_trace_fields": [
      "account_id",
      "tenant_id",
      "lane_slug_or_bound_host"
    ]
  }
}
