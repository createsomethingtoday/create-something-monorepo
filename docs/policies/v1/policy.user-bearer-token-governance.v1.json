{
  "policy_id": "policy.user-bearer-token-governance.v1",
  "version": 1,
  "status": "draft",
  "token_model": {
    "type": "long_lived_user_bearer_token",
    "one_active_token_per_user": true,
    "shared_team_tokens_allowed": false,
    "issuer": "agency",
    "identity_provider": "create_something_identity",
    "token_format": "opaque",
    "plaintext_display": "issue_or_regenerate_only",
    "compat_mode_allowed_for_host_compatibility": true,
    "oauth_delivery_allowed": true,
    "oauth_access_token_may_equal_managed_bearer": true,
    "oauth_requires_portable_bearer_auth": true,
    "oauth_login_password_separate_from_bearer": true
  },
  "authorization_requirements": {
    "live_check_per_request": true,
    "compat_mode_requires_identity_resolver": true,
    "compat_mode_preserves_bound_host_rejection": true,
    "compat_mode_preserves_allowed_tool_prefixes": true,
    "compat_mode_trust_client_account_headers": false,
    "required_checks": [
      "token_status",
      "user_status",
      "organization_membership",
      "organization_context",
      "service_entitlement",
      "policy_acceptance",
      "contract_status",
      "billing_status"
    ],
    "fail_closed": true
  },
  "lifecycle_controls": {
    "revocation_required": true,
    "regeneration_required": true,
    "retain_active_token_by_default": true,
    "silent_rotation_prohibited": true,
    "explicit_rotation_required": true,
    "rotation_incident_ticket_required": false,
    "regeneration_invalidates_previous_token": true,
    "compromise_response_required": true,
    "oauth_password_rotation_independent_from_bearer_rotation": true
  },
  "audit_requirements": [
    "token_id",
    "user_id",
    "organization_id",
    "service_key",
    "decision",
    "ip",
    "user_agent",
    "created_at"
  ],
  "legal_alignment_required": true,
  "required_legal_artifacts": [
    "terms_or_msa",
    "security_policy",
    "acceptable_use_for_agents_and_third_party_hosts",
    "onboarding_disclosure",
    "incident_response_language"
  ]
}
