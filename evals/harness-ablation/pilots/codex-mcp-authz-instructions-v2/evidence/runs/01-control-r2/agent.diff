+test('hub route classification keeps stable identifiers ahead of incidental description keywords', () => {
+  const classification = classifyHubRoute(
+    {
+      proxyToolName: 'records__list_records',
+      serverName: 'records',
+      downstreamToolName: 'list_records',
+    },
+    {
+      description: 'Lists records and their state, including records moved to trash.',
+    },
+  );
+
+  assert.equal(classification.accessType, 'read');
+});
+
+test('hub route classification uses the concrete invocation action for multiplexed routes', () => {
+  const route = {
+    proxyToolName: 'admin__manage_resource',
+    serverName: 'admin',
+    downstreamToolName: 'manage_resource',
+  };
+
+  for (const [invocationAction, accessType] of [
+    ['get', 'read'],
+    ['update', 'write'],
+    ['delete', 'destructive'],
+    ['authorize', 'auth_admin'],
+    ['set_policy', 'control_plane'],
+  ]) {
+    assert.equal(classifyHubRoute({ ...route, invocationAction }).accessType, accessType);
+  }
+});
+
+test('hub authorization requests retain the invocation action used for classification', () => {
+  const request = buildHubAuthorizationRequest({
+    accountId: 'acct_1',
+    proxyToolName: 'admin__manage_resource',
+    serverName: 'admin',
+    downstreamToolName: 'manage_resource',
+    invocationAction: 'delete',
+    actionName: 'execute',
+  });
+
+  assert.equal(request.resource.accessType, 'destructive');
+  assert.equal(request.resource.metadata?.invocationAction, 'delete');
+  assert.equal(request.action.writeIntent, true);
+});
+
