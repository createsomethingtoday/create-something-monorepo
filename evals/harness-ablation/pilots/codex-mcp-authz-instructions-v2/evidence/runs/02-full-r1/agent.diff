+test('hub route classification ignores incidental destructive and control-plane description words', () => {
+  const classification = classifyHubRoute(
+    {
+      proxyToolName: 'catalog__get_document',
+      serverName: 'catalog',
+      downstreamToolName: 'get_document',
+    },
+    {
+      description: 'Read the document state without moving it to trash.',
+    },
+  );
+
+  assert.equal(classification.accessType, 'read');
+});
+
+test('hub route classification uses a multiplexed invocation action and retains it in request metadata', () => {
+  const route = {
+    proxyToolName: 'management__manage',
+    serverName: 'management',
+    downstreamToolName: 'manage',
+  };
+
+  assert.equal(classifyHubRoute(route, undefined, 'get_status').accessType, 'read');
+  assert.equal(classifyHubRoute(route, undefined, 'update_policy').accessType, 'control_plane');
+  assert.equal(classifyHubRoute(route, undefined, 'delete_connection').accessType, 'destructive');
+  assert.equal(classifyHubRoute(route, undefined, 'rotate_token').accessType, 'auth_admin');
+  assert.equal(classifyHubRoute(route, undefined, 'create_document').accessType, 'write');
+
+  const request = buildHubAuthorizationRequest({
+    accountId: 'acct_1',
+    ...route,
+    actionName: 'execute',
+    invocationAction: 'delete_connection',
+  });
+
+  assert.equal(request.resource.accessType, 'destructive');
+  assert.equal(request.resource.metadata.invocationAction, 'delete_connection');
+});
+
