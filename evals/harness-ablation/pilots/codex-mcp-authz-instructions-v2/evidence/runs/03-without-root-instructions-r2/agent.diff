+test('hub route classification ignores incidental description words', () => {
+  const classification = classifyHubRoute(
+    {
+      proxyToolName: 'composio-toolkit-linear__linear_list_issues',
+      serverName: 'composio-toolkit-linear',
+      downstreamToolName: 'linear_list_issues',
+    },
+    {
+      description: 'List issues and show their state; items may have been moved to trash previously.',
+    },
+  );
+
+  assert.equal(classification.accessType, 'read');
+});
+
+test('hub route invocation action overrides a multiplexed route default', () => {
+  const route = {
+    proxyToolName: 'create-something__manage_policy_state',
+    serverName: 'create-something',
+    downstreamToolName: 'manage_policy_state',
+  };
+
+  assert.equal(classifyHubRoute(route).accessType, 'control_plane');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'get_state' }).accessType, 'read');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'create_record' }).accessType, 'write');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'delete_record' }).accessType, 'destructive');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'authorize_connection' }).accessType, 'auth_admin');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'set_rollout' }).accessType, 'control_plane');
+});
+
+test('hub authorization request retains and uses an invocation action', () => {
+  const request = buildHubAuthorizationRequest({
+    accountId: 'acct_1',
+    proxyToolName: 'create-something__manage_policy_state',
+    serverName: 'create-something',
+    downstreamToolName: 'manage_policy_state',
+    invocationAction: 'get_state',
+    actionName: 'execute',
+  });
+
+  assert.equal(request.resource.accessType, 'read');
+  assert.equal(request.action.writeIntent, false);
+  assert.equal(request.resource.metadata.invocationAction, 'get_state');
+});
