+test('hub route classification ignores incidental description intent words', () => {
+  const classification = classifyHubRoute(
+    {
+      proxyToolName: 'hub__list_documents',
+      serverName: 'hub',
+      downstreamToolName: 'list_documents',
+    },
+    { description: 'List documents, including state and trash metadata.' },
+  );
+
+  assert.equal(classification.accessType, 'read');
+});
+
+test('hub route invocation actions refine multiplexed route access and are retained', () => {
+  const route = {
+    proxyToolName: 'hub__management',
+    serverName: 'hub',
+    downstreamToolName: 'management',
+  };
+
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'get_state' }).accessType, 'read');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'update_rollout' }).accessType, 'control_plane');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'create_record' }).accessType, 'write');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'delete_record' }).accessType, 'destructive');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'authorize_account' }).accessType, 'auth_admin');
+
+  const request = buildHubAuthorizationRequest({
+    accountId: 'acct_1',
+    ...route,
+    invocationAction: 'get_state',
+    actionName: 'execute',
+  });
+
+  assert.equal(request.action.invocationAction, 'get_state');
+  assert.equal(request.resource.metadata.invocationAction, 'get_state');
+  assert.equal(request.action.writeIntent, false);
+});
