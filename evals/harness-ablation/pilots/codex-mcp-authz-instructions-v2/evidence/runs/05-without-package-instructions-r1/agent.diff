+test('hub route classification ignores incidental destructive and control-plane description words', () => {
+  const classification = classifyHubRoute(
+    {
+      proxyToolName: 'workspace-tools__list_documents',
+      serverName: 'workspace-tools',
+      downstreamToolName: 'list_documents',
+    },
+    {
+      description: 'Lists documents, including their state and whether they are in the trash.',
+    },
+  );
+
+  assert.equal(classification.accessType, 'read');
+});
+
+test('hub route classification gives a concrete invocation action precedence over a multiplexed route', () => {
+  const route = {
+    proxyToolName: 'admin-tools__manage',
+    serverName: 'admin-tools',
+    downstreamToolName: 'manage_policy_state',
+  };
+
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'list' }).accessType, 'read');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'update' }).accessType, 'write');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'delete' }).accessType, 'destructive');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'authorize' }).accessType, 'auth_admin');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'get_policy_state' }).accessType, 'control_plane');
+});
+
+test('hub authorization requests retain and authorize against the invocation action', async () => {
+  const request = buildHubAuthorizationRequest({
+    accountId: 'acct_1',
+    sessionId: 'session_1',
+    toolMode: 'read_only',
+    identitySource: 'session',
+    proxyToolName: 'admin-tools__manage',
+    serverName: 'admin-tools',
+    downstreamToolName: 'manage_policy_state',
+    invocationAction: 'list',
+    actionName: 'execute',
+  });
+
+  assert.equal(request.resource.accessType, 'read');
+  assert.equal(request.action.writeIntent, false);
+  assert.equal(request.resource.metadata?.invocationAction, 'list');
+
+  const result = await evaluateAuthorizationRequest(
+    'policy.hub-route-authorization.v1',
+    request,
+    { mode: 'legacy_enforce', canaryPercent: 0 },
+    { mode: 'legacy' },
+  );
+
+  assert.equal(result.final.decision, 'allow');
+});
