+test('hub route classification ignores incidental description words', () => {
+  const classification = classifyHubRoute(
+    {
+      proxyToolName: 'example__list_documents',
+      serverName: 'example',
+      downstreamToolName: 'list_documents',
+    },
+    {
+      description: 'Lists documents and their state, including entries in trash.',
+    },
+  );
+
+  assert.equal(classification.accessType, 'read');
+});
+
+test('hub route classification uses the concrete multiplexed invocation action', () => {
+  const route = {
+    proxyToolName: 'example__manage_registry_state',
+    serverName: 'example',
+    downstreamToolName: 'manage_registry_state',
+  };
+
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'list' }).accessType, 'read');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'update_entry' }).accessType, 'write');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'delete_entry' }).accessType, 'destructive');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'authorize_oauth' }).accessType, 'auth_admin');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'set_rollout' }).accessType, 'control_plane');
+});
+
+test('hub authorization request retains and authorizes its invocation action', async () => {
+  const request = buildHubAuthorizationRequest({
+    accountId: 'acct_1',
+    sessionId: 'session_1',
+    toolMode: 'read_only',
+    identitySource: 'session',
+    proxyToolName: 'example__manage_registry_state',
+    serverName: 'example',
+    downstreamToolName: 'manage_registry_state',
+    actionName: 'execute',
+    invocationAction: 'list',
+  });
+
+  assert.equal(request.resource.accessType, 'read');
+  assert.equal(request.action.writeIntent, false);
+  assert.equal(request.resource.metadata.invocationAction, 'list');
+
+  const result = await evaluateAuthorizationRequest(
+    'policy.hub-route-authorization.v1',
+    request,
+    { mode: 'legacy_enforce', canaryPercent: 0 },
+    { mode: 'legacy' },
+  );
+
+  assert.equal(result.final.decision, 'allow');
+});
