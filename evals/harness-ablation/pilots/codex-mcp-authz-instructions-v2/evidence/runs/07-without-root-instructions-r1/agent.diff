+      invocationAction,
+      definition: { description: 'Manage connection state or move a connection to trash.' },
+    });
+
+    assert.equal(request.resource.accessType, accessType, invocationAction);
+    assert.equal(request.resource.metadata?.invocationAction, invocationAction);
+  }
+});
