+test('hub route classification ignores incidental description words', () => {
+  const classification = classifyHubRoute(
+    {
+      proxyToolName: 'stable__list_records',
+      serverName: 'stable',
+      downstreamToolName: 'list_records',
+    },
+    { description: 'Lists records and their state; never moves items to trash.' },
+  );
+
+  assert.equal(classification.accessType, 'read');
+});
+
+test('hub route classification uses an invocation action over a multiplexed route default', () => {
+  const classification = classifyHubRoute({
+    proxyToolName: 'admin__policy_management',
+    serverName: 'admin',
+    downstreamToolName: 'policy_management',
+    invocationAction: 'get_status',
+  });
+
+  assert.equal(classification.accessType, 'read');
+});
+
+test('hub route invocation actions classify each governed intent', () => {
+  const route = {
+    proxyToolName: 'admin__management',
+    serverName: 'admin',
+    downstreamToolName: 'management',
+  };
+
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'list_records' }).accessType, 'read');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'update_record' }).accessType, 'write');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'delete_record' }).accessType, 'destructive');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'create_connect_link' }).accessType, 'auth_admin');
+  assert.equal(classifyHubRoute({ ...route, invocationAction: 'update_rollout' }).accessType, 'control_plane');
+});
+
+test('hub authorization requests retain the invocation action used for classification', () => {
+  const request = buildHubAuthorizationRequest({
+    accountId: 'acct_1',
+    proxyToolName: 'admin__management',
+    serverName: 'admin',
+    downstreamToolName: 'management',
+    invocationAction: 'delete_record',
+    actionName: 'execute',
+  });
+
+  assert.equal(request.resource.accessType, 'destructive');
+  assert.equal(request.action.name, 'execute');
+  assert.equal(request.action.writeIntent, true);
+  assert.equal(request.resource.metadata?.invocationAction, 'delete_record');
+});
+
