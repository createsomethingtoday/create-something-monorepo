{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "claimedComplete",
    "validationCommands",
    "completionBoundary"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "claimedComplete": {
      "type": "boolean"
    },
    "validationCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completionBoundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
