{
  "name": "abundance-jobs-mcp-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../../scripts/run-wrangler.mjs dev",
    "deploy": "pnpm --filter @create-something/mcp-core build && pnpm --filter @create-something/abundance-jobs-mcp build && node ../../../scripts/run-wrangler.mjs deploy",
    "tail": "node ../../../scripts/run-wrangler.mjs tail",
    "typecheck": "pnpm --filter @create-something/mcp-core build && tsc --noEmit"
  },
  "dependencies": {
    "@create-something/abundance-jobs-mcp": "workspace:*",
    "@create-something/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "agents": "^0.3.10",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.103.0"
  }
}
