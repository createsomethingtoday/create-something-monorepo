{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CREATE SOMETHING support brief",
  "description": "User-supplied preparation context. Does not authorize execution or submit a support request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflow",
    "problem",
    "desiredOutcome",
    "tools",
    "owner",
    "constraints",
    "evidence",
    "unknowns"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "workflow": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S"
    },
    "problem": {
      "type": "string",
      "maxLength": 4000,
      "minLength": 1,
      "pattern": "\\S"
    },
    "desiredOutcome": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S"
    },
    "tools": {
      "type": "string",
      "maxLength": 1000
    },
    "owner": {
      "type": "string",
      "maxLength": 200
    },
    "constraints": {
      "type": "string",
      "maxLength": 2000
    },
    "evidence": {
      "type": "string",
      "maxLength": 4000
    },
    "unknowns": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
