{
  "name": "@create-something/outerfields",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "pnpm build && node ../../../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=outerfields-pcn --branch=main",
    "deploy:preview": "pnpm build && node ../../../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=outerfields-pcn --branch=preview",
    "migrate": "node ../../../../scripts/run-wrangler.mjs d1 migrations apply outerfields-db",
    "migrate:list": "node ../../../../scripts/run-wrangler.mjs d1 migrations list outerfields-db",
    "db:shell": "node ../../../../scripts/run-wrangler.mjs d1 execute outerfields-db --command",
    "types": "node ../../../../scripts/run-wrangler.mjs types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@sveltejs/adapter-cloudflare": "^6.0.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.16.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.56.9",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.103.0"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "better-sqlite3": "^12.6.2",
    "hls.js": "^1.6.15",
    "lucide-svelte": "^0.562.0",
    "pg": "^8.18.0",
    "resend": "^6.21.0",
    "stripe": "^20.1.2",
    "tus-js-client": "^4.3.1"
  }
}
