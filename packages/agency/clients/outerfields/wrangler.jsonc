{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "outerfields-pcn",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",

	// Set ANTHROPIC_API_KEY as a secret:
	// wrangler secret put ANTHROPIC_API_KEY --env production
	// The demo will use fallback responses if not configured.

	"vars": {
		"ENVIRONMENT": "production",
		"CLOUDFLARE_ACCOUNT_ID": "9645bd52e640b8a4f40a3a55ff1dd75a",
		"CLOUDFLARE_STREAM_CUSTOMER_CODE": "wi9kww2lo6qhi8n8",
		"CLOUDFLARE_STREAM_ALLOWED_ORIGINS": "outerfields.createsomething.agency,localhost:5173",
		"VIDEO_STREAM_TOKEN_TTL_SECONDS": "900",
		"VIDEO_ADMIN_EMAILS": "micah@createsomething.io,aaron@outerfields.co",
		"VIDEO_SERIES_ADMIN_EMAILS": "micah@createsomething.io"
	},

	// Configure secrets:
	// wrangler secret put CLOUDFLARE_STREAM_API_TOKEN
	// wrangler secret put CLOUDFLARE_STREAM_WEBHOOK_SECRET
	// wrangler secret put VIDEO_INGEST_API_TOKEN

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "outerfields-db",
			"database_id": "1841903d-9c2d-4b8b-809a-3aef68d2c8f0"
		}
	],

	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "973b18397c4d4b068313152a642f1ad5"
		},
		{
			"binding": "VIDEO_STATS",
			"id": "55a1177ee7c3491589c19094e38df0f7"
		}
	],

	"r2_buckets": [
		{
			"binding": "VIDEO_ASSETS",
			"bucket_name": "outerfields-videos"
		}
	],

	"ai": {
		"binding": "AI"
	}
}
