{
	"name": "@create-something/agency",
	"description": "Automation Design Firm — we apply the Subtractive Triad to design automation architectures that work",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"createSomething": {
		"agentLegibilityContract": true,
		"tier": "automation",
		"surface": "app",
		"entrypoints": [
			"src/routes/+page.svelte",
			"src/routes/services/+page.svelte",
			"content/sales/README.md"
		],
		"boot": "pnpm dev",
		"smoke": "pnpm check"
	},
	"scripts": {
		"dev": "node ./scripts/run-pinned-bin.mjs vite vite dev",
		"prepare:build-dir": "node ./scripts/prepare-build-dir.mjs",
		"prepare:local-deps": "node ./scripts/prepare-local-deps.mjs",
		"build": "pnpm prepare:build-dir && pnpm prepare:local-deps && node ./scripts/run-pinned-bin.mjs @sveltejs/kit svelte-kit sync && node ./scripts/run-pinned-bin.mjs vite vite build",
		"preview": "node ./scripts/run-pinned-bin.mjs vite vite preview",
		"prepare": "pnpm prepare:build-dir && pnpm prepare:local-deps && node ./scripts/run-pinned-bin.mjs @sveltejs/kit svelte-kit sync || echo ''",
		"copy:check": "node ./scripts/check-public-copy.mjs && node --import tsx --test test/public-marketing-copy.test.ts test/field-report-evidence.test.ts test/product-family-contract.test.ts",
		"copy:heal": "node ./scripts/check-public-copy.mjs --write",
		"marketing:check": "node --import tsx ./scripts/check-marketing-pages.mjs && node --import tsx --test test/marketing-pages.test.ts",
		"marketing:heal": "node --import tsx ./scripts/check-marketing-pages.mjs --write",
		"canon:check": "node ./scripts/check-canon-debt.mjs && node --import tsx --test test/canon-debt.test.ts",
    "check": "pnpm prepare:build-dir && pnpm prepare:local-deps && node ./scripts/run-pinned-bin.mjs @sveltejs/kit svelte-kit sync && node ./scripts/run-pinned-bin.mjs svelte-check svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && pnpm canon:check && pnpm copy:check && node --import tsx --test test/community-api-auth.test.ts test/identity-provider-retirement.test.ts",
		"seo:check": "node ./scripts/check-seo-aeo.mjs && pnpm marketing:check",
		"analytics:commercial-funnel": "node ./scripts/report-commercial-funnel.mjs",
		"research:clarity-capture": "node ./scripts/capture-zero-context-surface.mjs",
		"governance:slack-monitor": "node ./scripts/run-governance-slack-monitor.mjs",
		"governance:readiness": "node ./scripts/check-governance-production-readiness.mjs",
		"governance:sync-monitor-config": "node ./scripts/sync-governance-monitor-config.mjs",
		"map:synthetic": "playwright test --config playwright.map-synthetic.config.ts",
		"map:synthetic:evaluate": "node ./scripts/evaluate-map-synthetic-receipts.mjs",
		"check:watch": "pnpm prepare:build-dir && pnpm prepare:local-deps && node ./scripts/run-pinned-bin.mjs @sveltejs/kit svelte-kit sync && node ./scripts/run-pinned-bin.mjs svelte-check svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
		"test:abundance": "node --import tsx --test test/abundance-*.test.ts",
		"smoke:mobile": "pnpm --filter @create-something/canon package && pnpm --filter @create-something/tufte package && pnpm build && playwright test --config playwright.mobile-smoke.config.ts",
		"db:migrate": "node ../../scripts/run-wrangler.mjs d1 migrations apply create-something-db",
		"db:migrate:local": "node ../../scripts/run-wrangler.mjs d1 migrations apply create-something-db --local",
		"deploy": "pnpm build && CLOUDFLARE_ACCOUNT_ID=9645bd52e640b8a4f40a3a55ff1dd75a node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=create-something-agency --commit-dirty=true",
		"deploy:preview": "pnpm build && CLOUDFLARE_ACCOUNT_ID=9645bd52e640b8a4f40a3a55ff1dd75a node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=create-something-agency --branch=preview --commit-dirty=true",
		"cf-typegen": "node ../../scripts/run-wrangler.mjs types"
	},
	"dependencies": {
		"@composio/core": "^0.6.4",
		"@create-something/canvas-kernel": "workspace:*",
		"@create-something/canon": "workspace:*",
		"@create-something/delivery-schema": "workspace:*",
		"@create-something/mcp-authz": "workspace:*",
		"@create-something/tufte": "workspace:^",
		"lucide-svelte": "^0.562.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"stripe": "^18.5.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "4.20260621.1",
		"@playwright/test": "1.58.2",
		"@sveltejs/adapter-auto": "7.0.0",
		"@sveltejs/adapter-cloudflare": "7.2.4",
		"@sveltejs/kit": "2.47.1",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@types/node": "24.10.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"autoprefixer": "10.4.22",
		"highlight.js": "11.11.1",
		"marked": "17.0.0",
		"mdsvex": "0.12.6",
		"postcss": "8.5.6",
		"postcss-import": "16.1.1",
		"svelte": "5.41.0",
		"svelte-check": "4.3.3",
		"tailwindcss": "3.4.18",
		"typescript": "5.9.3",
		"vite": "7.1.10",
		"wrangler": "4.103.0"
	}
}
