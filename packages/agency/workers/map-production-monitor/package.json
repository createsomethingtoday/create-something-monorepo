{
  "name": "@create-something/map-production-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.*",
    "check": "tsc --noEmit",
    "deploy": "node ./scripts/deploy.mjs",
    "deploy:dry-run": "node ./scripts/deploy.mjs --dry-run",
    "db:migrate": "node ../../../../scripts/run-wrangler.mjs d1 migrations apply create-something-db --remote --config ../../wrangler.jsonc",
    "db:migrate:local": "node ../../../../scripts/run-wrangler.mjs d1 migrations apply create-something-db --local --config ../../wrangler.jsonc"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.103.0"
  }
}
