{
  "name": "@create-something/arc",
  "version": "0.1.0",
  "description": "AI-native, map-bound presentation and operating-story components for Arc, Playbook, and Runbook routes.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "package": "svelte-kit sync && svelte-package && publint",
    "prepare": "svelte-kit sync || echo ''",
    "check": "pnpm package && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/**/*.spec.*"],
  "sideEffects": ["**/*.css"],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "dependencies": {
    "@create-something/atlas-composition": "workspace:*",
    "@create-something/canon": "workspace:*"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "publint": "^0.3.14",
    "svelte": "^5.41.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
