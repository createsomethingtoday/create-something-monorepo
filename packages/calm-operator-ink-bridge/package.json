{
  "name": "@create-something/calm-operator-ink-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "deploy": "node ../../scripts/run-wrangler.mjs deploy",
    "dev": "node ../../scripts/run-wrangler.mjs dev",
    "agent:progress": "tsx scripts/post-agent-progress.mjs",
    "agent:relay": "tsx scripts/run-agent-relay.mjs",
    "agent:relay:once": "tsx scripts/run-agent-relay.mjs --once",
    "post:health": "tsx scripts/post-health-snapshot.mjs",
    "post:langfuse-quality": "tsx scripts/post-langfuse-quality-priority.mjs",
    "post:mcp": "tsx scripts/post-mcp-attention.mjs",
    "post:priority": "tsx scripts/post-operator-priority.mjs",
    "run:health-command": "tsx scripts/run-health-checked-command.mjs",
    "smoke:production": "tsx scripts/production-smoke.mjs",
    "tail": "node ../../scripts/run-wrangler.mjs tail",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@openai/codex": "0.147.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.103.0"
  }
}
