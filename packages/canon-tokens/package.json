{
  "name": "@createsomething/canon-tokens",
  "version": "0.1.0",
  "description": "Canon Design Tokens - Framework-agnostic CSS custom properties for dark-mode interfaces. Golden ratio spacing, WCAG-compliant colors, glass effects.",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "database",
    "surface": "library",
    "entrypoints": [
      "README.md",
      "tokens.css",
      "tokens.json"
    ],
    "boot": "pnpm check",
    "smoke": "pnpm check"
  },
  "scripts": {
    "check": "node -e \"const fs=require('node:fs'); for (const file of ['tokens.css','tokens.scss','tokens.json']) fs.accessSync(file); JSON.parse(fs.readFileSync('tokens.json','utf8'));\""
  },
  "author": "CREATE SOMETHING <hello@createsomething.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo",
    "directory": "packages/canon-tokens"
  },
  "homepage": "https://createsomething.io/docs",
  "bugs": {
    "url": "https://github.com/createsomethingtoday/create-something-monorepo/issues"
  },
  "keywords": [
    "css",
    "css-tokens",
    "css-variables",
    "custom-properties",
    "design-tokens",
    "design-system",
    "dark-mode",
    "dark-theme",
    "golden-ratio",
    "wcag",
    "accessibility",
    "a11y",
    "glass",
    "glassmorphism",
    "typography",
    "spacing",
    "colors",
    "dieter-rams",
    "minimalism",
    "react",
    "vue",
    "svelte",
    "angular",
    "tailwind",
    "framework-agnostic"
  ],
  "main": "tokens.css",
  "style": "tokens.css",
  "exports": {
    ".": "./tokens.css",
    "./tokens.css": "./tokens.css",
    "./tokens.scss": "./tokens.scss",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "tokens.css",
    "tokens.scss",
    "tokens.json",
    "README.md"
  ]
}
