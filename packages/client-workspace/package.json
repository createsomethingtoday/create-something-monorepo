{
  "name": "@create-something/client-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Governed client workspace for multimodal, real-time frontend editing.",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "judgment",
    "surface": "app",
    "entrypoints": [
      "src/routes/+page.svelte",
      "src/lib/server/workspaces/registry.ts",
      "src/lib/server/sessions/workspace-session.ts"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm test && pnpm check && pnpm build"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "cloudflare:types": "wrangler types --config cloudflare/wrangler.jsonc",
    "cloudflare:check": "tsc --noEmit -p cloudflare/tsconfig.json",
    "cloudflare:dry-run": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc --outdir output/cloudflare-dry-run",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm exec tsx --test test/*.test.ts",
    "smoke:codex": "pnpm exec tsx scripts/codex-multimodal-smoke.ts",
    "smoke:preview": "pnpm exec tsx scripts/preview-smoke.ts",
    "demo:reset": "pnpm exec tsx scripts/reset-demo-fixture.ts",
    "smoke": "pnpm test && pnpm check && pnpm build"
  },
  "dependencies": {
    "@create-something/delivery-schema": "workspace:*",
    "svelte": "5.48.5"
  },
  "devDependencies": {
    "@cloudflare/sandbox": "0.12.3",
    "@cloudflare/workers-types": "^4.20260621.1",
    "@create-something/canon": "workspace:*",
    "@sveltejs/adapter-auto": "7.0.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.50.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "svelte-check": "4.3.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.1.10",
    "wrangler": "4.103.0"
  }
}
