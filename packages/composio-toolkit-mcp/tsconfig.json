{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["index.ts", "gsc-analysis.ts", "tool-policy.ts", "tool-routing.ts", "test/**/*.ts"]
}
