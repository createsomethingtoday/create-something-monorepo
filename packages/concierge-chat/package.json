{
  "name": "@create-something/concierge-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted AI-native concierge chat product for progressive profiling and governed tool orchestration.",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "judgment",
    "surface": "app",
    "entrypoints": [
      "src/routes/+page.svelte",
      "src/lib/demo/concierge.ts"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm check"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch"
  },
  "dependencies": {
    "svelte": "^5.41.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
