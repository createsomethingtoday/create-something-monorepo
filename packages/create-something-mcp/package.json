{
  "name": "@create-something/mcp",
  "version": "1.0.0",
  "description": "The CREATE SOMETHING Content MCP — a single entry point to all philosophy, research, design system, and practices across properties",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "database",
    "surface": "mcp",
    "entrypoints": [
      "src/index.ts",
      "worker/index.ts"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm typecheck && pnpm build"
  },
  "main": "dist/index.js",
  "bin": {
    "create-something-mcp": "dist/index.js"
  },
  "scripts": {
    "build:content": "tsx scripts/build-content.ts",
    "build:workspace-deps": "pnpm --filter @create-something/playbook-mcp build && pnpm --filter @create-something/flue-service-agent build:lib",
    "build": "pnpm run build:workspace-deps && npm run build:content && tsc",
    "dev": "tsc --watch",
    "flue:history:promote": "pnpm run build:workspace-deps && tsc && node scripts/promote-flue-run-history.mjs --remote",
    "flue:history:upload": "pnpm run build:workspace-deps && tsc && node scripts/upload-flue-run-history-to-d1.mjs --remote",
    "lint": "pnpm run typecheck",
    "smoke:flue-ingestion": "pnpm run build:workspace-deps && tsc && node scripts/smoke-flue-run-history-ingestion.mjs",
    "smoke:flue-promotion": "pnpm run build:workspace-deps && tsc && node scripts/promote-flue-run-history.mjs --dry-run",
    "smoke:flue-resources": "pnpm run build:workspace-deps && tsc && node scripts/smoke-flue-run-history-resources.mjs",
    "smoke:flue-remote-resources": "pnpm run build:workspace-deps && tsc && node scripts/smoke-remote-flue-run-history-resources.mjs",
    "start": "node dist/index.js",
    "typecheck": "pnpm run build:workspace-deps && tsc --noEmit"
  },
  "dependencies": {
    "@create-something/flue-service-agent": "workspace:*",
    "@create-something/playbook-mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "create-something",
    "content",
    "philosophy",
    "research",
    "design-system",
    "canon",
    "three-tier-framework",
    "model-context-protocol"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/create-something-mcp"
  }
}
