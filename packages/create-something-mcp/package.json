{
  "name": "@create-something/mcp",
  "version": "1.0.0",
  "description": "The CREATE SOMETHING Content MCP — a single entry point to all philosophy, research, design system, and practices across properties",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "database",
    "surface": "mcp",
    "entrypoints": [
      "src/index.ts",
      "worker/index.ts"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm typecheck && pnpm build"
  },
  "main": "dist/index.js",
  "bin": {
    "create-something-mcp": "dist/index.js"
  },
  "scripts": {
    "build:deps": "pnpm --filter @create-something/playbook-mcp build",
    "build:content": "tsx scripts/build-content.ts",
    "build": "pnpm run build:deps && npm run build:content && tsc",
    "dev": "tsc --watch",
    "lint": "pnpm run typecheck",
    "start": "node dist/index.js",
    "test": "pnpm run test:overlay-preview && pnpm run test:overlay-catalog && pnpm run test:overlay-template-file-resources && pnpm run test:overlay-template-file-tool && pnpm run test:overlay-intake && pnpm run test:overlay-candidates && pnpm run test:overlay-candidate-reviews && pnpm run test:overlay-candidate-promotion-plans && pnpm run test:overlay-candidate-promotion-readiness && pnpm run test:overlay-candidate-promotion-approval-records && pnpm run test:overlay-candidate-handoff-tool && pnpm run test:overlay-candidate-promotion-plan-tool && pnpm run test:overlay-candidate-promotion-readiness-tool && pnpm run test:overlay-candidate-promotion-approval-record-tool && pnpm run test:overlay-candidate-promotion-approval-target-template-resources && pnpm run test:overlay-candidate-promotion-approval-validation-resources && pnpm run test:overlay-candidate-promotion-approval-validation-report-tool && pnpm run test:canon-export-policy && pnpm run test:canon-registry-tool-renderers && pnpm run test:canon-design-audit-tool",
    "test:overlay-preview": "tsx scripts/check-canon-overlay-preview-parity.ts",
    "test:overlay-catalog": "tsx scripts/check-canon-overlay-catalog-parity.ts",
    "test:overlay-template-file-resources": "pnpm --filter @create-something/playbook-mcp build && tsx scripts/check-canon-overlay-template-file-resources.ts",
    "test:overlay-template-file-tool": "pnpm --filter @create-something/playbook-mcp build && tsx scripts/check-canon-overlay-template-file-tool.ts",
    "test:overlay-intake": "tsx scripts/check-canon-overlay-intake-inventory-parity.ts",
    "test:overlay-candidates": "tsx scripts/check-canon-overlay-candidate-queue-parity.ts",
    "test:overlay-candidate-reviews": "tsx scripts/check-canon-overlay-candidate-review-packets-parity.ts",
    "test:overlay-candidate-promotion-plans": "tsx scripts/check-canon-overlay-candidate-promotion-plans-parity.ts",
    "test:overlay-candidate-promotion-readiness": "tsx scripts/check-canon-overlay-candidate-promotion-readiness-reports-parity.ts",
    "test:overlay-candidate-promotion-approval-records": "tsx scripts/check-canon-overlay-candidate-promotion-approval-records-parity.ts",
    "test:overlay-candidate-handoff-tool": "tsx scripts/check-canon-overlay-candidate-handoff-tool.ts",
    "test:overlay-candidate-promotion-plan-tool": "tsx scripts/check-canon-overlay-candidate-promotion-plan-tool.ts",
    "test:overlay-candidate-promotion-readiness-tool": "tsx scripts/check-canon-overlay-candidate-promotion-readiness-tool.ts",
    "test:overlay-candidate-promotion-approval-record-tool": "tsx scripts/check-canon-overlay-candidate-promotion-approval-record-tool.ts",
    "test:overlay-candidate-promotion-approval-target-template-resources": "pnpm --filter @create-something/playbook-mcp build && tsx scripts/check-canon-overlay-candidate-promotion-approval-target-template-resources.ts",
    "test:overlay-candidate-promotion-approval-validation-resources": "pnpm --filter @create-something/playbook-mcp build && tsx scripts/check-canon-overlay-candidate-promotion-approval-validation-resources.ts",
    "test:overlay-candidate-promotion-approval-validation-report-tool": "pnpm --filter @create-something/playbook-mcp build && tsx scripts/check-canon-overlay-candidate-promotion-approval-validation-report-tool.ts",
    "test:canon-export-policy": "tsx scripts/check-canon-public-export-classification-parity.ts",
    "test:canon-registry-tool-renderers": "pnpm --filter @create-something/canon package && tsx scripts/check-canon-registry-tool-renderers.ts",
    "test:canon-design-audit-tool": "pnpm --filter @create-something/playbook-mcp build && pnpm --filter @create-something/canon package && tsx scripts/check-canon-design-audit-tool.ts",
    "test:smoke": "pnpm run test:overlay-preview",
    "typecheck": "pnpm run build:deps && tsc --noEmit"
  },
  "dependencies": {
    "@create-something/canon": "workspace:*",
    "@create-something/playbook-mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "create-something",
    "content",
    "philosophy",
    "research",
    "design-system",
    "canon",
    "three-tier-framework",
    "model-context-protocol"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/create-something-mcp"
  }
}
