GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3857/callback"

# Optional: enforce the authenticated Gmail account
GMAIL_ALLOWED_EMAIL="micah@createsomething.io"

# Optional: override token location (default: ~/.config/create-something/createsomething-gmail-mcp/tokens.json)
# GMAIL_TOKEN_PATH="/absolute/path/to/tokens.json"

# Optional: override OAuth scopes (comma-separated). If you change scopes, re-run auth.
# Default scopes: gmail.readonly, gmail.labels, gmail.send, gmail.modify
# GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.labels"
