{
  "name": "@create-something/createsomething-gmail-mcp",
  "version": "0.1.0",
  "description": "Local MCP server (Streamable HTTP + stdio) for CREATE SOMETHING Gmail access in Codex (search/read/send).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "createsomething-gmail-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "TRANSPORT=http PORT=3850 node dist/index.js",
    "start:stdio": "TRANSPORT=stdio node dist/index.js",
    "auth": "npx tsx src/index.ts auth",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "open": "^10.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "gmail",
    "mcp",
    "codex",
    "create-something"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT"
}
