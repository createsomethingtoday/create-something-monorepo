{
  "name": "@create-something/creator-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Creator storefront authoring service (serialized per-Creator writer) and public read API for the Webflow template marketplace",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test",
    "dev": "node ../../scripts/run-wrangler.mjs dev --config wrangler.toml",
    "build": "node ../../scripts/run-wrangler.mjs deploy --dry-run --outdir dist --config wrangler.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@create-something/webflow-dashboard-core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^24.10.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.103.0"
  }
}
