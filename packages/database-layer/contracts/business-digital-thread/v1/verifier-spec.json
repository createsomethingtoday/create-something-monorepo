  "requiredScenarios": [
    {
      "id": "historical-no-future-leakage",
      "pass": "A validAt/knownAt view excludes revisions and evidence recorded after knownAt, including a later revocation and later verification result."
    },
    {
      "id": "bidirectional-intent-to-lesson",
      "pass": "The complete required path resolves in both directions with no orphan requirement or unverified approved baseline member."
    },
    {
      "id": "change-impact-before-approval",
      "pass": "An interface or baseline change remains approval_required until every required impact output is present and unresolvedApprovalIds is empty."
    },
    {
      "id": "authority-negative-matrix",
      "pass": "Expired, revoked, wrong-tenant, subject-mismatch, capability-mismatch, and scope-mismatch cases deny with stable codes and exact considered revisions."
    },
    {
      "id": "replace-without-history-loss",
      "pass": "Person, vendor, agent model, and domain tool replacements preserve predecessor identity, rationale, historical authority, current authority, and trace paths."
    },
    {
      "id": "clean-import-semantic-parity",
      "pass": "Export into an empty store, re-export, and compare every semanticComparisonField without source-store access."
    },
    {
      "id": "legacy-v0-migration",
      "pass": "A flow.business-digital-thread.v0 fixture migrates deterministically, records counts and every loss disposition, and emits a migration receipt."
    },
    {
      "id": "retention-and-hold",
      "pass": "Retain, archive, redact, delete, tombstone, and preserve-derived-proof are distinguished; an active hold blocks conflicting deletion; preserved proof contains no raw content."
    },
    {
      "id": "lesson-application",
      "pass": "One lesson progresses through collected, recorded, reviewed, disseminated, applied, and effectiveness_reviewed revisions and traces to a later governed artifact change."
    },
    {
      "id": "projection-parity",
      "pass": "API, MCP, agent, and Atlas return the same canonical IDs, as-of parameters, semantic digest, missing-proof state, and authority denial code."
    },
    {
      "id": "dogfood-authoritative-inputs",
      "pass": "The CREATE SOMETHING artifact uses authoritative or mixed inputMode and lists content-hashed repo-owned inputs; a deterministic_fixture-only artifact cannot pass."
    }
  ],
