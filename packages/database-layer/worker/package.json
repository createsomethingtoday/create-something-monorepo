{
  "name": "@create-something/database-layer-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @create-something/database-layer build && node ../scripts/generate-worker-state.mjs",
    "dev": "pnpm build && node ../../../scripts/run-wrangler.mjs dev",
    "deploy": "pnpm build && node ../../../scripts/run-wrangler.mjs deploy",
    "smoke": "pnpm build && node smoke.mjs"
  },
  "dependencies": {
    "@create-something/database-layer": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "wrangler": "^4.103.0"
  }
}
