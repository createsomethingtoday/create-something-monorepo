{
  "version": 1,
  "canvas": {
    "width": 400,
    "height": 240,
    "background": "#ffffff"
  },
  "metadata": {
    "title": "Unrelated collision fixture",
    "description": "One declared overlap must not suppress an unrelated collision."
  },
  "elements": [
    {
      "id": "host-card",
      "type": "rect",
      "x": 20,
      "y": 20,
      "width": 220,
      "height": 160,
      "fill": "#ffffff",
      "stroke": "#0a0e19",
      "contains": ["host-label"]
    },
    {
      "id": "host-label",
      "type": "text",
      "x": 50,
      "y": 60,
      "width": 140,
      "height": 40,
      "lines": ["Governed route"],
      "fontSize": 16,
      "fill": "#0a0e19"
    },
    {
      "id": "status-badge",
      "type": "rect",
      "x": 200,
      "y": 8,
      "width": 60,
      "height": 40,
      "radius": 8,
      "fill": "#1e3c2c",
      "allowOverlapWith": ["host-card"]
    },
    {
      "id": "rogue-card",
      "type": "rect",
      "x": 170,
      "y": 110,
      "width": 100,
      "height": 80,
      "fill": "#c41e3a"
    }
  ]
}
