  },
  "dependencies": {
    "@typescript-eslint/utils": "8.58.2"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.54.0",
    "@types/node": "^24.10.1",
    "eslint": "9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
