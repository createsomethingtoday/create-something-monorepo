{
  "name": "@create-something/eslint-plugin-evidence",
  "version": "0.1.0",
  "description": "ESLint rules for CREATE SOMETHING code-evidence policy.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
