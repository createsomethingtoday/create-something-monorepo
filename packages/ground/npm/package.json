{
  "name": "@createsomething/ground-mcp",
  "version": "0.3.6",
  "description": "Evidence-first code analysis for agents in TypeScript, JavaScript, and Svelte codebases.",
  "author": "CREATE SOMETHING <hello@createsomething.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo",
    "directory": "packages/ground"
  },
  "homepage": "https://github.com/createsomethingtoday/create-something-monorepo/tree/main/packages/ground",
  "bugs": {
    "url": "https://github.com/createsomethingtoday/create-something-monorepo/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "ai-coding",
    "ai-agent",
    "code-analysis",
    "static-analysis",
    "duplicate-detection",
    "dead-code",
    "dead-code-detection",
    "orphan-detection",
    "code-quality",
    "hallucination-prevention",
    "grounding",
    "verification",
    "llm",
    "llm-tools",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "copilot",
    "codex",
    "anthropic",
    "openai",
    "rust",
    "typescript",
    "javascript",
    "monorepo",
    "design-tokens",
    "css-analysis"
  ],
  "bin": {
    "ground": "bin/ground.js",
    "ground-mcp": "bin/ground-mcp.js"
  },
  "scripts": {
    "postinstall": "node install.js",
    "prepublishOnly": "node release-verify.js",
    "pilot:build": "cargo build --release --manifest-path ../Cargo.toml --bin ground --bin ground-mcp",
    "pilot:benchmark": "tsx pilot/benchmark.ts",
    "pilot:check": "tsc --noEmit -p pilot/tsconfig.json",
    "pilot:receipt:validate": "tsx pilot/validate-receipt.ts",
    "pilot:test": "pnpm run pilot:build && tsx --test pilot/*.test.ts",
    "pilot:verify": "pnpm run pilot:check && pnpm run pilot:test && pnpm run pilot:benchmark && pnpm run pilot:receipt:validate -- pilot/evidence/ground-native-benchmark-receipt.v1.json"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/node": "^24.10.9",
    "ajv": "^8.17.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "bin",
    "install.js",
    "README.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
