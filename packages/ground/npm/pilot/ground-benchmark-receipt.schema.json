{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://createsomething.agency/schemas/ground-native-benchmark-receipt.v1.json",
  "title": "Ground native MCP benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentType",
    "schemaVersion",
    "generatedAt",
    "source",
    "configuration",
    "nativeMcp",
    "typescriptBaseline",
    "comparison"
  ],
  "properties": {
    "documentType": {
      "const": "create-something.ground-native-benchmark-receipt"
    },
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha", "gitDirty", "platform", "arch", "nodeVersion"],
      "properties": {
        "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "gitDirty": { "type": "boolean" },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "targetDirectory",
        "checks",
        "samples",
        "warmupSamples",
        "timeoutMs"
      ],
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "targetDirectory": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["duplicates", "dead_exports", "orphans", "environment"]
          }
        },
        "samples": { "type": "integer", "minimum": 1 },
        "warmupSamples": { "type": "integer", "minimum": 0 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "nativeMcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "tool", "protocolPassed", "binary", "samples", "summary"],
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "tool": { "const": "ground_analyze" },
        "protocolPassed": { "type": "boolean" },
        "binary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "bytes", "sha256", "standalone"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "standalone": { "type": "boolean" }
          }
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/nativeSample" }
        },
        "summary": { "$ref": "#/definitions/summary" }
      }
    },
    "typescriptBaseline": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "artifact", "samples", "summary"],
          "properties": {
            "mode": { "const": "existing-ground-duplicates-script" },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "bytes", "standalone", "runtime"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "bytes": { "type": "integer", "minimum": 1 },
                "standalone": { "const": false },
                "runtime": { "const": "node+tsx+workspace-dependencies" }
              }
            },
            "samples": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/baselineSample" }
            },
            "summary": { "$ref": "#/definitions/summary" }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "claims", "adoptionDecision", "rationale"],
      "properties": {
        "scope": { "const": "directional-only" },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "adoptionDecision": {
          "enum": ["adopt-native-kernel-behind-mcp", "retain-typescript-path", "inconclusive"]
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "nativeSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "status",
        "connectMs",
        "discoveryMs",
        "analysisMs",
        "totalMs",
        "peakRssBytes",
        "semanticFingerprint",
        "error"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["passed", "failed"] },
        "connectMs": { "type": ["number", "null"], "minimum": 0 },
        "discoveryMs": { "type": ["number", "null"], "minimum": 0 },
        "analysisMs": { "type": ["number", "null"], "minimum": 0 },
        "totalMs": { "type": "number", "minimum": 0 },
        "peakRssBytes": { "type": ["integer", "null"], "minimum": 0 },
        "semanticFingerprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "baselineSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "status",
        "exitCode",
        "totalMs",
        "peakRssBytes",
        "semanticFingerprint",
        "error"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["passed", "failed"] },
        "exitCode": { "type": ["integer", "null"] },
        "totalMs": { "type": "number", "minimum": 0 },
        "peakRssBytes": { "type": ["integer", "null"], "minimum": 0 },
        "semanticFingerprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "passed",
        "failed",
        "resultConsistent",
        "fingerprints",
        "latencyMs",
        "peakRssBytes"
      ],
      "properties": {
        "attempted": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "resultConsistent": { "type": "boolean" },
        "fingerprints": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "latencyMs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "median", "p95", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "median": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        },
        "peakRssBytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
