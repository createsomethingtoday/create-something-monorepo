{
  "name": "@create-something/half-dozen-youtube-sync",
  "version": "2.0.0",
  "description": "YouTube playlist transcript extraction and Notion sync for Half Dozen client",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hd-youtube-sync": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:connection": "npx tsx test-connection.ts",
    "capture:session": "npx tsx capture-session.ts",
    "sync": "npx tsx batch-sync.ts --sync",
    "sync:playlist": "npx tsx batch-sync.ts --sync --playlist"
  },
  "dependencies": {
    "@create-something/mcp-core": "workspace:*",
    "@create-something/observability": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.4.5",
    "puppeteer-core": "^23.0.0",
    "resend": "^4.0.0",
    "steel-sdk": "^0.16.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "mcp",
    "youtube",
    "playlist",
    "transcript",
    "notion",
    "browser-automation",
    "steel",
    "half-dozen"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/half-dozen-youtube-sync"
  }
}
