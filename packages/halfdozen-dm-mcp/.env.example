# Half Dozen DM MCP — Notion + DM-namespaced Composio proxy
MCP_API_KEY=
NOTION_API_KEY=
COMPOSIO_API_KEY=
# Inject real values per environment; use auth config IDs from Composio.
COMPOSIO_AUTH_CONFIG_MAP={"googledrive":"ac_xxx","zoom":"ac_yyy","slack":"ac_zzz","quickbooks":"ac_abc","dropbox":"ac_xY-40ToAQEPy"}

ENABLED_TOOLSETS=notion,composio
COMPOSIO_ENTITY_ID=dm
COMPOSIO_PROXY_MODE=allowlist
COMPOSIO_ALLOWED_TOOLKITS=googledrive,zoom,slack,quickbooks,dropbox
COMPOSIO_ALLOWED_TOOLKITS_BY_ENTITY={"dm":"googledrive,zoom,slack,quickbooks,dropbox","*":"slack"}
COMPOSIO_TOOL_NAME_PREFIX=dm_composio
COMPOSIO_TOOL_CACHE_SECONDS=300
