# ═══════════════════════════════════════════════════════════════
# GMAIL (OAuth - Web Application)
# ═══════════════════════════════════════════════════════════════

# Google Cloud OAuth credentials (from client_secret JSON)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=http://localhost:3847/callback

# ═══════════════════════════════════════════════════════════════
# NOTION (Internal Integration)
# ═══════════════════════════════════════════════════════════════

# Notion API Key (https://notion.so/my-integrations)
NOTION_API_KEY=ntn_xxx

# Half Dozen Database IDs
NOTION_INTERACTIONS_DB_ID=xxx
NOTION_CONTACTS_DB_ID=xxx

# ═══════════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════════

# Team emails (comma-separated, used for inbound/outbound detection)
TEAM_EMAILS=you@example.com,colleague@example.com

# Email alerts (optional)
RESEND_API_KEY=re_xxx
