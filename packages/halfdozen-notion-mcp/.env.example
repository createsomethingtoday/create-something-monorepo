# Notion Half Dozen X CREATE SOMETHING — two workspaces
# Half Dozen internal (Meeting Capture, transcripts)
NOTION_API_KEY=
# Client workspace (the client's Notion database Half Dozen does work for)
NOTION_CLIENT_API_KEY=
# Optional bearer auth for /mcp and /sse
MCP_API_KEY=

# --- Agency Ops sync scripts (optional) ---
#
# These are NOT the Notion API keys above. This is the bearer token used to call
# the deployed Notion MCP endpoint (Streamable HTTP) when running the sync scripts.
NOTION_SYNC_BEARER_TOKEN=
NOTION_URL=https://createsomething-notion.mcp.createsomething.agency/mcp

# Substrate MCP bearer token (admin/editor). For local runs, SUBSTRATE_TOKEN can
# also be read from ~/.config/create-something/substrate/substrate_admin.token.
SUBSTRATE_ADMIN_TOKEN=
SUBSTRATE_URL=https://substrate.mcp.createsomething.agency/mcp

# Needed only if the Notion "Agents" database does not exist and the script
# cannot infer the correct parent page from existing ops databases.
NOTION_AGENCY_OPS_PARENT_PAGE_ID=

# Set for a no-write preview run
DRY_RUN=0
