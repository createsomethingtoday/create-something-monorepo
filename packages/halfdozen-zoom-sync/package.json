{
  "name": "@create-something/halfdozen-zoom-sync",
  "version": "2.0.0",
  "description": "Zoom Clips to Notion MCP Server for Half Dozen. Three-Tier: Resources (clips), Tools (sync/extract), Prompts (analysis). Deployed as Cloudflare Worker with Steel.dev browser automation.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hd-zoom-sync": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "watch-session": "npx tsx watch-session.ts",
    "test:notion": "npx tsx scripts/test-notion.ts",
    "fetch-session-context": "npx tsx scripts/fetch-session-context.ts",
    "create-clips-profile": "npx tsx scripts/create-clips-profile.ts"
  },
  "dependencies": {
    "@create-something/composio-bridge": "workspace:*",
    "@create-something/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "puppeteer-core": "^24.0.0",
    "steel-sdk": "^0.15.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "zoom",
    "clips",
    "notion",
    "sync",
    "steel",
    "browser-automation",
    "half-dozen",
    "model-context-protocol"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/halfdozen-zoom-sync"
  }
}
