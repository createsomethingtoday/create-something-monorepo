{
  "name": "@create-something/harness",
  "version": "0.1.0",
  "description": "Autonomous agent harness for Linear-tracked work. Runs agent sessions in loops with checkpoints, review passes, and reactive redirection.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "harness": "./bin/harness.js",
    "gt-smart-sling": "./bin/gt-smart-sling.js",
    "gt-prime": "./bin/gt-prime.js",
    "gt-status": "./bin/gt-status.js",
    "gt-rig": "./bin/gt-rig.js",
    "gt-completion": "./bin/gt-completion.js",
    "routing-report": "./bin/routing-report.js",
    "ralph-escalate": "./bin/ralph-escalate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "harness": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "automation",
    "surface": "harness",
    "entrypoints": [
      "src/index.ts",
      "src/runner.ts"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm test"
  },
  "keywords": [
    "harness",
    "agents",
    "automation",
    "codex",
    "linear"
  ],
  "license": "MIT",
  "dependencies": {
    "@create-something/canon": "workspace:^",
    "ajv": "^8.17.1",
    "yaml": "^2.8.2"
  }
}
