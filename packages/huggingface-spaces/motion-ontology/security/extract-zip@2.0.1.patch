+// Defense in depth for the two symlink advisories. The caller must own the
+// destination exclusively; these checks do not sandbox concurrent host writers.
+function isInsideDirectory (dir, target) {
+  const relative = path.relative(dir, target)
+  return !path.isAbsolute(relative) && !relative.split(path.sep).includes('..')
+}
+
+async function validatePath (dir, target) {
+  if (!isInsideDirectory(dir, target)) throw new Error(`Out of bound path "${target}"`)
+  let current = dir
+  for (const component of path.relative(dir, target).split(path.sep).filter(Boolean)) {
+    current = path.join(current, component)
+    let stat
+    try {
+      stat = await fs.lstat(current)
+    } catch (err) {
+      if (err.code === 'ENOENT') return // Remaining components do not exist yet.
+      throw err
+    }
+    if (stat.isSymbolicLink()) {
+      // realpath must succeed: dangling parents must fail BEFORE recursive mkdir.
+      const canonical = await fs.realpath(current)
+      if (!isInsideDirectory(dir, canonical)) throw new Error(`Out of bound path "${current}"`)
+    }
+  }
+}
+
+async function validateLinkTarget (dir, parent, link) {
+  if (path.isAbsolute(link)) throw new Error(`Out of bound symlink target "${link}"`)
+  let current = parent
+  // Do not normalize away alias/.. before resolving alias: OS symlink traversal
+  // interprets .. against the linked directory, not its lexical spelling.
+  for (const component of link.split(path.sep)) {
+    if (!component || component === '.') continue
+    current = component === '..' ? path.dirname(current) : path.join(current, component)
+    if (!isInsideDirectory(dir, current)) throw new Error(`Out of bound symlink target "${link}"`)
+    let stat
+    try {
+      stat = await fs.lstat(current)
+    } catch (err) {
+      if (err.code !== 'ENOENT') throw err
+      continue
+    }
+    if (stat.isSymbolicLink()) current = await fs.realpath(current)
+    if (!isInsideDirectory(dir, current)) throw new Error(`Out of bound symlink target "${link}"`)
+  }
+}
 
