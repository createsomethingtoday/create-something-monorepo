{
  "name": "@create-something/identity-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deploy": "pnpm --filter @create-something/auth-platform build",
    "dev": "node ../../scripts/run-wrangler.mjs dev",
    "deploy": "pnpm run build:deploy && node ../../scripts/run-wrangler.mjs deploy",
    "types": "node ../../scripts/run-wrangler.mjs types",
    "test": "pnpm --filter @create-something/mcp-authz build && pnpm --filter @create-something/auth-platform build && node --import tsx --test test/*.test.ts",
    "db:create": "node ../../scripts/run-wrangler.mjs d1 create identity-db",
    "db:migrate": "node ../../scripts/run-wrangler.mjs d1 migrations apply identity-db",
    "db:migrate:local": "node ../../scripts/run-wrangler.mjs d1 migrations apply identity-db --local"
  },
  "dependencies": {
    "@create-something/auth-platform": "workspace:*",
    "@create-something/mcp-authz": "workspace:*",
    "@create-something/policy-os-engine": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.103.0"
  }
}
