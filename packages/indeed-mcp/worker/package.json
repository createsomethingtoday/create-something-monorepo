{
  "name": "indeed-mcp-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter=@create-something/mcp-core build && pnpm --filter=@create-something/indeed-mcp build",
    "predeploy": "pnpm --filter=@create-something/mcp-core build && pnpm --filter=@create-something/indeed-mcp build",
    "dev": "node ../../../scripts/run-wrangler.mjs dev",
    "deploy": "node ../../../scripts/run-wrangler.mjs deploy",
    "tail": "node ../../../scripts/run-wrangler.mjs tail"
  },
  "dependencies": {
    "@create-something/indeed-mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.0.0"
  }
}

