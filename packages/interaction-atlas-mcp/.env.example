# Interaction Atlas MCP Server — Environment Variables
#
# Credentials (don't rotate — safe in env vars):
# CLIENT_ID=your-client-id
# CLIENT_SECRET=your-client-secret
#
# Tokens are managed by the TokenStore (file/KV/D1) — NOT env vars.
# Run `pnpm auth` for first-time OAuth setup.
#
# For API key auth, set:
# API_KEY=your-api-key

# Optional multi-account map (Worker env binding or process.env):
# API_KEYS="key1:account-a,key2:account-b"

# Reactive MCP tool-access kill switch:
# MCP_TOOL_ACCESS_MODE=normal   # normal | read_only | off

# Reactive abuse guard (auto kill-switch by blocked-pattern detection):
# ABUSE_GUARD_ENABLED=true
# ABUSE_WINDOW_SECONDS=300
# ABUSE_BLOCK_THRESHOLD=8
# ABUSE_DISTINCT_TOOLS_THRESHOLD=2
# ABUSE_RESPONSE_MODE=auto_off   # auto_off | review
