{
  "name": "@create-something/interaction-atlas-mcp",
  "version": "0.1.0",
  "description": "AI-native workflow mapping and visualization using AI Interaction Atlas",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "interaction-atlas-mcp": "dist/index.js",
    "cs-atlas-studio": "dist/studio/cli.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @create-something/atlas-composition build && pnpm --filter @create-something/canvas-kernel build && pnpm --filter @create-something/mcp-authz build && pnpm --filter @create-something/mcp-core build && pnpm --filter @create-something/observability build && pnpm --filter @create-something/playbook-mcp build && pnpm --filter @create-something/policy-os-engine build && pnpm --filter @create-something/workflow-compiler build",
    "build": "tsc && node dist/studio/build-client.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "studio": "pnpm build && node dist/studio/cli.js",
    "auth": "node dist/orchestration/oauth-setup.js",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@create-something/atlas-composition": "workspace:*",
    "@create-something/canvas-kernel": "workspace:*",
    "@create-something/mcp-authz": "workspace:*",
    "@create-something/mcp-core": "workspace:*",
    "@create-something/observability": "workspace:*",
    "@create-something/playbook-mcp": "workspace:*",
    "@create-something/policy-os-engine": "workspace:*",
    "@create-something/workflow-compiler": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@quietloudlab/ai-interaction-atlas": "^1.0.7",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "interaction-atlas-mcp"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT"
}
