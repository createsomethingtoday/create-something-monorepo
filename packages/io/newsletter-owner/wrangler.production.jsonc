{
  "name": "cs-newsletter-owner-production",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "9645bd52e640b8a4f40a3a55ff1dd75a",
  "alias": {
    "@create-something/canon/newsletter/subscribe": "../../canon/src/lib/newsletter/subscribe.ts",
    "@create-something/canon/newsletter/attribution": "../../canon/src/lib/newsletter/attribution.ts",
    "@create-something/canon/newsletter/audience": "../../canon/src/lib/newsletter/audience.ts"
  },
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "create-something-db",
      "database_id": "a74e70ae-6a94-43da-905e-b90719c8dfd2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "bcb39a6258fe49b79da9dc9b09440934"
    }
  ],
  "vars": {
    "NEWSLETTER_MODE": "production",
    "NEWSLETTER_LINK_ORIGIN": "https://createsomething.io"
  }
}
