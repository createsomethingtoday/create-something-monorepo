{
	"name": "@create-something/io",
	"description": "MCP Patterns for Builders — research, reference implementations, and documentation",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"createSomething": {
		"agentLegibilityContract": true,
		"tier": "judgment",
		"surface": "app",
		"entrypoints": [
			"src/routes/+page.svelte",
			"src/routes/papers/+page.svelte",
			"src/lib/config/plugins.ts"
		],
		"boot": "pnpm dev",
		"smoke": "pnpm check"
	},
	"scripts": {
		"prebuild": "pnpm --filter @create-something/canon package && pnpm --filter @create-something/tufte package",
		"dev": "vite dev",
		"build": "pnpm check:papers && pnpm lint && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check:papers": "node scripts/check-paper-catalog.mjs",
		"check": "pnpm check:papers && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
		"lint": "eslint .",
		"deploy": "pnpm build && CLOUDFLARE_ACCOUNT_ID=9645bd52e640b8a4f40a3a55ff1dd75a node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=create-something-io --commit-dirty=true",
		"deploy:preview": "pnpm build && CLOUDFLARE_ACCOUNT_ID=9645bd52e640b8a4f40a3a55ff1dd75a node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=create-something-io --branch=preview --commit-dirty=true",
		"cf-typegen": "node ../../scripts/run-wrangler.mjs types"
	},
	"dependencies": {
		"@create-something/canon": "workspace:*",
		"@create-something/render-pipeline": "workspace:*",
		"@create-something/spritz": "workspace:*",
		"@create-something/tufte": "workspace:*",
		"@types/canvas-confetti": "^1.9.0",
		"canvas-confetti": "^1.9.4",
		"cytoscape": "^3.33.1",
		"cytoscape-cose-bilkent": "^4.1.0",
		"html2canvas": "^1.4.1",
		"lucide-svelte": "^0.554.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251128.0",
		"@create-something/eslint-plugin-canon": "workspace:*",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/cytoscape": "^3.31.0",
		"@types/node": "^24.10.1",
		"@webgpu/types": "^0.1.69",
		"autoprefixer": "^10.4.22",
		"eslint": "^9.17.0",
		"highlight.js": "^11.11.1",
		"marked": "^17.0.0",
		"mdsvex": "^0.12.6",
		"postcss": "^8.5.6",
		"postcss-import": "^16.1.1",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"svelte-eslint-parser": "^0.43.0",
		"tailwindcss": "^3.4.18",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"wrangler": "^4.64.0"
	}
}
