{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "create-something-io",
	"compatibility_date": "2025-11-15",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "create-something-db",
			"database_id": "a74e70ae-6a94-43da-905e-b90719c8dfd2"
		},
		{
			"binding": "LMS_DB",
			"database_name": "lms-db",
			"database_id": "2ec4ea2e-c25f-4832-b78f-a608ff9f8ad7"
		},
		{
			"binding": "TELEMETRY_DB",
			"database_name": "cs-telemetry",
			"database_id": "f710641a-0c85-4a7b-bb73-2c16f8d024c3"
		}
	],

	"services": [
		{
			"binding": "SCHEDULER_REPORTS",
			"service": "create-something-scheduler",
			"entrypoint": "AudienceReports"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "973b18397c4d4b068313152a642f1ad5"
		},
		{
			"binding": "CACHE",
			"id": "bcb39a6258fe49b79da9dc9b09440934"
		}
	],

	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "create-something-assets"
		}
	],

	"ai": {
		"binding": "AI"
	},

	"vars": {
		"ENVIRONMENT": "production",
		"TERMINAL_VERSION": "2.0.0",
		"DEFAULT_THEME": "dark"
	}
}
