{
  "name": "@create-something/lms",
  "version": "0.1.0",
  "private": true,
  "description": "CREATE SOMETHING Learning Management System. Teaching the ethos through practice.",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "judgment",
    "surface": "app",
    "entrypoints": [
      "src/routes/+page.svelte",
      "src/routes/paths/+page.svelte",
      "src/routes/progress/+page.svelte"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm check"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm foundation:index && vite build",
    "preview": "vite preview",
    "check": "pnpm foundation:test && pnpm workshop:test && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
    "deploy": "pnpm build && node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=createsomething-lms --branch=main",
    "deploy:preview": "pnpm build && node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=createsomething-lms --branch=preview",
    "foundation:index": "tsx scripts/build-foundation-index.ts",
    "foundation:test": "tsx scripts/build-foundation-index.ts --check && tsx --test tests/foundation.test.ts",
    "foundation:smoke": "tsx scripts/foundation-smoke.ts",
    "workshop:test": "tsx --test tests/workshop/*.test.ts"
  },
  "dependencies": {
    "@create-something/canon": "workspace:*",
    "@create-something/spritz": "workspace:*",
    "@create-something/tufte": "workspace:^",
    "@modelcontextprotocol/sdk": "1.26.0",
    "lucide-svelte": "^0.554.0",
    "marked": "^15.0.4",
    "mermaid": "11",
    "three": "^0.170.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "svelte": "^5.56.9",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wrangler": "^4.110.0"
  }
}
