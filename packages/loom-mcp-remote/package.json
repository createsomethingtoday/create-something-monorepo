{
  "name": "@create-something/loom-mcp-remote",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Remote Loom MCP server for Hub HTTP transport",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test",
    "dev": "node ../../scripts/run-wrangler.mjs dev",
    "deploy": "node ../../scripts/run-wrangler.mjs deploy",
    "lint": "pnpm run typecheck",
    "test": "vitest run",
