    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^24.10.9",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.103.0"
  }
}
