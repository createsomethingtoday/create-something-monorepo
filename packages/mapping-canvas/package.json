{
  "name": "@create-something/mapping-canvas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://draw.createsomething.agency/",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/mapping-canvas"
  },
  "description": "Local-first free-form canvas for CREATE SOMETHING mapping meetings.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:native": "DRAW_NATIVE_BUILD=1 vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:download": "node scripts/verify-download.mjs",
    "verify:native-ui": "node scripts/verify-native-ui.mjs",
    "deploy": "pnpm build && CLOUDFLARE_ACCOUNT_ID=9645bd52e640b8a4f40a3a55ff1dd75a node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=create-something-mapping-canvas --branch=main --commit-dirty=true"
  },
  "dependencies": { "@create-something/canon": "workspace:*" },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.10.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.0.16",
    "wrangler": "^4.103.0"
  }
}
