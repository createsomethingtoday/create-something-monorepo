{
  "name": "@create-something/mcp-authz",
  "version": "0.1.0",
  "description": "Shared broker and identity authorization contracts, manifests, and telemetry for CREATE SOMETHING MCP surfaces.",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "judgment",
    "surface": "library",
    "entrypoints": [
      "src/index.ts",
      "src/evaluate.ts",
      "src/policies.ts"
    ],
    "boot": "pnpm build",
    "smoke": "pnpm check && pnpm test"
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepare": "pnpm build",
    "test": "pnpm --filter @create-something/policy-os-engine build && pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@create-something/policy-os-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT"
}
