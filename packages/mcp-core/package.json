{
  "name": "@create-something/mcp-core",
  "version": "0.1.0",
  "description": "Multi-account MCP abstractions — AccountContext, AuthProvider, InsightEmitter. The primitive is always relative.",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "automation",
    "surface": "library",
    "entrypoints": [
      "src/index.ts",
      "src/server.ts",
      "src/context.ts"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm typecheck && pnpm build"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oauth-discovery": {
      "types": "./dist/oauth-discovery.d.ts",
      "default": "./dist/oauth-discovery.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "default": "./dist/providers/*.js"
    },
    "./stores/*": {
      "types": "./dist/stores/*.d.ts",
      "default": "./dist/stores/*.js"
    },
    "./insight/*": {
      "types": "./dist/insight/*.d.ts",
      "default": "./dist/insight/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "braintrust": "^2.2.2",
    "langfuse": "^3.38.6",
    "zod": "^3.25.34"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "multi-account",
    "three-tier-framework",
    "account-context",
    "auth-provider",
    "model-context-protocol"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/mcp-core"
  }
}
