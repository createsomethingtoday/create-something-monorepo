{
  "name": "@create-something/motion-studio",
  "version": "0.1.0",
  "description": "Vox-style motion graphics generation using Canon components and Remotion",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "automation",
    "surface": "library",
    "entrypoints": [
      "src/index.ts",
      "src/scene/index.ts",
      "src/scene/cli.ts"
    ],
    "boot": "pnpm build:scene",
    "smoke": "pnpm check:scene && pnpm test:scene"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "motion-scene": "dist/scene/cli.js"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "tsc && remotion bundle",
    "build:scene": "tsc -p tsconfig.scene.json",
    "render": "remotion render",
    "render:still": "remotion still",
    "render:signal-decision-proof": "remotion render SignalDecisionProof ../agency/content/assets/brand/create-something-stop-motion-signal-proof.v20260719/exports/signal-decision-proof--v8--deterministic--20s--16x9--v20260719.mp4 --codec=h264 --crf=15 --audio-codec=aac",
    "render:fluid-signal-stills": "blender --background --python-exit-code 1 --python scripts/render-fluid-signal-scene.py -- --out-blend ../agency/content/assets/brand/create-something-stop-motion-signal-proof.v20260719/source/fluid-signal-scene--v10.blend --stills-dir ../agency/content/assets/brand/create-something-stop-motion-signal-proof.v20260719/receipts/fluid-stills--v10",
    "render:fluid-signal-video": "blender --background --python-exit-code 1 --python scripts/render-fluid-signal-scene.py -- --out-blend ../agency/content/assets/brand/create-something-stop-motion-signal-proof.v20260719/source/fluid-signal-scene--v10.blend --video-out ../agency/content/assets/brand/create-something-stop-motion-signal-proof.v20260719/exports/signal-decision-proof--v10--fluid-physical--20s--16x9--v20260719.mp4 --audio public/signal-decision-proof/narration.m4a",
    "assemble:sora-signal-proof": "python3 scripts/assemble-sora-signal-proof.py",
    "verify:fluid-signal-scene": "blender --background ../agency/content/assets/brand/create-something-stop-motion-signal-proof.v20260719/source/fluid-signal-scene--v10.blend --python-exit-code 1 --python scripts/verify-fluid-signal-scene.py -- --receipt ../agency/content/assets/brand/create-something-stop-motion-signal-proof.v20260719/receipts/fluid-scene-verification--v10.json",
    "sora:single-shot": "python3 scripts/sora-single-shot.py",
    "preview": "remotion preview",
    "lint": "pnpm run validate",
    "validate": "pnpm run typecheck && pnpm run validate:motion-studio",
    "validate:motion-studio": "npx tsx scripts/validate-motion-studio.ts",
    "typecheck": "tsc --noEmit",
    "check:scene": "tsc -p tsconfig.scene.json --noEmit",
    "test:scene": "pnpm build:scene && node --test test/*.test.mjs",
    "generate-voiceover": "npx ts-node scripts/generate-voiceover.ts",
    "generate-sounds": "npx tsx scripts/generate-sounds.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.410",
    "@remotion/google-fonts": "4.0.410",
    "@remotion/player": "4.0.410",
    "lucide-react": "^0.460.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "4.0.410",
    "tone": "^15.0.4",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@create-something/canon": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./compositions": {
      "types": "./dist/compositions/index.d.ts",
      "import": "./dist/compositions/index.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles/index.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "import": "./dist/scene/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "remotion",
    "motion-graphics",
    "vox-style",
    "explainer",
    "canon"
  ],
  "license": "MIT"
}
