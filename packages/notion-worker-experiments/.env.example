# Local-only token for `ntn workers exec --local`.
# Pull this from a local secret manager or shell session.
NOTION_API_TOKEN=

# Linear read-model sync. Store the real token with a secret manager or
# `ntn workers env set LINEAR_API_KEY="$LINEAR_API_KEY"`; do not commit it.
LINEAR_API_KEY=
LINEAR_TEAM_KEY=CRE
# LINEAR_API_URL=https://api.linear.app/graphql
# LINEAR_SYNC_PAGE_SIZE=100

