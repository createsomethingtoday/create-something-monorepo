# Local-only token for `ntn workers exec --local`.
# Pull this from a local secret manager or shell session.
NOTION_API_TOKEN=

# Linear read-model sync. Store the real token with a secret manager or
# `ntn workers env set LINEAR_API_KEY="$LINEAR_API_KEY"`; do not commit it.
LINEAR_API_KEY=
LINEAR_TEAM_KEY=CRE
# LINEAR_API_URL=https://api.linear.app/graphql
# LINEAR_SYNC_PAGE_SIZE=100

# Agency Ops live reconciliation. Defaults are the CREATE SOMETHING PM database
# IDs; override only when running against another workspace or test database.
# NOTION_AGENCY_OPS_TASKS_DATABASE_ID=b8adfc95-d7df-4543-8062-6e4adafb5bfb
# NOTION_AGENCY_OPS_DELIVERABLES_DATABASE_ID=edce1303-8c32-4995-ade9-05c45494ad82
# NOTION_AGENCY_OPS_ENGAGEMENTS_DATABASE_ID=6300d744-49d8-41c8-bbbd-cb78d7bfaab5

# Optional write metadata for --write-suggestions.
# NOTION_AGENCY_OPS_OWNER_USER_ID=
# NOTION_AGENCY_OPS_WORKSTREAM_ID=

# Optional Notion CLI knobs.
# NOTION_API_VERSION=2026-03-11
# NOTION_WORKSPACE_ID=
