{
  "name": "@create-something/observability",
  "version": "1.0.0",
  "description": "Agent observability utilities with Langfuse integration and AI Interaction Atlas vocabulary",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "database",
    "surface": "library",
    "entrypoints": [
      "src/index.ts",
      "src/mcp.ts",
      "src/atlas.ts"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm typecheck && pnpm build"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atlas": {
      "types": "./dist/atlas.d.ts",
      "import": "./dist/atlas.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./langfuse": {
      "types": "./dist/langfuse.d.ts",
      "import": "./dist/langfuse.js"
    },
    "./openai-agents": {
      "types": "./dist/openai-agents.d.ts",
      "import": "./dist/openai-agents.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "observability",
    "tracing",
    "langfuse",
    "mcp",
    "ai-interaction-atlas"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/observability"
  },
  "dependencies": {
    "langfuse": "^3.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
