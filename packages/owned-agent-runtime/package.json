{
  "name": "@create-something/owned-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "dev": "node ../../scripts/run-wrangler.mjs dev --config wrangler.jsonc",
    "deploy": "node ../../scripts/run-wrangler.mjs deploy --config wrangler.jsonc",
    "tail": "node ../../scripts/run-wrangler.mjs tail --config wrangler.jsonc"
  },
  "dependencies": {
    "@openai/agents": "^0.4.10",
    "hono": "^4.11.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.103.0"
  }
}
