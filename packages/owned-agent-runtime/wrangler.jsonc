{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "create-something-agent-runtime",
  "account_id": "9645bd52e640b8a4f40a3a55ff1dd75a",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "AGENT_RUNTIME_DB",
      "database_name": "create-something-agent-runtime",
      "database_id": "1ea45279-a1d4-4c5d-93b1-b72c2f5bdd3e",
      "migrations_dir": "migrations"
    },
    {
      // Agency D1 owns customer_control_activations via migration 0039.
      "binding": "CONTROL_DB",
      "database_name": "create-something-db",
      "database_id": "a74e70ae-6a94-43da-905e-b90719c8dfd2"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_AGENT_CLIENT_RATE_LIMITER",
      "namespace_id": "123301",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_AGENT_BUDGET_RATE_LIMITER",
      "namespace_id": "123302",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "CONTROL_TENANT_RATE_LIMITER",
      "namespace_id": "123303",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "CONTROL_BUDGET_RATE_LIMITER",
      "namespace_id": "123304",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "services": [
    { "binding": "CREATE_SOMETHING_MCP", "service": "create-something-mcp" },
    { "binding": "THREE_TIER_FRAMEWORK_MCP", "service": "three-tier-framework-mcp" },
    { "binding": "PLAYBOOK_MCP", "service": "playbook-mcp" }
  ],
  "observability": { "enabled": true }
}
