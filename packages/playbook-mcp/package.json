{
  "name": "@create-something/playbook-mcp",
  "version": "1.3.0",
  "description": "Host workflow playbooks for MCP onboarding — teaches non-technical users how to work effectively in Codex, Cursor, and Claude Desktop",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./playbooks": "./dist/playbooks.js",
    "./catalog": "./dist/catalog.js",
    "./distribution": "./dist/distribution.js",
    "./goose-export": "./dist/goose-export.js"
  },
  "bin": {
    "playbook-mcp": "dist/index.js",
    "playbook-goose-export": "dist/goose-export.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "goose:export": "pnpm run build && node dist/goose-export.js",
    "lint": "pnpm run typecheck",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "playbook",
    "workflow",
    "onboarding",
    "codex",
    "cursor",
    "claude-desktop",
    "model-context-protocol"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/playbook-mcp"
  }
}
