{
  "name": "@create-something/playbook-mcp",
  "version": "1.3.0",
  "description": "Host workflow playbooks for MCP onboarding — teaches non-technical users how to work effectively in Codex, Cursor, and Claude Desktop",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./playbooks": {
      "types": "./dist/playbooks.d.ts",
      "import": "./dist/playbooks.js",
      "default": "./dist/playbooks.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./arcs": {
      "types": "./dist/arcs.d.ts",
      "import": "./dist/arcs.js",
      "default": "./dist/arcs.js"
    },
    "./operator-playbooks": {
      "types": "./dist/operator-playbooks.d.ts",
      "import": "./dist/operator-playbooks.js",
      "default": "./dist/operator-playbooks.js"
    }
  },
  "bin": {
    "playbook-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "pnpm run typecheck",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@create-something/atlas-composition": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "playbook",
    "workflow",
    "onboarding",
    "codex",
    "cursor",
    "claude-desktop",
    "model-context-protocol"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/playbook-mcp"
  }
}
