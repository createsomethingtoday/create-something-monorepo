{
  "name": "@create-something/policy-os-engine",
  "version": "0.1.0",
  "description": "Shared POLICY OS policy compiler and hybrid evaluator (Oso Cloud + local fallback).",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "judgment",
    "surface": "library",
    "entrypoints": [
      "src/index.ts",
      "src/compile.ts",
      "src/hybrid.ts"
    ],
    "boot": "pnpm build",
    "smoke": "pnpm check && pnpm test"
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./oso-primary": {
      "types": "./src/oso-primary.ts",
      "import": "./dist/oso-primary.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepare": "pnpm build",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "oso-cloud": "^2.5.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT"
}
