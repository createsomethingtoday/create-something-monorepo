# QuickBooks OAuth (required)
QBO_CLIENT_ID=your_client_id_from_intuit_developer
QBO_CLIENT_SECRET=your_client_secret_from_intuit_developer
QBO_ENVIRONMENT=sandbox

# QuickBooks OAuth (optional)
QBO_REDIRECT_URI=http://localhost:3847/callback
QBO_TOKEN_PATH=.qbo-tokens.json
QBO_ENCRYPTION_KEY=your-secure-encryption-key-min-32-chars

# Notion (required)
NOTION_API_KEY=your_notion_integration_token

# Server (optional)
TRANSPORT=stdio
PORT=3000
