{
  "name": "@create-something/relay",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Run Moltbot personal AI assistant in a Cloudflare Sandbox",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run build && node ../../scripts/run-wrangler.mjs deploy",
    "dev": "vite dev",
    "start": "node ../../scripts/run-wrangler.mjs dev",
    "types": "node ../../scripts/run-wrangler.mjs types",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.5",
    "hono": "^4.12.34",
    "jose": "^6.0.0",
    "lucide-react": "^0.563.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/sandbox": "*",
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.103.0"
  },
  "author": "",
  "license": "MIT",
  "cloudflare": {
    "bindings": {
      "ANTHROPIC_API_KEY": {
        "description": "Your [Anthropic API key](https://console.anthropic.com/)."
      },
      "MOLTBOT_GATEWAY_TOKEN": {
        "description": "Token for gateway access. Generate with: openssl rand -hex 32"
      }
    }
  }
}
