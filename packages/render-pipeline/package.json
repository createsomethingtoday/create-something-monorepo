{
  "name": "@create-something/render-pipeline",
  "version": "0.1.0",
  "description": "Deterministic local SVG and GLB rendering pipeline with provenance and receipts",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "docs": "tsx src/bin/generate-docs.ts",
    "generate-sections": "tsx scripts/generate-sections.ts",
    "generate:threshold-massing-glb": "tsx scripts/generate-threshold-dwelling-massing-glb.ts",
    "render-lab": "node web-render/server.mjs",
    "test:web-render": "tsx --test test/web-render-contract.test.ts",
    "test:threshold-massing-glb": "tsx --test test/threshold-dwelling-massing-glb.test.ts"
  },
  "dependencies": {
    "@create-something/canon": "workspace:^",
    "@gltf-transform/cli": "^4.0.0",
    "@gltf-transform/core": "^4.0.0",
    "@gltf-transform/extensions": "^4.0.0",
    "@gltf-transform/functions": "^4.0.0",
    "@resvg/resvg-js": "^2.6.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "archiver": "^7.0.0",
    "jsdom": "^25.0.0",
    "sharp": "^0.35.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/jsdom": "^21.0.0",
    "@types/node": "^20.0.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "svg",
    "render",
    "gltf",
    "webgl",
    "architecture",
    "visualization"
  ],
  "author": "CREATE SOMETHING",
  "license": "MIT"
}
