{
  "name": "@create-something/scanner-worker",
  "version": "0.1.0",
  "description": "Cloudflare Worker for Bundle Scanner P3-memory + P4-judge phases",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-wrangler.mjs dev",
    "deploy": "node ../../scripts/run-wrangler.mjs deploy",
    "types": "node ../../scripts/run-wrangler.mjs types",
    "db:create": "node ../../scripts/run-wrangler.mjs d1 create scanner-findings-db",
    "db:migrate": "node ../../scripts/run-wrangler.mjs d1 migrations apply scanner-findings-db",
    "db:migrate:local": "node ../../scripts/run-wrangler.mjs d1 migrations apply scanner-findings-db --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.103.0"
  }
}
