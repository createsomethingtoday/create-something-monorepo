{
  "name": "@create-something/scanner-worker",
  "version": "0.1.0",
  "description": "Cloudflare Worker for Bundle Scanner P3-memory + P4-judge phases",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:create": "wrangler d1 create scanner-findings-db",
    "db:migrate": "wrangler d1 migrations apply scanner-findings-db",
    "db:migrate:local": "wrangler d1 migrations apply scanner-findings-db --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.59.0"
  }
}
