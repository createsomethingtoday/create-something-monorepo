{
  "name": "@create-something/search",
  "version": "0.1.0",
  "description": "Unified search across CREATE SOMETHING properties - the full story, at your fingertips",
  "private": true,
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "database",
    "surface": "worker",
    "entrypoints": [
      "src/index.ts",
      "wrangler.toml"
    ],
    "boot": "pnpm dev",
    "smoke": "curl http://localhost:8787/health"
  },
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-wrangler.mjs dev",
    "deploy": "node ../../scripts/run-wrangler.mjs deploy",
    "tail": "node ../../scripts/run-wrangler.mjs tail",
    "types": "node ../../scripts/run-wrangler.mjs types",
    "index": "tsx src/cli/index-content.ts",
    "index:incremental": "tsx src/cli/index-content.ts --incremental"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.103.0"
  }
}
