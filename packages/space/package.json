{
	"name": "@create-something/space",
	"description": "The Workbench — live tools for building, testing, and analyzing automation infrastructure",
	"private": true,
	"version": "1.0.0",
	"createSomething": {
		"agentLegibilityContract": true,
		"tier": "automation",
		"surface": "app",
		"entrypoints": [
			"src/routes",
			"src/lib"
		],
		"boot": "pnpm dev",
		"smoke": "pnpm check && pnpm build"
	},
	"type": "module",
	"scripts": {
		"prebuild": "pnpm --filter @create-something/canon package && pnpm --filter @create-something/tufte package",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test:search": "vitest run src/lib/search/sitemap.test.ts",
		"test:workway": "tsx --test src/lib/workway/threshold-dwelling-spatial-package.test.ts src/lib/workway/threshold-dwelling-massing.test.ts src/lib/workway/threshold-dwelling-material-study.test.ts",
		"generate:threshold-spatial-fixture": "tsx scripts/generate-threshold-dwelling-spatial-fixture.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && pnpm test:search && pnpm test:workway",
		"test:nba": "tsx --test src/lib/nba/scoreboard-state.test.ts src/lib/nba/api.test.ts workers/nba-proxy/src/scoreboard.test.ts workers/nba-proxy/src/archive.test.ts workers/nba-proxy/src/index.test.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
		"deploy": "pnpm build && CLOUDFLARE_ACCOUNT_ID=9645bd52e640b8a4f40a3a55ff1dd75a node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=create-something-space --commit-dirty=true",
		"deploy:preview": "pnpm build && CLOUDFLARE_ACCOUNT_ID=9645bd52e640b8a4f40a3a55ff1dd75a node ../../scripts/run-wrangler.mjs pages deploy .svelte-kit/cloudflare --project-name=create-something-space --branch=preview --commit-dirty=true",
		"cf-typegen": "node ../../scripts/run-wrangler.mjs types",
		"migrate:papers": "tsx scripts/migrate-papers.ts",
		"migrate:papers:prod": "MIGRATION_URL=https://createsomething.space/api/migrate/sync-papers tsx scripts/migrate-papers.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260621.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/d3-force": "^3.0.10",
		"@types/d3-selection": "^3.0.11",
		"@types/node": "^24.10.1",
		"@types/three": "^0.170.0",
		"autoprefixer": "^10.4.22",
		"highlight.js": "^11.11.1",
		"marked": "^17.0.0",
		"postcss": "^8.5.6",
		"postcss-import": "^16.1.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^3.4.18",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.5.0",
		"vitest": "^4.0.16",
		"wrangler": "^4.103.0"
	},
	"dependencies": {
		"@cloudflare/sandbox": "^0.4.18",
		"@codemirror/autocomplete": "^6.19.1",
		"@codemirror/commands": "^6.10.0",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/language": "^6.11.3",
		"@codemirror/state": "^6.5.2",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.38.7",
		"@create-something/canon": "workspace:*",
		"@create-something/tufte": "workspace:*",
		"@resvg/resvg-wasm": "^2.6.2",
		"codemirror": "^6.0.2",
		"d3-force": "^3.0.0",
		"d3-selection": "^3.0.0",
		"lucide-svelte": "^0.562.0",
		"three": "^0.170.0"
	}
}
