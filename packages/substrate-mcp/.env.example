# Cloudflare D1 — structured data storage
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
CF_D1_DATABASE_ID=your-d1-database-id

# Cloudflare R2 — file storage (S3-compatible access)
# Generate at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=substrate-files
