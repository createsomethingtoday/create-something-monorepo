{
  "name": "@create-something/substrate-mcp",
  "version": "0.1.0",
  "description": "Substrate — the agent-native data layer. Replaces Notion with MCP-managed workspaces where teams interact through agents, not UI.",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "database",
    "surface": "mcp",
    "entrypoints": [
      "src/index.ts"
    ],
    "boot": "pnpm dev",
    "smoke": "pnpm typecheck && pnpm build"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "substrate-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@create-something/mcp-core": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "substrate",
    "agent-native",
    "three-tier-framework",
    "cloudflare-d1",
    "notion-alternative"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/substrate-mcp"
  }
}
