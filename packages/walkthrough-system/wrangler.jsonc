{
  "name": "create-something-walkthroughs",
  "account_id": "9645bd52e640b8a4f40a3a55ff1dd75a",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/screen.mp4",
      "/walkthrough.mp4",
      "/screen-mobile.mp4",
      "/walkthrough-mobile.mp4"
    ]
  },
  "main": "worker.mjs",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
