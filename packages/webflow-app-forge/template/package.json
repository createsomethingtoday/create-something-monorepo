    "@webflow/designer-extension-typings": "^2.2.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.21.0",
    "eslint-plugin-promise": "^7.2.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
