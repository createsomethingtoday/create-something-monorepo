{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webflow-app-review-preflight",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:1337,http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webflow-app-review-preflight",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "webflow-app-review-preflight-artifacts"
    }
  ]
}
