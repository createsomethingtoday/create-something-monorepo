{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webflow-app-review-preflight",
  "account_id": "9645bd52e640b8a4f40a3a55ff1dd75a",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "chrome-extension://eiogakldgljpbbmplgckjkoglfgabblm,https://6a57b0fa70db1b7a0cd666ac.webflow-ext.com",
    "E2B_RUNTIME_TEMPLATE_ID": "app-review-companion-runtime:a96a06d0-74cc-4f48-b1aa-9189777303ab",
    "WEBFLOW_OAUTH_REDIRECT_URI": "https://webflow-app-review-preflight.createsomething.workers.dev/v1/oauth/webflow/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webflow-app-review-preflight",
      "database_id": "2f81cae5-8232-4509-92a7-9485f5dcf401",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "webflow-app-review-preflight-artifacts"
    }
  ]
}
