{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webflow-app-review-runtime-dispatcher",
  "account_id": "9645bd52e640b8a4f40a3a55ff1dd75a",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "vars": {
    "PREFLIGHT_API_BASE_URL": "https://webflow-app-review-preflight.createsomething.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
