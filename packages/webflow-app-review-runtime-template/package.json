{
  "name": "@create-something/webflow-app-review-runtime-template",
  "version": "0.1.0",
  "description": "Immutable E2B Playwright template for Webflow App Review runtime observations",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:context",
    "build:context": "node scripts/build-context.mjs",
    "build:e2b": "pnpm run build:context && node scripts/build-template.mjs",
    "check": "tsc --noEmit",
    "lint": "pnpm run check",
    "test": "vitest run"
  },
  "dependencies": {
    "e2b": "2.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
