<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SOURCE</key>
		<string>airtable</string>
	</dict>
	<key>Label</key>
	<string>com.webflow.marketplace-popularity-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/micahjohnson/Code/create-something-monorepo-wt-popularity-sync/packages/webflow-automation/marketplace-popularity-sync/run.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
