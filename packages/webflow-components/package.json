{
  "name": "@create-something/webflow-components",
  "version": "0.1.0",
  "description": "Canon-first React code components library for Webflow",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "bundle": "npx webflow library bundle --public-path / --no-input",
    "share": "npx webflow library share",
    "check": "pnpm run typecheck",
    "lint": "pnpm run typecheck",
    "smoke:routes": "node scripts/smoke-template-routes.mjs",
    "test:detail": "node --import tsx --test test/TemplateDetailHero.test.tsx",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run bundle"
  },
  "dependencies": {
    "@webflow/react": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@webflow/webflow-cli": "^1.0.0",
    "@webflow/data-types": "^1.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
