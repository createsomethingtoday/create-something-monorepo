{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webflow-dashboard",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",

	// D1 Database for analytics history
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "webflow-dashboard-db",
			"database_id": "da2ac945-5340-42ce-91eb-451aeaad5742"
		}
	],

	// KV Namespaces
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "552d6f66fdf84e8aad55306e6971068e"
		}
	],

	// R2 Buckets
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "webflow-dashboard-uploads"
		}
	],

	// Environment variables (secrets set via wrangler secret put)
	"vars": {
		"ENVIRONMENT": "production",
		// First-party template view beacon (packages/webflow-template-views, Webflow Hosting account).
		"TEMPLATE_VIEWS_STATS_URL": "https://webflow-template-views.webflow-inc.workers.dev"
	}

	// Cron triggers: NOT available here. This is a Pages project, and scheduled
	// handlers are a Workers-only feature — a Pages project has no Triggers tab.
	// /api/cron/* must be driven by an external scheduler:
	//   - /api/cron/snapshot -> .github/workflows/webflow-dashboard-snapshot-cron.yml
	//   - /api/cron/cleanup  -> currently unscheduled
	// Callers authenticate with `Authorization: Bearer $CRON_SECRET`.

	// Secrets (set via: wrangler secret put <SECRET_NAME>)
	// - AIRTABLE_API_KEY
	// - AIRTABLE_BASE_ID
	// - CRON_SECRET (required in production for /api/cron/* auth)
	// - TEMPLATE_VIEWS_STATS_API_KEY (beacon /stats bearer key; Infisical prod WEBFLOW_TEMPLATE_VIEWS_STATS_API_KEY)
	// Optional vars/secrets:
	// - ADMIN_EMAILS (comma-separated allowlist for admin-only API reads)
	// - CSRF_TRUSTED_ORIGINS (comma-separated extra trusted origins for cookie-authenticated API mutations)
	// - KNOCK_API_KEY (production Knock secret key; enables Knock delivery of login codes)
	// - KNOCK_LOGIN_ENABLED ("true" to send login codes via Knock instead of the Airtable Gmail automation)
	// - KNOCK_LOGIN_WORKFLOW_KEY (defaults to asset-dashboard-login-validation)
}
