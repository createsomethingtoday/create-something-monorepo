{
  "name": "@create-something/webflow-docs-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that indexes developers.webflow.com and returns exact doc passages (keyword + vector search)",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test",
    "dev": "node ../../scripts/run-wrangler.mjs dev --config wrangler.toml",
    "deploy": "node ../../scripts/run-wrangler.mjs deploy --config wrangler.toml",
    "deploy:dry-run": "node ../../scripts/run-wrangler.mjs deploy --config wrangler.toml --dry-run",
    "eval:docs-site": "node eval/run-docs-site.mjs",
    "eval:embed-proxy": "node ../../scripts/run-wrangler.mjs dev --config eval/wrangler.embed.toml --port 8791",
    "eval:local": "esbuild eval/run-local.ts --bundle --platform=node --format=esm --outfile=.eval/run-local.mjs --log-level=warning && node --no-warnings .eval/run-local.mjs",
    "lint": "pnpm run typecheck",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^24.10.9",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.103.0"
  }
}
