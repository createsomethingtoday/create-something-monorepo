{
  "name": "@create-something/webflow-metadata-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker for previewing and applying Webflow page metadata updates",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test",
    "dev": "node ../../scripts/run-wrangler.mjs dev --config wrangler.toml",
    "deploy": "node ../../scripts/run-wrangler.mjs deploy --config wrangler.toml",
    "lint": "pnpm run typecheck",
    "tail": "node ../../scripts/run-wrangler.mjs tail --config wrangler.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260205.0",
    "@types/node": "^24.10.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.64.0"
  }
}
