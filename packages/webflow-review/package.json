{
  "name": "@create-something/webflow-review",
  "version": "1.0.0",
  "private": true,
  "description": "Comprehensive template review system for Webflow - built entirely on Cloudflare",
  "scripts": {
    "dev:orchestrator": "pnpm --filter=@create-something/webflow-review-orchestrator dev",
    "dev:queue": "pnpm --filter=@create-something/webflow-review-queue-consumer dev",
    "deploy:orchestrator": "pnpm --filter=@create-something/webflow-review-orchestrator deploy",
    "deploy:queue": "pnpm --filter=@create-something/webflow-review-queue-consumer deploy",
    "deploy:all": "pnpm deploy:orchestrator && pnpm deploy:queue",
    "db:migrate": "node ../../scripts/run-wrangler.mjs d1 migrations apply webflow-review-db",
    "db:migrate:local": "node ../../scripts/run-wrangler.mjs d1 migrations apply webflow-review-db --local",
    "db:query": "node ../../scripts/run-wrangler.mjs d1 execute webflow-review-db --command",
    "setup": "node scripts/setup.js"
  },
  "keywords": [
    "webflow",
    "template",
    "review",
    "seo",
    "accessibility",
    "cloudflare",
    "workers",
    "chrome-extension"
  ]
}
