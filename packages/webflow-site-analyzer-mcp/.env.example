# Cloudflare Browser Run (primary managed-browser platform)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_BROWSER_RUN_API_TOKEN=your-browser-rendering-edit-token
BROWSER_RUN_ENABLED=true

# Steel (temporary rollback + parity baseline during burn-in)
STEEL_API_KEY=steel_xxx

# Optional: Streamable HTTP runtime for hosted deployments
# WEBFLOW_SITE_ANALYZER_MCP_API_KEY=replace-with-bearer-token
# PORT=8788
# WEBFLOW_ANALYZER_REGISTRY_PATH=/var/lib/webflow-site-analyzer/registry.json

# Optional: Webflow preview URL for integration test (default: public template)
# WEBFLOW_PREVIEW_URL=https://preview.webflow.com/preview/...

# Browserless (alternative for local dev)
# Get your token at https://browserless.io
BROWSERLESS_TOKEN=your-browserless-token

# Optional: Custom Browserless endpoint (for self-hosted)
# BROWSERLESS_ENDPOINT=wss://chrome.browserless.io

# MCP telemetry + Langfuse tracing (Optional)
# Set to "false" to disable local telemetry event emission
# MCP_TELEMETRY_ENABLED=true
#
# Optional path to append JSONL telemetry events
# MCP_TELEMETRY_PATH=./webflow-site-analyzer.telemetry.jsonl
#
# Langfuse tracing
# LANGFUSE_ENABLED=true
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PROJECT_NAME=webflow-site-analyzer-mcp
# LANGFUSE_PUBLIC_KEY=pk-lf-...
