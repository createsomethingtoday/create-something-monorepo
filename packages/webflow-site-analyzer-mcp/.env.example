# Browserless Configuration (Required)
# Get your token at https://browserless.io
BROWSERLESS_TOKEN=your-browserless-token

# Optional: Custom Browserless endpoint (for self-hosted)
# BROWSERLESS_ENDPOINT=wss://chrome.browserless.io

# Langfuse Observability (Optional)
# Get your keys at https://langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
