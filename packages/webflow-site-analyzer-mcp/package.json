{
  "name": "@create-something/webflow-site-analyzer-mcp",
  "version": "1.0.0",
  "description": "MCP server for Webflow site analysis - touchpoints, SEO, structure, and performance metrics",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "webflow-site-analyzer": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "policy:refresh": "npx tsx src/policy/snapshot-cli.ts",
    "temporal:worker": "npx tsx src/temporal/worker.ts",
    "temporal:trigger": "npx tsx src/temporal/trigger.ts",
    "temporal:server": "temporal server start-dev --http-port 7243",
    "teach": "npx tsx teach-mode.ts",
    "replay": "npx tsx replay-recipe.ts",
"review": "npx tsx review-mode.ts",
    "test:integration": "npx tsx integration-test.ts"
},
  "dependencies": {
    "@create-something/observability": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@temporalio/activity": "^1.14.1",
    "@temporalio/client": "^1.14.1",
    "@temporalio/worker": "^1.14.1",
    "@temporalio/workflow": "^1.14.1",
    "puppeteer-core": "^23.0.0",
    "steel-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "webflow",
    "site-analysis",
    "touchpoints",
    "seo",
    "browser-automation"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/webflow-site-analyzer-mcp"
  }
}
