{
  "name": "@create-something/webflow-site-analyzer-mcp",
  "version": "1.0.0",
  "description": "MCP server for Webflow site analysis - touchpoints, SEO, structure, and performance metrics",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "webflow-site-analyzer": "dist/index.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @create-something/observability build",
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "pnpm run test:providers && pnpm build && node scripts/test-review-utils.mjs",
    "test:providers": "tsx --test src/providers/*.test.ts src/worker.test.ts",
    "verify:browser-run": "tsx scripts/compare-browser-run.ts",
    "verify:browser-run:corpus": "tsx scripts/compare-browser-run.ts --validate",
    "test:classifier": "pnpm build && infisical run -- node scripts/test-url-classifier-live.mjs",
    "deploy": "wrangler deploy",
    "deploy:secrets": "echo 'Set secrets with: wrangler secret put CLOUDFLARE_BROWSER_RUN_API_TOKEN && wrangler secret put WEBFLOW_SITE_ANALYZER_MCP_API_KEY && wrangler secret put WEBFLOW_OPENAI_API_KEY; keep STEEL_API_KEY during rollback burn-in'",
    "dev:worker": "wrangler dev",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "policy:refresh": "npx tsx src/policy/snapshot-cli.ts",
    "temporal:worker": "npx tsx src/temporal/worker.ts",
    "temporal:trigger": "npx tsx src/temporal/trigger.ts",
    "temporal:server": "temporal server start-dev --http-port 7243",
    "teach": "npx tsx teach-mode.ts",
    "replay": "npx tsx replay-recipe.ts",
    "review": "npx tsx review-mode.ts",
    "test:integration": "npx tsx integration-test.ts",
    "test:designer-mcp": "node scripts/test-designer-mcp.mjs",
    "test:template-review": "node scripts/test-template-review-mcp.mjs"
  },
  "dependencies": {
    "@create-something/observability": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@temporalio/activity": "^1.14.1",
    "@temporalio/client": "^1.14.1",
    "@temporalio/worker": "^1.14.1",
    "@temporalio/workflow": "^1.14.1",
    "puppeteer-core": "^23.0.0",
    "steel-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "webflow",
    "site-analysis",
    "touchpoints",
    "seo",
    "browser-automation"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/webflow-site-analyzer-mcp"
  }
}
