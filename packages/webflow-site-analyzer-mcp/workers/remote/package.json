{
  "name": "webflow-site-analyzer-mcp-remote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test",
    "prepare:runtime": "node ../../scripts/prepare-remote-runtime.mjs",
    "preflight": "node ../../scripts/remote-deploy-preflight.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json",
    "dev": "node ../../../../scripts/run-wrangler.mjs dev",
    "deploy": "node ../../../../scripts/run-wrangler.mjs deploy",
    "tail": "node ../../../../scripts/run-wrangler.mjs tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.103.0"
  }
}
