{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webflow-site-analyzer-mcp-remote",
  "account_id": "9645bd52e640b8a4f40a3a55ff1dd75a",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "AnalyzerContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AnalyzerContainer",
        "name": "AnalyzerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnalyzerContainer"]
    }
  ],
  "vars": {
    "SANDBOX_SLEEP_AFTER": "never",
    "UPSTREAM_PORT": "8788"
  }
}
