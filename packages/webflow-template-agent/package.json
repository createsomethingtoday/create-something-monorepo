{
  "name": "@create-something/webflow-template-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker chat agent for Webflow template discovery — Claude tool loop over the template-search API with generative-UI display artifacts",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test",
    "dev": "node ../../scripts/run-wrangler.mjs dev --config wrangler.toml",
    "deploy": "node ../../scripts/run-wrangler.mjs deploy --config wrangler.toml",
    "lint": "pnpm run typecheck",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^24.10.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.103.0"
  }
}
