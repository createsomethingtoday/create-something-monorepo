{
  "name": "@create-something/webflow-template-review-mcp",
  "version": "1.0.0",
  "description": "Webflow Template Review MCP Server — Airtable-scoped review workflows for template Assets and Asset Versions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "webflow-template-review-mcp": "dist/index.js"
  },
  "scripts": {
    "audit:schema": "node --import tsx scripts/audit-airtable-schema.ts",
    "calibration:phase1": "node --import tsx scripts/calibrate-phase1.ts",
    "calibration:phase1:compare": "node --import tsx scripts/compare-phase1.ts",
    "calibration:visual-quality": "node --import tsx scripts/calibrate-visual-quality.ts",
    "calibration:visual-quality:prepare-ledger": "node --import tsx scripts/prepare-visual-quality-ledger-import.ts",
    "calibration:reviewer-bias": "node --import tsx scripts/analyze-reviewer-calibration.ts",
    "panel:eval:prepare": "node --import tsx scripts/prepare-subjective-panel-eval.ts",
    "panel:eval:run": "node --import tsx scripts/run-subjective-panel-eval.ts",
    "panel:eval:score": "node --import tsx scripts/score-subjective-panel-eval.ts",
    "multimodal:packet": "node --import tsx scripts/prepare-multimodal-review-packet.ts",
    "openai:multimodal:preflight": "node --import tsx scripts/check-openai-multimodal-readiness.ts",
    "rubric:reviewer:batch": "node --import tsx scripts/run-rubric-reviewer-batch.ts",
    "rubric:reviewer:dry-run": "node --import tsx scripts/run-rubric-reviewer-dry-run.ts",
    "rubric:reviewer:eval": "node --import tsx scripts/run-rubric-reviewer-shadow-eval.ts",
    "rubric:reviewer:score": "node --import tsx scripts/score-rubric-reviewer-batch.ts",
    "unit-economics:report": "node --import tsx scripts/report-template-review-unit-economics.ts",
    "unit-economics:typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM --types node scripts/report-template-review-unit-economics.ts scripts/run-published-site-e2b-sandbox.ts scripts/run-rubric-reviewer-dry-run.ts",
    "exceptional:lane:run": "node --import tsx scripts/run-exceptional-candidate-lane.ts",
    "exceptional:lane:score": "node --import tsx scripts/score-exceptional-candidate-lane.ts",
    "coordinator:exposure-policy": "node --import tsx scripts/derive-coordinator-exposure-policy.ts",
    "coordinator:exposure-policy:typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM --types node scripts/derive-coordinator-exposure-policy.ts",
    "coordinator:output-gate": "node --import tsx scripts/gate-coordinator-output.ts",
    "coordinator:output-gate:typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM --types node scripts/gate-coordinator-output.ts",
    "coordinator:contract-smoke": "node --import tsx scripts/run-coordinator-contract-smoke.ts",
    "coordinator:contract-smoke:typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM --types node scripts/run-coordinator-contract-smoke.ts",
    "quality:readiness:score": "node --import tsx scripts/score-quality-band-readiness.ts",
    "quality:readiness:typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM --types node scripts/score-quality-band-readiness.ts",
    "guidance:draft": "node --import tsx scripts/draft-template-improvement-guidance.ts",
    "guidance:draft:typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM --types node scripts/draft-template-improvement-guidance.ts",
    "validator:bridge:check": "node --import tsx scripts/check-validator-bridge-presence.ts",
    "validator:results:normalize": "node --import tsx scripts/normalize-validator-app-results.ts",
    "appeal:equity:batch": "node --import tsx scripts/run-appeal-equity-batch.ts",
    "appeal:equity:casebook": "node --import tsx scripts/run-appeal-equity-casebook.ts",
    "appeal:equity:capture-queue": "node --import tsx scripts/run-appeal-equity-capture-queue.ts",
    "appeal:equity:compare": "node --import tsx scripts/run-appeal-equity-comparison.ts",
    "appeal:equity:eval": "node --import tsx scripts/run-appeal-equity-shadow-eval.ts",
    "appeal:equity:external-compare": "node --import tsx scripts/run-appeal-equity-external-comparison.ts",
    "appeal:equity:intake": "node --import tsx scripts/run-appeal-equity-intake.ts",
    "appeal:equity:score-casebook": "node --import tsx scripts/score-appeal-equity-casebook.ts",
    "appeal:equity:verify-status": "node --import tsx scripts/run-appeal-equity-status-verification.ts",
    "published-site:sandbox:e2b-preflight": "node --import tsx scripts/run-published-site-e2b-sandbox.ts --preflight-only",
    "published-site:sandbox:e2b-calibration": "node --import tsx scripts/run-published-site-e2b-calibration.ts",
    "published-site:sandbox:e2b-run": "node --import tsx scripts/run-published-site-e2b-sandbox.ts",
    "published-site:sandbox:normalize": "node --import tsx scripts/normalize-published-site-sandbox-output.ts",
    "published-site:sandbox:prepare": "node --import tsx scripts/prepare-published-site-sandbox-run.ts",
    "e2b:template:build": "node --import tsx e2b/build-template.ts",
    "e2b:template:typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM --types node e2b/template.ts e2b/build-template.ts",
    "visual-quality:extract-proxies": "node --import tsx scripts/extract-visual-quality-proxies.ts",
    "visual-quality:proxy-canary": "node --import tsx scripts/run-visual-quality-proxy-canary.ts",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "e2b": "2.24.0",
    "jose": "6.1.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "webflow",
    "airtable",
    "template-review",
    "model-context-protocol"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/webflow-template-review-mcp"
  }
}
