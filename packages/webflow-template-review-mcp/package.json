{
  "name": "@create-something/webflow-template-review-mcp",
  "version": "1.0.0",
  "description": "Webflow Template Review MCP Server — Airtable-scoped review workflows for template Assets and Asset Versions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "webflow-template-review-mcp": "dist/index.js"
  },
  "scripts": {
    "audit:schema": "node --import tsx scripts/audit-airtable-schema.ts",
