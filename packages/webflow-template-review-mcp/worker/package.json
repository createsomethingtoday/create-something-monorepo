{
  "name": "webflow-template-review-mcp-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @create-something/mcp-core build",
    "dev": "pnpm run build:deps && node ../../../scripts/run-wrangler.mjs dev",
    "deploy": "pnpm run build:deps && node ../../../scripts/run-wrangler.mjs deploy",
    "deploy:dev:dry-run": "pnpm run build:deps && node ../../../scripts/run-wrangler.mjs deploy --env dev --dry-run",
    "deploy:dev": "pnpm run build:deps && node ../../../scripts/run-wrangler.mjs deploy --env dev",
    "tail": "node ../../../scripts/run-wrangler.mjs tail",
    "tail:dev": "node ../../../scripts/run-wrangler.mjs tail --env dev"
  },
  "dependencies": {
    "@create-something/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "agents": "^0.3.10",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "typescript": "^5.3.0",
    "wrangler": "^4.103.0"
  }
}
