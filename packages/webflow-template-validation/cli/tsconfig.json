{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["es2022", "dom"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}
