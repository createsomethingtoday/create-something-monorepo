{
  "schemaVersion": "workflow_definition.v0.1",
  "workflowId": "webflow.marketplace.template-lifecycle",
  "version": "0.1.0",
  "title": "Webflow Marketplace template lifecycle",
  "businessObjective": "Reduce objective submission and review work while preserving reviewer ownership of consequential decisions.",
  "owners": {
    "workflow": "marketplace-review-lead",
    "policy": "senior-systems-architect",
    "technical": "senior-systems-architect"
  },
  "systems": [
    {
      "id": "marketplace-submission-cloud",
      "title": "Marketplace Template Submission Cloud",
      "tier": "automation",
      "owningSurface": "apps/marketplace-template-submission-cloud",
      "sourceOfTruth": false
    },
    {
      "id": "airtable-marketplace",
      "title": "Airtable Marketplace Assets",
      "tier": "database",
      "owningSurface": "Airtable Assets, Asset Versions, and Asset Releases",
      "sourceOfTruth": true
    },
    {
      "id": "template-validation",
      "title": "Webflow Template Validation",
      "tier": "automation",
      "owningSurface": "packages/webflow-template-validation",
      "sourceOfTruth": false
    },
    {
      "id": "template-review-mcp",
      "title": "Webflow Template Review MCP",
      "tier": "automation",
      "owningSurface": "packages/webflow-template-review-mcp",
      "sourceOfTruth": false
    },
    {
      "id": "policy-os",
      "title": "Policy OS",
      "tier": "judgment",
      "owningSurface": "packages/policy-os-engine",
      "sourceOfTruth": true
    },
    {
      "id": "substrate",
      "title": "Substrate operational memory",
      "tier": "database",
      "owningSurface": "packages/substrate-mcp",
      "sourceOfTruth": false
    },
    {
      "id": "atlas-studio",
      "title": "Atlas Studio",
      "tier": "automation",
      "owningSurface": "apps/atlas-studio-desktop",
      "sourceOfTruth": false
    }
  ],
  "objects": [
    {
      "id": "template_submission",
      "title": "Template submission",
      "sourceSystemId": "airtable-marketplace",
      "requiredFields": ["asset_id", "version_id", "published_url", "review_status"]
    },
    {
      "id": "review_evidence",
      "title": "Review evidence",
      "sourceSystemId": "substrate",
      "requiredFields": ["case_id", "evidence_type", "source", "observed_at"]
    },
    {
      "id": "decision_receipt",
      "title": "Decision receipt",
      "sourceSystemId": "substrate",
      "requiredFields": ["workflow_id", "action_id", "correlation_id", "outcome"]
    }
  ],
  "events": [
    {
      "id": "submission_received",
      "title": "Submission received",
      "objectId": "template_submission",
      "requiredEvidence": ["asset_id", "version_id", "published_url"]
    },
    {
      "id": "validation_completed",
      "title": "Validation completed",
      "objectId": "review_evidence",
      "requiredEvidence": ["validation_result", "published_url", "observed_at"]
    },
    {
      "id": "review_decision_requested",
      "title": "Review decision requested",
      "objectId": "template_submission",
      "requiredEvidence": ["version_id", "reviewer_id", "review_summary"]
    },
    {
      "id": "publish_requested",
      "title": "Publish requested",
      "objectId": "template_submission",
      "requiredEvidence": ["version_id", "approval_receipt", "release_metadata"]
    },
    {
      "id": "monitoring_signal",
      "title": "Post-launch monitoring signal",
      "objectId": "review_evidence",
      "requiredEvidence": ["asset_id", "signal_type", "observed_at"]
    }
  ],
  "actors": [
    { "id": "marketplace-reviewer", "title": "Marketplace reviewer" },
    { "id": "marketplace-operator", "title": "Marketplace operator" },
    { "id": "workflow-runtime", "title": "Workflow runtime" }
  ],
  "states": [
    { "id": "submitted", "title": "Submitted" },
    { "id": "ready_for_review", "title": "Ready for review" },
    { "id": "changes_requested", "title": "Changes requested", "terminal": true },
    { "id": "approved", "title": "Approved" },
    { "id": "published", "title": "Published" },
    { "id": "monitored", "title": "Monitored", "terminal": true }
  ],
  "actions": [
    {
      "id": "validate_submission",
      "title": "Validate submission",
      "kind": "decision",
      "authority": "workflow-runtime",
      "autonomy": "auto_allow",
      "systemsTouched": ["template-validation", "airtable-marketplace"],
      "requiredEvidence": ["asset_id", "version_id", "published_url", "validation_result"],
      "approval": { "required": false },
      "receipt": {
        "requiredFields": ["workflow_id", "action_id", "correlation_id", "outcome", "evidence_refs"]
      },
      "recovery": {
        "mode": "escalate",
        "owner": "marketplace-reviewer",
        "path": "Keep the submission in submitted state and request manual validation."
      },
      "tool": {
        "name": "template_validation_run",
        "targetSystemId": "template-validation",
        "parameters": [
          { "name": "asset_id", "type": "string", "description": "Marketplace asset identifier." },
          {
            "name": "published_url",
            "type": "string",
            "description": "Published template URL to validate."
          },
          {
            "name": "validation_result",
            "type": "string",
            "description": "Recorded validation result."
          },
          {
            "name": "version_id",
            "type": "string",
            "description": "Marketplace asset version identifier."
          }
        ]
      },
      "agentId": "marketplace-workflow-operator"
    },
    {
      "id": "request_changes",
      "title": "Request changes",
      "kind": "decision",
      "authority": "marketplace-reviewer",
      "autonomy": "approval_required",
      "systemsTouched": ["template-review-mcp", "airtable-marketplace", "policy-os"],
      "requiredEvidence": ["version_id", "reviewer_id", "review_feedback", "review_summary"],
      "approval": { "required": true, "owner": "marketplace-reviewer" },
      "receipt": {
        "requiredFields": [
          "workflow_id",
          "action_id",
          "correlation_id",
          "outcome",
          "reviewer_id",
          "evidence_refs"
        ]
      },
      "recovery": {
        "mode": "manual_fallback",
        "owner": "marketplace-reviewer",
        "path": "Leave official state unchanged and record feedback manually in Airtable."
      },
      "tool": {
        "name": "template_review_request_changes",
        "targetSystemId": "template-review-mcp",
        "parameters": [
          {
            "name": "review_feedback",
            "type": "string",
            "description": "Reviewer-authored change request."
          },
          {
            "name": "version_id",
            "type": "string",
            "description": "Marketplace asset version identifier."
          }
        ]
      }
    },
    {
      "id": "approve_template",
      "title": "Approve template",
      "kind": "decision",
      "authority": "marketplace-reviewer",
      "autonomy": "approval_required",
      "systemsTouched": ["template-review-mcp", "airtable-marketplace", "policy-os"],
      "requiredEvidence": [
        "version_id",
        "review_status",
        "reviewer_id",
        "review_summary",
        "validation_result"
      ],
      "approval": { "required": true, "owner": "marketplace-reviewer" },
      "receipt": {
        "requiredFields": [
          "workflow_id",
          "action_id",
          "correlation_id",
          "outcome",
          "reviewer_id",
          "evidence_refs"
        ]
      },
      "recovery": {
        "mode": "manual_fallback",
        "owner": "marketplace-reviewer",
        "path": "Keep the version in review and resolve the approval manually in Airtable."
      },
      "tool": {
        "name": "template_review_set_review_status",
        "targetSystemId": "template-review-mcp",
        "parameters": [
          {
            "name": "review_status",
            "type": "string",
            "description": "Reviewer-controlled marketplace review status."
          },
          {
            "name": "version_id",
            "type": "string",
            "description": "Marketplace asset version identifier."
          }
        ]
      }
    },
    {
      "id": "publish_template",
      "title": "Publish template",
      "kind": "publish",
      "authority": "marketplace-operator",
      "autonomy": "manual_only",
      "systemsTouched": ["airtable-marketplace", "policy-os"],
      "requiredEvidence": ["version_id", "approval_receipt", "release_metadata", "operator_id"],
      "approval": { "required": true, "owner": "marketplace-operator" },
      "receipt": {
        "requiredFields": [
          "workflow_id",
          "action_id",
          "correlation_id",
          "outcome",
          "operator_id",
          "evidence_refs"
        ]
      },
      "recovery": {
        "mode": "rollback",
        "owner": "marketplace-operator",
        "path": "Stop publication, preserve the approved version, and follow the marketplace release rollback runbook."
      }
    },
    {
      "id": "monitor_post_launch",
      "title": "Monitor post-launch signals",
      "kind": "read",
      "authority": "workflow-runtime",
      "autonomy": "auto_allow",
      "systemsTouched": ["airtable-marketplace", "substrate"],
      "requiredEvidence": ["asset_id", "signal_type", "observed_at"],
      "approval": { "required": false },
      "receipt": {
        "requiredFields": ["workflow_id", "action_id", "correlation_id", "outcome", "evidence_refs"]
      },
      "recovery": {
        "mode": "escalate",
        "owner": "marketplace-operator",
        "path": "Retain the last known signal state and request a manual health check."
      },
      "agentId": "marketplace-workflow-operator"
    },
    {
      "id": "send_creator_decision",
      "title": "Send creator-facing decision autonomously",
      "kind": "write",
      "authority": "marketplace-reviewer",
      "autonomy": "blocked",
      "systemsTouched": ["template-review-mcp", "policy-os"],
      "requiredEvidence": ["reviewer_id", "human_send_confirmation", "decision_receipt"],
      "approval": { "required": false },
      "receipt": {
        "requiredFields": ["workflow_id", "action_id", "correlation_id", "outcome", "evidence_refs"]
      },
      "recovery": {
        "mode": "escalate",
        "owner": "marketplace-reviewer",
        "path": "Return a draft only and require the reviewer to send through the approved communication path."
      }
    }
  ],
  "transitions": [
    {
      "id": "submitted-to-ready",
      "from": "submitted",
      "to": "ready_for_review",
      "actionId": "validate_submission"
    },
    {
      "id": "ready-to-changes",
      "from": "ready_for_review",
      "to": "changes_requested",
      "actionId": "request_changes"
    },
    {
      "id": "ready-to-approved",
      "from": "ready_for_review",
      "to": "approved",
      "actionId": "approve_template"
    },
    {
      "id": "approved-to-published",
      "from": "approved",
      "to": "published",
      "actionId": "publish_template"
    },
    {
      "id": "published-to-monitored",
      "from": "published",
      "to": "monitored",
      "actionId": "monitor_post_launch"
    }
  ],
  "agents": [
    {
      "id": "marketplace-workflow-operator",
      "title": "Marketplace workflow operator",
      "purpose": "Gather evidence, run deterministic validation, and monitor outcomes without taking human-owned decisions.",
      "allowedActionIds": ["validate_submission", "monitor_post_launch"],
      "escalationOwner": "marketplace-review-lead"
    }
  ],
  "evaluations": [
    {
      "id": "validation-complete",
      "title": "Complete validation evidence can advance to review",
      "actionId": "validate_submission",
      "expectedOutcome": "pass",
      "requiredEvidence": ["asset_id", "version_id", "published_url", "validation_result"]
    },
    {
      "id": "approval-stays-human",
      "title": "Template approval waits for the assigned reviewer",
      "actionId": "approve_template",
      "expectedOutcome": "approval_required",
      "requiredEvidence": [
        "version_id",
        "review_status",
        "reviewer_id",
        "review_summary",
        "validation_result"
      ]
    },
    {
      "id": "creator-message-blocked",
      "title": "Autonomous creator decision messaging is blocked",
      "actionId": "send_creator_decision",
      "expectedOutcome": "blocked",
      "requiredEvidence": ["reviewer_id", "human_send_confirmation", "decision_receipt"]
    }
  ]
}
