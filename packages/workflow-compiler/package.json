{
  "name": "@create-something/workflow-compiler",
  "version": "0.3.0",
  "description": "Compile versioned operating workflows into deterministic, governed artifacts and provider-neutral execution plans.",
  "type": "module",
  "createSomething": {
    "agentLegibilityContract": true,
    "tier": "automation",
    "surface": "library",
    "entrypoints": [
      "src/index.ts"
    ],
    "boot": "pnpm build",
    "smoke": "pnpm check && pnpm test"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "workflow-compiler": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures/release-promotion",
    "skills",
    "API.md",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "LICENSE",
    "MIGRATING.md",
    "README.md",
    "RELEASING.md",
    "THREAT_MODEL.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "compile": "node dist/cli.js compile",
    "serve": "node dist/cli.js serve",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:acceptance": "npm run build && node scripts/acceptance.mjs",
    "release:check": "npm run build && node scripts/release-contract.mjs",
    "release:consumer": "npm run release:check && node scripts/clean-consumer.mjs",
    "prepack": "npm run release:check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "keywords": [
    "workflow",
    "compiler",
    "mcp",
    "openai",
    "governance",
    "automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/workflow-compiler"
  },
  "homepage": "https://github.com/createsomethingtoday/create-something-monorepo/tree/main/packages/workflow-compiler#readme",
  "bugs": {
    "url": "https://github.com/createsomethingtoday/create-something-monorepo/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
