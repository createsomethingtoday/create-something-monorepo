NOTION_API_KEY=secret_xxx
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_PROPERTY_MAPPING_JSON={"title":"Title","url":"YouTube URL","videoId":"Video ID","channelName":"Channel","publishedAt":"Published At","thumbnailUrl":"Thumbnail URL","language":"Language","extractionMethod":"Extraction Method","transcriptStatus":"Transcript Status","syncedAt":"Synced At"}

SUPADATA_API_KEY=sd_xxx
SUPADATA_TRANSCRIPT_MODE=native

STEEL_API_KEY=steel_xxx
# Strongly recommended for YouTube: use a persistent Steel profile that has already cleared trust checks.
STEEL_PROFILE_ID=profile_xxx

YOUTUBE_TRANSCRIPT_LANGUAGE=en
YOUTUBE_DIRECT_PROVIDER_MODE=auto
MCP_DISPLAY_NAME=YouTube Transcript + Notion MCP
MCP_DESCRIPTION=Extract YouTube transcripts with a direct path, browser fallback, and sync them into Notion.
# Strongly recommended for any public or shared remote deployment when Supadata, Steel, or Notion are configured.
MCP_BEARER_TOKEN=
