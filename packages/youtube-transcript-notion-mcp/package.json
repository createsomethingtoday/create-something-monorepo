{
  "name": "@create-something/youtube-transcript-notion-mcp",
  "version": "1.0.0",
  "description": "Remote MCP for Notion-first YouTube transcript enrichment with optional playlist-driven ingest",
  "type": "module",
  "main": "dist/index.js",
  "createSomething": {
    "agentLegibilityContract": true
  },
  "scripts": {
    "build": "tsc",
    "check": "pnpm run typecheck",
    "dev": "tsc --watch",
    "lint": "pnpm run typecheck",
    "prestdio": "pnpm run build",
    "stdio": "node dist/stdio.js",
    "prestdio:auto": "pnpm run build",
    "stdio:auto": "YOUTUBE_DIRECT_PROVIDER_MODE=auto node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@notionhq/client": "^5.9.0",
    "dotenv": "^16.4.5",
    "puppeteer-core": "^24.34.0",
    "steel-sdk": "^0.16.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "mcp",
    "youtube",
    "transcript",
    "notion",
    "steel",
    "cloudflare"
  ],
  "author": "CREATE SOMETHING <hello@createsomething.agency>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/createsomethingtoday/create-something-monorepo.git",
    "directory": "packages/youtube-transcript-notion-mcp"
  }
}
