{
  "name": "youtube-transcript-notion-mcp-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run typecheck",
    "predeploy": "pnpm --filter @create-something/mcp-core build",
    "dev": "node ../../../scripts/run-wrangler.mjs dev",
    "deploy": "node ../../../scripts/run-wrangler.mjs deploy",
    "predev": "pnpm --filter @create-something/mcp-core build",
    "secrets": "echo 'Run: wrangler secret put <NAME>' && echo 'Required: NOTION_API_KEY, SUPADATA_API_KEY. Optional: NOTION_DATABASE_ID, STEEL_API_KEY, STEEL_PROFILE_ID, MCP_BEARER_TOKEN, SUPADATA_TRANSCRIPT_MODE'",
    "tail": "node ../../../scripts/run-wrangler.mjs tail",
    "pretypecheck": "pnpm --filter @create-something/mcp-core build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@create-something/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@notionhq/client": "^5.9.0",
    "agents": "^0.3.10",
    "puppeteer-core": "^24.34.0",
    "steel-sdk": "^0.16.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260205.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.62.0"
  }
}
