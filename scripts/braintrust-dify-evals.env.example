# Braintrust Dify agent eval scaffolds

# Optional Braintrust target project for eval results
BRAINTRUST_PROJECT_NAME="CREATE SOMETHING Dify Agents"

# List runnable Dify experiments:
#   pnpm braintrust:eval:dify:list
#
# Complete eval process:
#   docs/guides/DIFY_BRAINTRUST_EVAL_COMPLETION.md

# Dify app Service API key for "YouTube Transcript Notion Agent".
# Prefer Infisical lookup instead of exporting this locally:
#   prod /dify/youtube-transcript-notion-agent DIFY_YOUTUBE_TRANSCRIPT_NOTION_AGENT_API_KEY
DIFY_YOUTUBE_TRANSCRIPT_NOTION_AGENT_API_KEY="<required-or-infisical>"

# Optional generic overrides. Set these to the target agent's inventory
# service_api.api_key_secret reference when running one-off probes.
DIFY_AGENT_BASE_URL="https://api.dify.ai/v1"
DIFY_AGENT_INFISICAL_ENV="prod"
DIFY_AGENT_INFISICAL_PATH="/dify/youtube-transcript-notion-agent"
DIFY_AGENT_API_KEY_SECRET_NAME="DIFY_YOUTUBE_TRANSCRIPT_NOTION_AGENT_API_KEY"
DIFY_AGENT_EVAL_USER="braintrust-dify-youtube-transcript-agent"
DIFY_AGENT_EVAL_TIMEOUT_MS="45000"
DIFY_AGENT_SMOKE_VIDEO_URL="https://www.youtube.com/watch?v=sEQ1ecQq0HI"

# Examples:
#   DIFY_AGENT_INFISICAL_PATH="/dify/abundance-hub"
#   DIFY_AGENT_API_KEY_SECRET_NAME="DIFY_ABUNDANCE_HUB_API_KEY"
#   DIFY_AGENT_INFISICAL_PATH="/dify/eric-hub"
#   DIFY_AGENT_API_KEY_SECRET_NAME="DIFY_ERIC_HUB_API_KEY"
