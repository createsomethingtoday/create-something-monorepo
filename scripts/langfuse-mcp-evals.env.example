# Langfuse MCP eval scaffolds

# Optional Langfuse target project for eval results
LANGFUSE_PROJECT_NAME="CREATE SOMETHING"

# -----------------------------------------------------------------------------
# fleet_telemetry_contract
# -----------------------------------------------------------------------------

# Default: Playbook inbox-triage route
MCP_FLEET_CONTRACT_URL="https://playbook.mcp.createsomething.ltd/clients/halfdozen/agents/inbox-triage/run"
HALFDOZEN_AGENT_ROUTE_TOKEN="<required-for-playbook-route>"
MCP_FLEET_CONTRACT_QUERY="Langfuse eval contract check: return a structured successful response."
# Optional JSON overrides merged into the request body.
# MCP_FLEET_CONTRACT_BODY_JSON='{"model":"gpt-4.1-mini"}'
# Optional Infisical CLI fallback when the token is not exported into env:
# MCP_FLEET_CONTRACT_INFISICAL_ENV="prod"
# MCP_FLEET_CONTRACT_INFISICAL_PATH="/"
# MCP_FLEET_CONTRACT_INFISICAL_PROJECT_ID="<optional-project-id>"

# -----------------------------------------------------------------------------
# fleet_error_path_tracing
# -----------------------------------------------------------------------------

# Intentionally called *without* auth by the eval to force an error path.
MCP_FLEET_ERROR_URL="https://playbook.mcp.createsomething.ltd/clients/halfdozen/agents/inbox-triage/run"
MCP_FLEET_ERROR_QUERY="Langfuse eval error-path check: this request intentionally omits auth."
# Optional JSON overrides merged into the request body.
# MCP_FLEET_ERROR_BODY_JSON='{"max_turns":1}'

# -----------------------------------------------------------------------------
# account_isolation
# -----------------------------------------------------------------------------

# Default mode checks live Hub account routing via visible `__connection_status`
# tools and existing lane tokens (`CS_HUB_*_API_TOKEN` / `_AUTH_TOKEN`).
MCP_ACCOUNT_ISOLATION_MODE="hub_connection_status"
# Optional: restrict to a subset of lanes, for example "mj,danny".
# MCP_ACCOUNT_ISOLATION_LANES="mj,danny"
MCP_ACCOUNT_SPOOF_HEADER_NAME="X-MCP-Account-Id"
MCP_ACCOUNT_SPOOF_ACCOUNT_ID="acct_spoof_attempt"

# Legacy echo-fixture mode remains available when you need a custom route:
# MCP_ACCOUNT_ISOLATION_MODE="legacy_echo"
# MCP_ACCOUNT_ISOLATION_URL=""
# MCP_ACCOUNT_ISOLATION_TOKEN=""
# MCP_ACCOUNT_HEADER_NAME="x-mcp-account-id"
# MCP_ACCOUNT_FIELD_PATH="accountId"
# MCP_ACCOUNT_A="tenant-a"
# MCP_ACCOUNT_B="tenant-b"
# Optional JSON body. If omitted, eval uses GET.
# MCP_ACCOUNT_ISOLATION_BODY_JSON='{"ping":true}'

# -----------------------------------------------------------------------------
# exa_workload_latency
# -----------------------------------------------------------------------------

# Defaults to the MJ Hub lane and falls back to CS_HUB_MJ_API_TOKEN / CS_HUB_MJ_AUTH_TOKEN.
MCP_EXA_HUB_URL="https://mj.mcp.createsomething.agency/mcp"
# MCP_EXA_HUB_TOKEN="<optional-override>"
MCP_EXA_SEARCH_QUERY="site:openai.com MCP server"
MCP_EXA_ANSWER_QUERY="What is MCP in the OpenAI ecosystem?"
MCP_EXA_ANSWER_MODEL="exa"
MCP_EXA_CONTENT_URL="https://openai.com/index/new-tools-and-features-in-the-responses-api/"
MCP_EXA_RESEARCH_INSTRUCTIONS="Summarize the latest MCP support discussed by OpenAI in one short paragraph."

# -----------------------------------------------------------------------------
# hub_coverage_matrix
# -----------------------------------------------------------------------------

# This eval uses the lane tokens already present in shared operator env, for example:
# CS_HUB_LAINY_API_TOKEN, CS_HUB_DANNY_API_TOKEN, ..., CS_HUB_MJ_API_TOKEN.
# Optional strict-session lane support:
# CS_HUB_DANNY_SESSION_TOKEN="<optional-session-token>"

# -----------------------------------------------------------------------------
# hub_intent_routing_quality
# -----------------------------------------------------------------------------

# No live env required. This eval runs against the repo-local intent registry
# and a representative visible proxy catalog fixture.
