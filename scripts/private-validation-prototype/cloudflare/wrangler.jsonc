{
  "name": "private-validation-preview",
  "account_id": "9645bd52e640b8a4f40a3a55ff1dd75a",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "containers": [{ "class_name": "ValidationSandbox", "image": "./Dockerfile", "instance_type": "lite", "max_instances": 1 }],
  "durable_objects": { "bindings": [
    { "name": "Sandbox", "class_name": "ValidationSandbox" },
    { "name": "Coordinator", "class_name": "Coordinator" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ValidationSandbox", "Coordinator"] }]
}
